	#account-bar {
		position: fixed;
		top: 2rem;
		/* align with the right edge of the 760px content column (the feed's right border) */
		right: max(1rem, calc(50vw - 380px));
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 34px;
	}

	#account-name {
		font-size: 0.8rem;
		font-weight: 700;
		color: #ffce1c;
	}

	#account-chip {
		flex-shrink: 0;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid #333;
		background: #111;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: border-color 0.15s ease;
	}

	#account-chip:hover {
