---
const path = Astro.url.pathname;
const isHome = path === '/';
const isSearch = path.startsWith('/search');
const isNotif = path.startsWith('/notifications');
const isMessages = path.startsWith('/messages');
const isAI = path.startsWith('/ospreyai');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" href="data:," />

		<title>Osprey K5 Systems</title>
	</head>
	<body class={isAI ? 'page-ai' : undefined}>
		<div id="mobile-block">
			<div class="mobile-block-inner">
				<h1>Osprey K5 Systems</h1>
				<p>This terminal is not yet available on mobile.</p>
				<p class="mb-sub">Please access from a desktop browser.</p>
			</div>
		</div>
		<svg width="0" height="0" style="position: absolute" aria-hidden="true">
			<defs>
				<linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#8a9098"></stop>
					<stop offset="35%" stop-color="#f3f6f9"></stop>
					<stop offset="50%" stop-color="#ffffff"></stop>
					<stop offset="66%" stop-color="#b9bfc5"></stop>
					<stop offset="100%" stop-color="#5f656b"></stop>
					<animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
				</linearGradient>
			</defs>
		</svg>
		<nav class="side-nav" aria-label="Primary">
			<a class={`side-nav-item${isHome ? ' active' : ''}`} href="/">
				<svg class="side-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3.172a1.5 1.5 0 0 0-.97.358L4.28 9.22A2 2 0 0 0 3.5 10.79V19a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4.5a1.5 1.5 0 0 1 1.5-1.5h2a1.5 1.5 0 0 1 1.5 1.5V20a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-8.21a2 2 0 0 0-.78-1.59l-6.75-5.69A1.5 1.5 0 0 0 12 3.172z"/></svg>
				<span>Home</span>
			</a>
			<a class={`side-nav-item${isSearch ? ' active' : ''}`} href="/search">
				<svg class="side-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10.5 3a7.5 7.5 0 1 0 4.55 13.46l4.74 4.74 1.42-1.42-4.74-4.74A7.5 7.5 0 0 0 10.5 3zm0 2a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11z"/></svg>
				<span>Search</span>
			</a>
			<a class={`side-nav-item${isNotif ? ' active' : ''}`} href="/notifications">
				<span class="side-nav-iconwrap">
					<svg class="side-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a6 6 0 0 0-6 6c0 3.6-1 5.3-1.9 6.2L3 15.2V17h18v-1.8l-1.1-1c-.9-.9-1.9-2.6-1.9-6.2a6 6 0 0 0-6-6zm0 20a2.8 2.8 0 0 0 2.8-2.8H9.2A2.8 2.8 0 0 0 12 22z"/></svg>
					<span class="notif-badge" id="notif-badge" hidden></span>
				</span>
				<span>Notifications</span>
			</a>
			<a class={`side-nav-item${isMessages ? ' active' : ''}`} href="/messages">
				<span class="side-nav-iconwrap">
					<svg class="side-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm.4 2L12 11.2 19.6 6H4.4zM20 7.5l-7.43 5.06a1 1 0 0 1-1.14 0L4 7.5V18h16V7.5z"/></svg>
					<span class="notif-badge" id="msg-badge" hidden></span>
				</span>
				<span>Messages</span>
			</a>
			<a class={`side-nav-item${isAI ? ' active' : ''}`} href="/ospreyai">
				<svg class="side-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 3a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h1v3.2a1 1 0 0 0 1.6.8L13 17h6a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3z"/></svg>
				<span>OspreyAI</span>
			</a>
			<a class="side-nav-item" href="/profile?edit=1">
				<svg class="side-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54A.48.48 0 0 0 14.5 2h-3.84a.48.48 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87a.49.49 0 0 0 .12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.04.24.24.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.12-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"/></svg>
				<span>Settings</span>
			</a>
			<a class="side-nav-item side-nav-account" href="/profile" id="nav-account" hidden>
				<span class="nav-account-avatar" id="nav-account-avatar"></span>
				<span class="nav-account-name" id="nav-account-name"></span>
			</a>
		</nav>

		<div class="build-info" id="build-info">
			<p class="current-time">Current time: <span id="local-time"></span></p>
			<p class="build-number status-row">
				<span>Site Status:</span>
				<span class="status-dot" aria-hidden="true"></span>
				<span>Active</span>
			</p>
			<p class="build-number">Osprey Kastle Five Build 0.8.1</p>
			<p class="current-time">
				<a class="built-by-link" href="https://x.com/k5binya" target="_blank" rel="noopener">Built by @k5binya</a>
			</p>
		</div>

		<div class="site-title" id="site-title">
			<svg viewBox="0 0 190 80" width="190" role="img" aria-label="Osprey, engineered by Kastle Five systems.">
				<title>Osprey, engineered by Kastle Five systems.</title>
				<text x="0" y="47" textLength="190" lengthAdjust="spacingAndGlyphs" font-family="Helvetica, Arial, sans-serif" font-weight="700" font-size="54" fill="#ffce1c">Osprey,</text>
				<text x="0" y="72" textLength="190" lengthAdjust="spacingAndGlyphs" font-family="Helvetica, Arial, sans-serif" font-weight="400" font-size="12" fill="#f5f7fa">engineered by Kastle Five systems.</text>
			</svg>
		</div>

		<slot />

		<script>
			const SEAL =
				'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';
			function navEsc(s) {
				return (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
			}
			function navBadges(u) {
				let h = '';
				if (u.verified)
					h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>Verified User</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
				if (u.engineer)
					h += `<svg class="badge-svg" viewBox="0 0 22 22"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text></svg>`;
				return h;
			}

			const defaultAvatar =
				'<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.4 0-8 2.5-8 5.5V21h16v-1.5c0-3-3.6-5.5-8-5.5z"/></svg>';

			function applyMe(u) {
				const navAcc = document.getElementById('nav-account');
				const navAv = document.getElementById('nav-account-avatar');
				const navNm = document.getElementById('nav-account-name');
				if (!navAcc || !navAv || !navNm) return;
				if (u) {
					navAv.innerHTML = u.avatar ? `<img src="${navEsc(u.avatar)}" alt="" />` : defaultAvatar;
					navNm.innerHTML = '@' + navEsc(u.username) + navBadges(u);
				} else {
					navAv.innerHTML = defaultAvatar;
					navNm.textContent = 'Sign in';
				}
				navAcc.hidden = false;
			}

			// Render the chip instantly from the cached user (no flash on navigation),
			// then refresh from the network.
			try {
				const cached = sessionStorage.getItem('k5-me');
				if (cached) applyMe(JSON.parse(cached));
			} catch {
				/* ignore */
			}

			fetch('/api/me')
				.then((r) => r.json())
				.then((u) => {
					applyMe(u);
					try {
						if (u) sessionStorage.setItem('k5-me', JSON.stringify(u));
						else sessionStorage.removeItem('k5-me');
					} catch {
						/* ignore */
					}
				})
				.catch(() => {});

			// notifications unread dot — polled for near-real-time updates
			function setNotifBadge(n) {
				const b = document.getElementById('notif-badge');
				if (!b) return;
				b.hidden = !(n > 0);
			}
			function setMsgBadge(n) {
				const b = document.getElementById('msg-badge');
				if (!b) return;
				b.hidden = !(n > 0);
			}
			function pollBadges() {
				fetch('/api/notifications/count')
					.then((r) => r.json())
					.then((d) => setNotifBadge(d.count || 0))
					.catch(() => {});
				fetch('/api/messages/count')
					.then((r) => r.json())
					.then((d) => setMsgBadge(d.count || 0))
					.catch(() => {});
			}
			pollBadges();
			setInterval(pollBadges, 12000);
			document.addEventListener('visibilitychange', () => {
				if (!document.hidden) pollBadges();
			});

			// status-block clock
			const timeEl = document.getElementById('local-time');
			function tick() {
				if (!timeEl) return;
				timeEl.textContent = new Date().toLocaleTimeString(undefined, {
					hour: '2-digit',
					minute: '2-digit',
					second: '2-digit',
				});
			}
			tick();
			setInterval(tick, 1000);

			// Don't re-navigate to the page you're already on (avoids stacking
			// duplicate history entries). Home re-click refreshes the feed instead.
			const norm = (p) => p.replace(/\/+$/, '') || '/';
			document.querySelector('.side-nav')?.addEventListener('click', (e) => {
				const a = (e.target as HTMLElement).closest('a.side-nav-item') as HTMLAnchorElement | null;
				if (!a) return;
				const href = a.getAttribute('href') || '';
				if (href === '#') {
					e.preventDefault();
					return;
				}
				const url = new URL(href, location.origin);
				const samePath = norm(url.pathname) === norm(location.pathname);
				if (norm(url.pathname) === '/' && norm(location.pathname) === '/') {
					e.preventDefault();
					window.dispatchEvent(new CustomEvent('k5-refresh-feed'));
					return;
				}
				if (samePath && url.search === location.search) {
					e.preventDefault();
				}
			});

			// Settings (profile edit) active state — query params aren't known at build time
			if (
				location.pathname.replace(/\/$/, '') === '/profile' &&
				new URLSearchParams(location.search).has('edit')
			) {
				document.querySelector('.side-nav-item[href="/profile?edit=1"]')?.classList.add('active');
				document.querySelector('.side-nav-item[href="/profile"]')?.classList.remove('active');
			}
		</script>
	</body>
</html>

<style>
	html {
		/* Always reserve the scrollbar gutter so pages that scroll (profile)
		   and pages that don't (home feed scrolls internally) center their
		   columns in the same width — keeps the column aligned with the rails. */
		scrollbar-gutter: stable;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: Helvetica, Arial, sans-serif;
		line-height: 1.6;
		background: #000;
		color: #f5f7fa;
	}

	#mobile-block {
		display: none;
	}

	@media (max-width: 768px) {
		#mobile-block {
			display: flex !important;
			position: fixed;
			inset: 0;
			z-index: 9999;
			background: #000;
			color: #f5f7fa;
			align-items: center;
			justify-content: center;
			text-align: center;
			padding: 2rem;
			box-sizing: border-box;
		}

		/* hide everything else underneath; #mobile-block wins by id specificity */
		body > * {
			display: none !important;
		}

		.mobile-block-inner h1 {
			color: #ffce1c;
			font-size: 1.5rem;
			margin: 0 0 1rem;
		}

		.mobile-block-inner p {
			margin: 0.35rem 0;
			font-size: 0.95rem;
		}

		.mobile-block-inner .mb-sub {
			color: #888;
			font-size: 0.85rem;
		}
	}

</style>

<style is:global>
	/* ---- global side nav (wide screens only) ---- */
	.side-nav {
		display: none;
	}

	/* ---- global site title (wide screens only) ---- */
	.site-title {
		display: none;
	}

	.side-nav-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		color: #f5f7fa;
		text-decoration: none;
		font-size: 1.15rem;
		line-height: 1;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.side-nav-item:hover {
		background: #111;
		color: #ffce1c;
	}

	.side-nav-item.active {
		font-weight: 700;
	}

	.side-nav-icon {
		width: 1.6rem;
		height: 1.6rem;
		flex-shrink: 0;
	}

	.side-nav-iconwrap {
		position: relative;
		display: inline-flex;
	}

	.notif-badge {
		position: absolute;
		top: -1px;
		right: -1px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #ffce1c;
		box-shadow: 0 0 4px 1px rgba(255, 206, 28, 0.6);
		animation: notif-glow 3s ease-in-out infinite;
	}

	@keyframes notif-glow {
		0%,
		100% {
			opacity: 0.65;
			box-shadow: 0 0 3px 0 rgba(255, 206, 28, 0.45);
		}
		50% {
			opacity: 1;
			box-shadow: 0 0 7px 2px rgba(255, 206, 28, 0.85);
		}
	}

	.nav-account-avatar {
		width: 1.6rem;
		height: 1.6rem;
		flex-shrink: 0;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid #333;
		background: #111;
		color: #666;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.nav-account-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.nav-account-avatar svg {
		width: 1rem;
		height: 1rem;
	}

	.nav-account-name {
		display: inline-flex;
		align-items: center;
		color: #ffce1c;
		font-weight: 700;
	}

	.nav-account-name .badge-svg {
		width: 0.95em;
		height: 0.95em;
		margin-left: 0.15em;
		flex-shrink: 0;
	}

	/* ---- status block (wide screens only) ---- */
	.build-info {
		display: none;
	}

	.current-time,
	.build-number {
		margin: 0;
		color: #ffce1c;
		font-size: 0.75rem;
		opacity: 0.8;
	}

	.status-row {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.status-dot {
		display: inline-block;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #ffce1c;
		box-shadow: 0 0 4px 1px rgba(255, 206, 28, 0.6);
		animation: status-blink 2.5s ease-in-out infinite;
		flex-shrink: 0;
	}

	@keyframes status-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.4;
		}
	}

	.built-by-link,
	.built-by-link:visited {
		color: inherit;
		text-decoration: none;
	}

	.built-by-link:hover {
		text-decoration: underline;
	}

	@media (min-width: 1240px) {
		.side-nav {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			position: fixed;
			top: 6rem;
			left: calc(50vw + 380px + 2rem);
			z-index: 40;
			white-space: nowrap;
		}

		/* status block: bottom-left. Left edge anchored to the title's left edge
		   (title is a 190px-wide SVG, right edge 2rem off the feed) so the first
		   letters line up in a column with "Osprey,". */
		.build-info {
			display: block;
			position: fixed;
			bottom: 2rem;
			left: calc(50vw - 380px - 2rem - 190px);
			text-align: left;
			z-index: 40;
		}

		/* AI page has its own left sidebar layout (no centered column),
		   so sit the status block in that left column, first letter aligned
		   with the chat-list text, instead of overlapping the chat. */
		.page-ai .build-info {
			right: auto;
			left: 1.5rem;
		}

		/* site title: top of the left rail, 2rem off the feed (mirrors the nav).
		   top tuned so the "O" cap-top lines up with the "RSS Feed" topnav text. */
		.site-title {
			display: block;
			position: fixed;
			top: 2.25rem;
			right: calc(50vw + 380px + 2rem);
			z-index: 40;
		}

		/* AI page has its own header idea — hide the global title there */
		.page-ai .site-title {
			display: none;
		}
	}
</style>
