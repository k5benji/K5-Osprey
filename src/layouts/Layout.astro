---
const path = Astro.url.pathname;
const isHome = path === '/';
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="data:," />
		<title>Osprey</title>
		<!-- Set the theme before first paint to avoid a flash. Default: light. -->
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('osprey-theme');
					document.documentElement.dataset.theme = t === 'dark' ? 'dark' : 'light';
				} catch (e) {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
	</head>
	<body>
		<!-- Hidden gradient defs for verification / engineer badges. -->
		<svg width="0" height="0" style="position: absolute" aria-hidden="true">
			<defs>
				<linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#8a9098"></stop>
					<stop offset="35%" stop-color="#f3f6f9"></stop>
					<stop offset="50%" stop-color="#ffffff"></stop>
					<stop offset="66%" stop-color="#b9bfc5"></stop>
					<stop offset="100%" stop-color="#5f656b"></stop>
					<animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
				</linearGradient>
				<linearGradient id="sia-pink" x1="0" y1="0" x2="1" y2="1" spreadMethod="reflect">
					<stop offset="0%" stop-color="#ffb6d5"></stop>
					<stop offset="30%" stop-color="#e7b8ff"></stop>
					<stop offset="50%" stop-color="#fff2f8"></stop>
					<stop offset="70%" stop-color="#ffc9b0"></stop>
					<stop offset="100%" stop-color="#ffb6d5"></stop>
					<animateTransform attributeName="gradientTransform" type="translate" values="-0.6 -0.6; 0.6 0.6; -0.6 -0.6" dur="4.5s" repeatCount="indefinite"></animateTransform>
				</linearGradient>
			</defs>
		</svg>

		<header class="topbar glass">
			<a class="brand" href="/" aria-label="Osprey home">
				<span class="brand-mark" aria-hidden="true"></span>
				<span class="brand-word">Osprey</span>
			</a>
			<div class="topbar-right">
				<button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode">
					<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0-13a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1zm0 14a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V19a1 1 0 0 1 1-1zM4 12a1 1 0 0 1 1-1h1.5a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1zm13.5 0a1 1 0 0 1 1-1H20a1 1 0 1 1 0 2h-1.5a1 1 0 0 1-1-1zM6.34 6.34a1 1 0 0 1 1.41 0l1.06 1.06a1 1 0 0 1-1.41 1.41L6.34 7.76a1 1 0 0 1 0-1.42zm8.85 8.85a1 1 0 0 1 1.41 0l1.06 1.06a1 1 0 1 1-1.41 1.41l-1.06-1.06a1 1 0 0 1 0-1.41zM17.66 6.34a1 1 0 0 1 0 1.42l-1.06 1.06a1 1 0 1 1-1.41-1.41l1.06-1.06a1 1 0 0 1 1.41 0zM8.81 15.19a1 1 0 0 1 0 1.41l-1.06 1.06a1 1 0 1 1-1.41-1.41l1.06-1.06a1 1 0 0 1 1.41 0z"/></svg>
					<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
				</button>
				<a class="acct" id="acct" href="/profile">
					<span class="acct-label" id="acct-label">Sign in</span>
				</a>
			</div>
		</header>

		<div class={`page${isHome ? ' page-home' : ''}`}>
			<slot />
		</div>

		<script>
			// ---- theme toggle ----
			const root = document.documentElement;
			const toggle = document.getElementById('theme-toggle');
			toggle?.addEventListener('click', () => {
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try {
					localStorage.setItem('osprey-theme', next);
				} catch {}
			});

			// ---- account chip ----
			const acct = document.getElementById('acct');
			const acctLabel = document.getElementById('acct-label');
			function esc(s: string) {
				return (s ?? '').replace(
					/[&<>"]/g,
					(c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string
				);
			}
			fetch('/api/me')
				.then((r) => r.json())
				.then((me) => {
					if (!me || !acct || !acctLabel) return;
					const initial = (me.displayName || me.username || '?').charAt(0).toUpperCase();
					const avatar = me.avatar
						? `<span class="acct-avatar" style="background-image:url('${esc(me.avatar)}')"></span>`
						: `<span class="acct-avatar fallback">${esc(initial)}</span>`;
					acctLabel.outerHTML = avatar + `<span class="acct-name">${esc(me.displayName || me.username)}</span>`;
				})
				.catch(() => {});
		</script>

		<style is:global>
			:root {
				--accent: #ffce1c;
				--accent-strong: #f5b800;
				--accent-ink: #4a3a00;
				--radius: 18px;
				--radius-sm: 12px;
				--topbar-h: 60px;
				--font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
			}

			html[data-theme='light'] {
				--bg: #ffffff;
				--text: #14161a;
				--muted: #6b7280;
				--glass-bg: rgba(255, 255, 255, 0.55);
				--glass-border: rgba(20, 22, 26, 0.08);
				--glass-highlight: rgba(255, 255, 255, 0.75);
				--glass-shadow: 0 10px 34px rgba(20, 22, 26, 0.1);
				--field-bg: rgba(255, 255, 255, 0.7);
				--blob-a: rgba(255, 206, 28, 0.28);
				--blob-b: rgba(120, 170, 255, 0.14);
				--blob-c: rgba(255, 150, 200, 0.12);
			}

			html[data-theme='dark'] {
				--bg: #0b0c0f;
				--text: #f1f3f6;
				--muted: #9aa1ab;
				--glass-bg: rgba(28, 30, 36, 0.5);
				--glass-border: rgba(255, 255, 255, 0.09);
				--glass-highlight: rgba(255, 255, 255, 0.1);
				--glass-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
				--field-bg: rgba(255, 255, 255, 0.05);
				--blob-a: rgba(255, 206, 28, 0.16);
				--blob-b: rgba(80, 130, 255, 0.16);
				--blob-c: rgba(255, 90, 160, 0.12);
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				height: 100%;
			}

			body {
				min-height: 100vh;
				font-family: var(--font);
				color: var(--text);
				background: var(--bg);
				-webkit-font-smoothing: antialiased;
				display: flex;
				flex-direction: column;
				overflow-x: hidden;
			}

			/* Soft liquid background so the frosted panels actually read. */
			body::before {
				content: '';
				position: fixed;
				inset: -20vmax;
				z-index: -1;
				background:
					radial-gradient(38vmax 38vmax at 12% 8%, var(--blob-a), transparent 60%),
					radial-gradient(42vmax 42vmax at 88% 18%, var(--blob-b), transparent 62%),
					radial-gradient(40vmax 40vmax at 70% 95%, var(--blob-c), transparent 60%);
				filter: saturate(1.1);
				animation: drift 28s ease-in-out infinite alternate;
			}

			@keyframes drift {
				to {
					transform: translate3d(0, -3%, 0) scale(1.06);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				body::before {
					animation: none;
				}
			}

			a {
				color: inherit;
			}

			/* ---- liquid glass ---- */
			.glass {
				background: var(--glass-bg);
				-webkit-backdrop-filter: blur(22px) saturate(1.7);
				backdrop-filter: blur(22px) saturate(1.7);
				border: 1px solid var(--glass-border);
				box-shadow: var(--glass-shadow), inset 0 1px 0 var(--glass-highlight);
			}

			/* ---- top bar ---- */
			.topbar {
				position: sticky;
				top: 0;
				z-index: 50;
				height: var(--topbar-h);
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 1.1rem;
				border-radius: 0;
				border-left: none;
				border-right: none;
				border-top: none;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				text-decoration: none;
				font-weight: 800;
				font-size: 1.25rem;
				letter-spacing: -0.02em;
			}

			.brand-mark {
				width: 18px;
				height: 18px;
				border-radius: 6px;
				background: linear-gradient(135deg, var(--accent), var(--accent-strong));
				box-shadow: 0 2px 10px rgba(255, 206, 28, 0.5);
			}

			.brand-word {
				color: var(--text);
			}

			.topbar-right {
				display: flex;
				align-items: center;
				gap: 0.55rem;
			}

			.icon-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 38px;
				height: 38px;
				border-radius: 50%;
				border: 1px solid var(--glass-border);
				background: var(--field-bg);
				color: var(--text);
				cursor: pointer;
				transition: transform 0.15s ease, background 0.15s ease;
			}

			.icon-btn:hover {
				transform: translateY(-1px);
				background: var(--glass-bg);
			}

			.icon-btn svg {
				width: 19px;
				height: 19px;
			}

			html[data-theme='light'] .icon-moon,
			html[data-theme='dark'] .icon-sun {
				display: none;
			}

			.acct {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				height: 38px;
				padding: 0 0.85rem 0 0.5rem;
				border-radius: 999px;
				border: 1px solid var(--glass-border);
				background: var(--field-bg);
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--text);
				transition: transform 0.15s ease, background 0.15s ease;
			}

			.acct:hover {
				transform: translateY(-1px);
				background: var(--glass-bg);
			}

			.acct-label {
				padding: 0 0.35rem;
			}

			.acct-avatar {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				background-size: cover;
				background-position: center;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-weight: 700;
				font-size: 0.85rem;
				color: var(--accent-ink);
			}

			.acct-avatar.fallback {
				background: linear-gradient(135deg, var(--accent), var(--accent-strong));
			}

			.acct-name {
				max-width: 11ch;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			/* ---- page shell ---- */
			.page {
				flex: 1;
				min-height: 0;
				display: flex;
				flex-direction: column;
			}

			/* shared focus ring + buttons used across pages */
			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

			.btn-accent {
				background: linear-gradient(135deg, var(--accent), var(--accent-strong));
				color: var(--accent-ink);
				border: none;
				font-weight: 700;
				border-radius: 999px;
				cursor: pointer;
				box-shadow: 0 4px 16px rgba(255, 206, 28, 0.4);
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}

			.btn-accent:hover {
				transform: translateY(-1px);
				box-shadow: 0 6px 20px rgba(255, 206, 28, 0.5);
			}

			.badge-svg {
				width: 1em;
				height: 1em;
				vertical-align: -0.14em;
				margin-left: 0.06em;
			}

			::-webkit-scrollbar {
				width: 10px;
				height: 10px;
			}

			::-webkit-scrollbar-thumb {
				background: var(--glass-border);
				border-radius: 999px;
			}
		</style>
	</body>
</html>
