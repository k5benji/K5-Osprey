---
import { videos } from '../data/outpost-videos';

const videosJson = JSON.stringify(videos);
---

<section class="outpost-player">
  <div class="frame-wrap">
    <iframe
      id="outpost-frame"
      src=""
      title="Outpost transmission"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </div>

  <div class="meta" id="outpost-meta">
    <p class="video-id" id="outpost-id"></p>
    <h2 class="video-title" id="outpost-title"></h2>
    <p class="video-source" id="outpost-source"></p>
    <p class="video-warning" id="outpost-warning" hidden></p>
    <p class="video-description" id="outpost-description"></p>
  </div>

  <button class="load-button" id="outpost-load" type="button">Load Another Video</button>
</section>

<script type="application/json" id="outpost-videos" set:html={videosJson} />

<script>
  interface OutpostVideo {
    id: string;
    title: string;
    source: string;
    category?: string;
    contentWarning?: string;
    description?: string;
    embedUrl: string;
  }

  const dataEl = document.getElementById('outpost-videos');
  const videos: OutpostVideo[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];

  const frame = document.getElementById('outpost-frame') as HTMLIFrameElement | null;
  const meta = document.getElementById('outpost-meta');
  const idEl = document.getElementById('outpost-id');
  const titleEl = document.getElementById('outpost-title');
  const sourceEl = document.getElementById('outpost-source');
  const warningEl = document.getElementById('outpost-warning');
  const descriptionEl = document.getElementById('outpost-description');
  const loadButton = document.getElementById('outpost-load');

  let currentIndex = -1;

  function pickIndex(): number {
    if (videos.length <= 1) return 0;
    let index = currentIndex;
    while (index === currentIndex) {
      index = Math.floor(Math.random() * videos.length);
    }
    return index;
  }

  function render(video: OutpostVideo) {
    if (!frame || !idEl || !titleEl || !sourceEl || !descriptionEl) return;
    frame.src = video.embedUrl;
    idEl.textContent = `Video ID: ${video.id}`;
    titleEl.textContent = video.title;
    sourceEl.textContent = `Source: ${video.source}`;

    if (warningEl) {
      warningEl.textContent = video.contentWarning ? `⚠ ${video.contentWarning}` : '';
      warningEl.toggleAttribute('hidden', !video.contentWarning);
    }
    descriptionEl.textContent = video.description ?? '';
    descriptionEl.toggleAttribute('hidden', !video.description);
  }

  function loadRandom() {
    if (videos.length === 0) return;
    currentIndex = pickIndex();
    const video = videos[currentIndex];

    const wrap = frame?.parentElement;
    wrap?.classList.add('is-fading');
    meta?.classList.add('is-fading');

    setTimeout(() => {
      render(video);
      wrap?.classList.remove('is-fading');
      meta?.classList.remove('is-fading');
    }, 250);
  }

  loadButton?.addEventListener('click', loadRandom);
  loadRandom();
</script>

<style>
  .outpost-player {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .frame-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid #333;
    transition: opacity 0.25s ease;
  }

  .frame-wrap.is-fading {
    opacity: 0;
  }

  .frame-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .meta {
    transition: opacity 0.25s ease;
  }

  .meta.is-fading {
    opacity: 0;
  }

  .video-id {
    margin: 0;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .video-title {
    margin: 0.25rem 0 0;
    color: #f5f5f5;
    font-size: 1.4rem;
  }

  .video-source {
    margin: 0.25rem 0 0;
    color: #888;
    font-size: 0.85rem;
  }

  .video-warning {
    margin: 0.75rem 0 0;
    color: #ffce1c;
    font-size: 0.8rem;
    opacity: 0.9;
  }

  .video-description {
    margin: 0.75rem 0 0;
    color: #bbb;
    max-width: 48rem;
  }

  .load-button {
    align-self: flex-start;
    padding: 0.6rem 1.2rem;
    font-family: inherit;
    font-size: 0.85rem;
    color: #ffce1c;
    background: transparent;
    border: 1px solid #ffce1c;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .load-button:hover {
    background: #ffce1c;
    color: #111;
  }
</style>
