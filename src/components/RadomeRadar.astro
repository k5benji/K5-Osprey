<canvas id="radome" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('radome') as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const YELLOW = '255, 206, 28';
    const WHITE = '245, 247, 250';

    let width = 0;
    let height = 0;
    let cx = 0;
    let cy = 0;
    let radius = 0;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      width = canvas!.clientWidth;
      height = canvas!.clientHeight;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = width * 0.5;
      cy = height * 0.44;
      radius = Math.min(width, height) * 0.32;
    }
    resize();
    window.addEventListener('resize', resize);

    // --- 3D projection ---
    const TILT = 0.35;
    const FOCAL = 4;
    let spin = 0;
    let spinVelocity = 0.004;

    function project(theta: number, phi: number, spinAngle: number) {
      // point on unit sphere
      let x = Math.sin(theta) * Math.cos(phi + spinAngle);
      let y = Math.cos(theta);
      let z = Math.sin(theta) * Math.sin(phi + spinAngle);
      // tilt around x axis
      const y2 = y * Math.cos(TILT) - z * Math.sin(TILT);
      const z2 = y * Math.sin(TILT) + z * Math.cos(TILT);
      const scale = FOCAL / (FOCAL + z2);
      return {
        x: cx + x * radius * scale,
        y: cy - y2 * radius * scale,
        depth: z2,
      };
    }

    function strokePath(
      points: { x: number; y: number; depth: number }[],
      rgb: string,
      baseAlpha: number
    ) {
      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        // back-of-sphere lines fade
        const alpha = baseAlpha * (b.depth < 0 ? 1 : 0.25);
        ctx.strokeStyle = `rgba(${rgb}, ${alpha})`;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }

    // --- signal pulses ---
    interface Pulse {
      r: number;
      alpha: number;
    }
    const pulses: Pulse[] = [];
    let lastAutoPulse = 0;

    function emitPulse() {
      pulses.push({ r: radius * 0.4, alpha: 0.55 });
    }

    // --- interaction ---
    let dragging = false;
    let lastX = 0;

    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      spinVelocity = dx * 0.0006;
      spin += dx * 0.006;
    });
    window.addEventListener('pointerup', () => {
      dragging = false;
    });
    canvas.addEventListener('click', emitPulse);

    // --- render loop ---
    const MERIDIANS = 10;
    const PARALLELS = 6;
    const SEGMENTS = 40;

    function frame(t: number) {
      ctx.clearRect(0, 0, width, height);

      if (!dragging) {
        // ease back toward cruise speed
        spinVelocity += (0.004 - spinVelocity) * 0.02;
      }
      spin += spinVelocity;

      // pedestal
      const baseY = cy + radius * 1.08;
      ctx.strokeStyle = `rgba(${WHITE}, 0.12)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx - radius * 0.35, baseY);
      ctx.lineTo(cx - radius * 0.16, cy + radius * 0.8);
      ctx.moveTo(cx + radius * 0.35, baseY);
      ctx.lineTo(cx + radius * 0.16, cy + radius * 0.8);
      ctx.moveTo(cx - radius * 0.5, baseY);
      ctx.lineTo(cx + radius * 0.5, baseY);
      ctx.stroke();

      // wireframe dome
      ctx.lineWidth = 1;
      for (let m = 0; m < MERIDIANS; m++) {
        const phi = (m / MERIDIANS) * Math.PI * 2;
        const pts = [];
        for (let s = 0; s <= SEGMENTS; s++) {
          pts.push(project((s / SEGMENTS) * Math.PI, phi, spin));
        }
        strokePath(pts, WHITE, 0.18);
      }
      for (let p = 1; p <= PARALLELS; p++) {
        const theta = (p / (PARALLELS + 1)) * Math.PI;
        const pts = [];
        for (let s = 0; s <= SEGMENTS; s++) {
          pts.push(project(theta, (s / SEGMENTS) * Math.PI * 2, spin));
        }
        strokePath(pts, WHITE, 0.14);
      }

      // radar sweep: bright leading edge + fading trail on the equator
      const sweepAngle = t * 0.0012;
      const TRAIL = 28;
      for (let i = 0; i < TRAIL; i++) {
        const a = sweepAngle - i * 0.035;
        const tip = project(Math.PI / 2, a, spin);
        const alpha = 0.5 * (1 - i / TRAIL) * (tip.depth < 0 ? 1 : 0.3);
        ctx.strokeStyle = `rgba(${YELLOW}, ${alpha})`;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(tip.x, tip.y);
        ctx.stroke();
      }

      // signal pulses
      if (t - lastAutoPulse > 3200) {
        lastAutoPulse = t;
        emitPulse();
      }
      for (let i = pulses.length - 1; i >= 0; i--) {
        const pulse = pulses[i];
        pulse.r += radius * 0.012;
        pulse.alpha *= 0.975;
        if (pulse.alpha < 0.01) {
          pulses.splice(i, 1);
          continue;
        }
        ctx.strokeStyle = `rgba(${YELLOW}, ${pulse.alpha})`;
        ctx.beginPath();
        ctx.ellipse(cx, cy, pulse.r, pulse.r * 0.38, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
</script>

<style>
  #radome {
    display: block;
    width: 220px;
    height: 190px;
    margin-top: 1.5rem;
    cursor: grab;
  }

  #radome:active {
    cursor: grabbing;
  }
</style>
