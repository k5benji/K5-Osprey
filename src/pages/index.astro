---
import Layout from '../layouts/Layout.astro';
import RadomeRadar from '../components/RadomeRadar.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto; position: relative;">
    <header>
      <h1>Osprey, engineered by Kastle Five systems.</h1>
      <p class="byline">
        <a href="https://x.com/k5binya" target="_blank" rel="noopener">Built by @k5binya</a>
      </p>
    </header>
    <p class="rss-link">
      <a href="/rss.xml" class="muted-link">RSS Feed</a>
    </p>
    <p>
      <a href="/writtenwork/" class="muted-link">View Written Work</a>
    </p>
    <p>
      <a href="/kastlefive/" class="muted-link">Architecture of Kastle Five</a>
    </p>
    <p>
      <a href="/outpost/" class="muted-link">Outpost</a>
    </p>
    <p>
      <a href="/notebook/" class="muted-link">Notebook</a>
    </p>
    <section class="oracle">
      <p class="oracle-link">
        <a href="/ospreyai"><span class="oracle-prompt" aria-hidden="true">&gt;</span> Chat with Osprey AI</a>
      </p>
    </section>

    <div class="status-row-wrap">
      <div class="build-info">
      <p class="build-number status-row">
        <span>Site Status:</span>
        <span class="status-dot" aria-hidden="true"></span>
        <span>Active</span>
      </p>
      <p class="build-number">Osprey Kastle Five Build 0.8.1</p>
      <p class="build-number">Published: Sept 5, 2025</p>
      <p class="build-number">Updated: Jun 9, 2026</p>
      </div>
      <div class="radar-side">
        <RadomeRadar />
        <p class="current-time">Current time: <span id="local-time"></span></p>
      </div>
    </div>
  </main>
</Layout>

<script>
  // align the radar / current-time column's right edge with the title's last character
  const headerEl = document.querySelector('header');
  const sideEl = document.querySelector('.radar-side') as HTMLElement | null;

  function alignRadar() {
    if (!headerEl || !sideEl) return;
    sideEl.style.marginRight = '0';
    const headerRight = headerEl.getBoundingClientRect().right;
    const sideRight = sideEl.getBoundingClientRect().right;
    sideEl.style.marginRight = `${Math.max(0, sideRight - headerRight)}px`;
  }
  alignRadar();
  window.addEventListener('resize', alignRadar);
  document.fonts?.ready.then(alignRadar);

  // local clock
  const timeEl = document.getElementById('local-time');
  function tick() {
    if (!timeEl) return;
    timeEl.textContent = new Date().toLocaleTimeString(undefined, {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
  }
  tick();
  setInterval(tick, 1000);
</script>

<style>
  .rss-link {
    margin-top: 3rem;
    font-size: 1rem;
  }

  .rss-link a {
    color: #888;
    text-decoration: none;
  }

  .rss-link a:hover {
    color: #666;
  }

  a.muted-link,
  a.muted-link:visited {
    color: #888;
    text-decoration: none;
    position: relative;
  }

  a.muted-link::before {
    content: '>';
    position: absolute;
    left: -0.9em;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.75em;
    color: #ffce1c;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  a.muted-link:hover,
  a.muted-link:visited:hover {
    color: #ffce1c;
    text-decoration: none;
  }

  a.muted-link:hover::before {
    opacity: 1;
  }

  header {
    /* shrink-wrap to the title so the byline's right edge
       lands on the title's last character */
    width: fit-content;
  }

  header h1 {
    margin-bottom: 0;
  }

  .byline {
    /* negative top pulls it against the title; bottom offsets the
       size reduction so everything below stays in place */
    margin: -0.45rem 0 1.33rem;
    font-size: 0.85rem;
    text-align: right;
  }

  .byline a,
  .byline a:visited {
    color: #f5f7fa;
    text-decoration: none;
  }

  .byline a:hover,
  .byline a:visited:hover {
    color: #ffce1c;
  }

  .oracle {
    margin-top: 4.6rem;
    max-width: 42rem;
  }

  .oracle-link {
    margin: 0;
    font-size: 1rem;
  }

  .oracle-link a,
  .oracle-link a:visited {
    color: #f5f7fa;
    text-decoration: none;
  }

  .oracle-link a:hover,
  .oracle-link a:visited:hover {
    color: #ffce1c;
  }

  .oracle-prompt {
    color: #ffce1c;
    font-weight: 700;
  }

  .status-row-wrap {
    margin-top: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
  }

  .radar-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
  }

  .current-time {
    margin: 0;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .build-number {
    margin: 0;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 4px;
    border-radius: 50%;
    background: #ffce1c;
    box-shadow: 0 0 4px 1px rgba(255, 206, 28, 0.6);
    animation: status-blink 2.5s ease-in-out infinite;
    flex-shrink: 0;
    margin-right: 0;
  }

  @keyframes status-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
</style>
