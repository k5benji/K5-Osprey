---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
    <header>
      <h1>Osprey Thread Kastle Five. Built by Benjamin Weberink.</h1>
    </header>
    <p>An ongoing body of written work. In partnership with Red Bull.</p>
    <p>Engineer of Kastle Five.</p>

    <p class="rss-link">
      <a href="/rss.xml" class="muted-link">RSS Feed</a>
    </p>
    <p>
      <a href="/blog/" class="muted-link">View Archive</a>
    </p>
    <p>
      <a href="/kastlefive/" class="muted-link">Architecture of Kastle Five</a>
    </p>
    <p class="build-number">Osprey Kastle Five Build 0.7.0</p>
  </main>
</Layout>

<style>
  .rss-link {
    margin-top: 0.75rem;
    font-size: 1rem;
  }

  .rss-link a {
    color: #888;
    text-decoration: none;
  }

  .rss-link a:hover {
    color: #666;
  }

  a.muted-link,
  a.muted-link:visited {
    color: #888;
    text-decoration: none;
  }

  a.muted-link:hover,
  a.muted-link:visited:hover {
    color: #ffce1c;
    text-decoration: none;
  }

  .build-number {
    margin-top: 3rem;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }
</style>
