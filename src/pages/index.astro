---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
    <header>
      <h1>Osprey, engineered by Kastle Five systems.</h1>
      <p class="byline">Built by @K5binya</p>
    </header>
    <div class="description">
      <p>An ongoing body of written work. In partnership with Red Bull.</p>
    </div>

    <p class="rss-link">
      <a href="/rss.xml" class="muted-link">RSS Feed</a>
    </p>
    <p>
      <a href="/blog/" class="muted-link">View Archive</a>
    </p>
    <p>
      <a href="/kastlefive/" class="muted-link">Architecture of Kastle Five</a>
    </p>
    <p>
      <a href="/outpost/" class="muted-link">Outpost</a>
    </p>
    <p>
      <a href="/notebook/" class="muted-link">Notebook</a>
    </p>
    <div class="build-info">
      <p class="build-number status-row">
        <span>Site Status:</span>
        <span class="status-dot" aria-hidden="true"></span>
        <span>Active</span>
      </p>
      <p class="build-number">Osprey Kastle Five Build 0.8.1</p>
      <p class="build-number">Published: Sept 5, 2025</p>
      <p class="build-number">Updated: Jun 9, 2026</p>
    </div>
  </main>
</Layout>

<style>
  .rss-link {
    margin-top: 3rem;
    font-size: 1rem;
  }

  .rss-link a {
    color: #888;
    text-decoration: none;
  }

  .rss-link a:hover {
    color: #666;
  }

  a.muted-link,
  a.muted-link:visited {
    color: #888;
    text-decoration: none;
  }

  a.muted-link:hover,
  a.muted-link:visited:hover {
    color: #ffce1c;
    text-decoration: none;
  }

  header h1 {
    margin-bottom: 0;
  }

  .byline {
    /* negative top pulls it against the title; bottom offsets the
       size reduction so everything below stays in place */
    margin: -0.45rem 0 1.33rem;
    font-size: 0.85rem;
    color: #111;
    text-align: right;
  }

  .description p {
    margin: 0;
  }

  .build-info {
    margin-top: 3rem;
  }

  .build-number {
    margin: 0;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 4px;
    border-radius: 50%;
    background: #ffce1c;
    box-shadow: 0 0 4px 1px rgba(255, 206, 28, 0.6);
    animation: status-blink 2.5s ease-in-out infinite;
    flex-shrink: 0;
    margin-right: 0;
  }

  @keyframes status-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
</style>
