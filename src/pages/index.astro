---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
    <header>
      <h1>Benjamin Weberink's Written Archive Thread</h1>
    </header>
    <p>Personal writings and other written works</p>

    <p class="rss-link">
      <a href="/rss.xml">RSS Feed</a>
    </p>
    <p>
      <a href="/blog/">View Archive</a>
    </p>
  </main>
</Layout>

<style>
  .rss-link {
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }

  .rss-link a {
    color: #888;
    text-decoration: none;
  }

  .rss-link a:hover {
    color: #666;
  }
</style>
