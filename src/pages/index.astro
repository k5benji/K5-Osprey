---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="app">
    <aside class="sidebar glass" id="sidebar">
      <button class="side-btn new-chat btn-accent" id="new-chat">+ New chat</button>
      <button class="side-btn saved-btn" id="saved-btn">Saved texts</button>

      <p class="side-label">Chats</p>
      <div class="chat-list" id="chat-list"></div>
    </aside>

    <main class="chat-main empty glass" id="chat-main">
      <div class="thread" id="thread"></div>

      <div class="composer" id="composer">
        <div class="empty-hero">
          <h1 class="empty-title" id="empty-title">Chat with Osprey</h1>
          <p class="empty-sub" id="empty-sub">Powered by Kastle Five Systems</p>
        </div>
        <form id="chat-form" class="chat-form glass">
          <span class="prompt" aria-hidden="true">&gt;</span>
          <textarea
            id="chat-input"
            rows="1"
            maxlength="2000"
            placeholder="Ask Osprey something."
            autocomplete="off"></textarea>
          <button type="submit" id="chat-send" class="btn-accent">Send</button>
        </form>
      </div>
    </main>
  </div>
</Layout>

<script>
  interface Msg {
    role: 'user' | 'assistant';
    content: string;
  }
  interface Chat {
    id: string;
    title: string;
    messages: Msg[];
    createdAt: number;
  }
  interface Saved {
    id: string;
    content: string;
    savedAt: number;
  }

  const CHATS_KEY = 'osprey_chats';
  const SAVED_KEY = 'osprey_saved';

  function load<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }
  function persist() {
    localStorage.setItem(CHATS_KEY, JSON.stringify(chats));
    localStorage.setItem(SAVED_KEY, JSON.stringify(saved));
  }

  let chats: Chat[] = load<Chat[]>(CHATS_KEY, []);
  let saved: Saved[] = load<Saved[]>(SAVED_KEY, []);
  let currentId: string | null = null;
  let busy = false;

  const chatMain = document.getElementById('chat-main')!;
  const thread = document.getElementById('thread')!;
  const composer = document.getElementById('composer')!;
  const emptyTitle = document.getElementById('empty-title')!;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
  const chatList = document.getElementById('chat-list')!;

  function currentChat(): Chat | null {
    return chats.find((c) => c.id === currentId) ?? null;
  }

  // ---------- rendering ----------
  function renderSidebar() {
    chatList.textContent = '';
    for (const chat of [...chats].sort((a, b) => b.createdAt - a.createdAt)) {
      const item = document.createElement('div');
      item.className = 'chat-item' + (chat.id === currentId ? ' active' : '');

      const title = document.createElement('span');
      title.className = 'chat-item-title';
      title.textContent = chat.title || 'New chat';
      title.addEventListener('click', () => openChat(chat.id));

      const del = document.createElement('button');
      del.className = 'chat-item-del';
      del.textContent = '×';
      del.title = 'Delete chat';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteChat(chat.id);
      });

      item.append(title, del);
      chatList.appendChild(item);
    }
  }

  function messageEl(role: 'user' | 'assistant', text: string, withSave = true): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = `msg ${role === 'user' ? 'user' : 'osprey'}`;

    const who = document.createElement('p');
    who.className = 'who';
    who.textContent = role === 'user' ? 'You' : 'Osprey';

    const body = document.createElement('p');
    body.className = 'body';

    const textEl = document.createElement('span');
    textEl.className = 'body-text';
    textEl.textContent = text;
    body.appendChild(textEl);

    wrap.append(who, body);

    if (role === 'assistant' && withSave) attachSave(wrap, textEl);

    return wrap;
  }

  // The save control sits below the bubble, as a sibling of .body (not inside it).
  function attachSave(wrap: HTMLElement, textEl: HTMLElement) {
    if (wrap.querySelector(':scope > .save-btn')) return;
    const save = document.createElement('button');
    save.className = 'save-btn';
    const existing = saved.find((s) => s.content === (textEl.textContent ?? ''));
    if (existing) markSaved(save, existing.id);
    else markUnsaved(save);
    save.addEventListener('click', () => toggleSave(save, textEl.textContent ?? ''));
    wrap.appendChild(save);
  }

  function markSaved(btn: HTMLElement, id: string) {
    btn.dataset.savedId = id;
    btn.classList.add('saved');
    btn.innerHTML = 'Saved <span class="tick">✓</span>';
  }

  function markUnsaved(btn: HTMLElement) {
    delete btn.dataset.savedId;
    btn.classList.remove('saved');
    btn.textContent = 'Save text';
  }

  function toggleSave(btn: HTMLElement, content: string) {
    if (!content.trim()) return;
    if (btn.dataset.savedId) {
      const id = btn.dataset.savedId;
      saved = saved.filter((s) => s.id !== id);
      persist();
      markUnsaved(btn);
    } else {
      const id = crypto.randomUUID();
      saved.unshift({ id, content, savedAt: Date.now() });
      persist();
      markSaved(btn, id);
    }
  }

  // Chrome-yellow "Thinking" indicator with a live elapsed timer.
  function thinkingEl(startedAt: number): { el: HTMLElement; stop: () => void } {
    const el = document.createElement('span');
    el.className = 'thinking';
    const label = document.createElement('span');
    label.className = 'thinking-label';
    label.textContent = 'Thinking';
    const time = document.createElement('span');
    time.className = 'thinking-time';
    el.append(label, time);
    const tick = () => {
      time.textContent = ((Date.now() - startedAt) / 1000).toFixed(1) + 's';
    };
    tick();
    const timer = setInterval(tick, 100);
    return { el, stop: () => clearInterval(timer) };
  }

  function renderThread() {
    thread.textContent = '';
    const chat = currentChat();
    if (!chat) return;
    for (const m of chat.messages) {
      thread.appendChild(messageEl(m.role, m.content));
    }
    thread.scrollTop = thread.scrollHeight;
  }

  function showEmpty() {
    chatMain.classList.add('empty');
    chatMain.classList.remove('viewing-saved');
    thread.textContent = '';
  }
  function showThread() {
    chatMain.classList.remove('empty', 'viewing-saved');
  }

  // ---------- actions ----------
  function newChat() {
    currentId = null;
    showEmpty();
    renderSidebar();
    input.value = '';
    autoGrow();
    input.focus();
  }

  function openChat(id: string) {
    currentId = id;
    showThread();
    renderThread();
    renderSidebar();
    input.focus();
  }

  function deleteChat(id: string) {
    chats = chats.filter((c) => c.id !== id);
    persist();
    if (currentId === id) newChat();
    else renderSidebar();
  }

  function openSaved() {
    currentId = null;
    chatMain.classList.remove('empty');
    chatMain.classList.add('viewing-saved');
    renderSidebar();
    thread.textContent = '';

    const head = document.createElement('p');
    head.className = 'saved-head';
    head.textContent = 'Saved Texts';
    thread.appendChild(head);

    if (saved.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'saved-empty';
      empty.textContent = 'Nothing saved yet. Press save text after receiving an Osprey answer.';
      thread.appendChild(empty);
      return;
    }

    for (const item of saved) {
      const wrap = document.createElement('div');
      wrap.className = 'saved-item';

      const body = document.createElement('p');
      body.className = 'body';

      const textEl = document.createElement('span');
      textEl.className = 'body-text';
      textEl.textContent = item.content;
      body.appendChild(textEl);

      const remove = document.createElement('button');
      remove.className = 'save-btn';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => {
        saved = saved.filter((s) => s.id !== item.id);
        persist();
        openSaved();
      });

      // remove sits below the bubble, matching the "Save text" control
      wrap.append(body, remove);
      thread.appendChild(wrap);
    }
    thread.scrollTop = 0;
  }

  async function generateTitle(chat: Chat, seed: string) {
    try {
      const res = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ titleFor: seed }),
      });
      const data = await res.json();
      if (data.title) {
        chat.title = data.title;
        persist();
        renderSidebar();
      }
    } catch {
      /* keep fallback title */
    }
  }

  // ---------- input ----------
  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 200)}px`;
  }
  input.addEventListener('input', autoGrow);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    const question = input.value.trim();
    if (!question) return;

    // start a new chat if needed
    let chat = currentChat();
    const isFirst = !chat;
    if (!chat) {
      chat = {
        id: crypto.randomUUID(),
        title: question.slice(0, 40),
        messages: [],
        createdAt: Date.now(),
      };
      chats.push(chat);
      currentId = chat.id;
    }

    showThread();
    chat.messages.push({ role: 'user', content: question });
    thread.appendChild(messageEl('user', question));

    input.value = '';
    autoGrow();
    busy = true;
    sendBtn.disabled = true;
    persist();
    renderSidebar();

    // Always show the thinking indicator for a beat before the answer appears,
    // so a fast model still reads as deliberate rather than blurting an answer.
    const thinkStart = Date.now();
    const MIN_THINK = 1200 + Math.floor(Math.random() * 600); // 1.2–1.8s
    const wait = (ms: number) => new Promise((r) => setTimeout(r, Math.max(0, ms)));
    let revealTimer: ReturnType<typeof setTimeout> | undefined;

    // chrome-yellow "Thinking 0.0s" indicator until the answer is revealed
    const pending = messageEl('assistant', '', false);
    const pendingBody = pending.querySelector('.body-text') as HTMLElement;
    const pendingP = pending.querySelector('.body') as HTMLElement;
    const think = thinkingEl(thinkStart);
    pendingBody.appendChild(think.el);
    thread.appendChild(pending);
    thread.scrollTop = thread.scrollHeight;

    // trailing pulsing cursor shown while Osprey writes
    const cursor = document.createElement('span');
    cursor.className = 'cursor';

    try {
      const res = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: chat.messages }),
      });

      if (!res.ok || !res.body) {
        let msg = 'Osprey is silent. Try again.';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
        } catch {
          /* ignore */
        }
        think.stop();
        pendingBody.textContent = msg;
        return;
      }

      // stream tokens
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let answer = '';
      let started = false;

      // Swap the thinking dots for the answer + cursor. Held back until the
      // minimum think time has passed, so tokens buffer behind the dots first.
      const reveal = () => {
        if (started) return;
        started = true;
        think.stop();
        pendingBody.textContent = answer;
        pendingP.appendChild(cursor);
        thread.scrollTop = thread.scrollHeight;
      };
      const pushToken = (token: string) => {
        answer += token;
        if (!started) {
          const elapsed = Date.now() - thinkStart;
          // Keep showing "Thinking" until BOTH the minimum window has passed
          // AND the first token has arrived — whichever is later.
          if (elapsed < MIN_THINK) {
            if (revealTimer === undefined) revealTimer = setTimeout(reveal, MIN_THINK - elapsed);
            return;
          }
          reveal();
        }
        pendingBody.textContent = answer;
        const nearBottom =
          thread.scrollHeight - thread.scrollTop - thread.clientHeight < 80;
        if (nearBottom) thread.scrollTop = thread.scrollHeight;
      };

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() ?? '';
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed.startsWith('data:')) continue;
          const payload = trimmed.slice(5).trim();
          if (!payload || payload === '[DONE]') continue;
          try {
            const obj = JSON.parse(payload);
            if (obj.response) pushToken(obj.response);
          } catch {
            /* skip malformed chunk */
          }
        }
      }

      // If the whole answer arrived faster than the think window, keep the dots
      // up until it elapses, then reveal — so thinking is always visible.
      clearTimeout(revealTimer);
      await wait(MIN_THINK - (Date.now() - thinkStart));
      reveal();

      cursor.remove();
      answer = answer.trim();

      if (answer) {
        pendingBody.textContent = answer;
        attachSave(pending, pendingBody);
        chat.messages.push({ role: 'assistant', content: answer });
        persist();
        if (isFirst) generateTitle(chat, question);
      } else {
        pendingBody.textContent = 'Osprey is silent. Try again.';
      }
    } catch {
      clearTimeout(revealTimer);
      think.stop();
      cursor.remove();
      pendingBody.textContent = 'Osprey is silent. Try again.';
    } finally {
      clearTimeout(revealTimer);
      think.stop();
      busy = false;
      sendBtn.disabled = false;
      thread.scrollTop = thread.scrollHeight;
      input.focus();
    }
  });

  document.getElementById('new-chat')!.addEventListener('click', newChat);
  document.getElementById('saved-btn')!.addEventListener('click', openSaved);

  // ---------- init ----------
  renderSidebar();
  showEmpty();
  input.focus();
</script>

<style is:global>
  .app {
    flex: 1;
    min-height: 0;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    width: 100%;
  }

  /* ---- sidebar ---- */
  .sidebar {
    width: 250px;
    flex-shrink: 0;
    border-radius: var(--radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
  }

  .side-btn {
    text-align: center;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    background: var(--field-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .side-btn.btn-accent {
    border: none;
    box-shadow: none;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--accent-ink);
    font-weight: 700;
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .side-btn.btn-accent:hover {
    transform: translateY(-1px);
    filter: brightness(1.04) saturate(1.05);
  }

  .side-btn.btn-accent:active {
    transform: translateY(0);
    filter: brightness(0.97);
  }

  .saved-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .side-label {
    margin: 1rem 0 0.25rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .chat-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .chat-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .chat-item:hover {
    background: var(--field-bg);
  }

  .chat-item.active {
    background: var(--glass-bg);
    box-shadow: inset 0 0 0 1px var(--glass-border);
  }

  .chat-item-title {
    flex: 1;
    font-size: 0.88rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-item-del {
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .chat-item:hover .chat-item-del {
    opacity: 1;
  }

  .chat-item-del:hover {
    color: #ff5a72;
  }

  /* ---- chat main ---- */
  .chat-main {
    flex: 1;
    min-width: 0;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  .thread {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.5rem clamp(1rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .chat-main.empty .thread {
    display: none;
  }

  /* composer pinned at the bottom while chatting */
  .composer {
    padding: 1rem clamp(1rem, 5vw, 3rem) 1.4rem;
  }

  .empty-hero {
    display: none;
  }

  .chat-main.empty {
    justify-content: center;
  }

  .chat-main.empty .composer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  .chat-main.empty .empty-hero {
    display: block;
    text-align: center;
  }

  .empty-title {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .empty-sub {
    margin: 0.5rem 0 0;
    color: var(--accent-strong);
    font-size: 0.92rem;
  }

  /* ---- composer form ---- */
  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    border-radius: 26px;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
  }

  .chat-main.empty .chat-form {
    max-width: 640px;
  }

  .prompt {
    color: var(--accent-strong);
    font-weight: 800;
    line-height: 1;
  }

  #chat-input {
    flex: 1;
    resize: none;
    border: none;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    padding: 0.55rem 0;
    max-height: 200px;
    outline: none;
  }

  #chat-input::placeholder {
    color: var(--muted);
  }

  #chat-send {
    flex-shrink: 0;
    padding: 0.6rem 1.3rem;
    font-size: 0.95rem;
  }

  #chat-send:disabled {
    opacity: 0.45;
    cursor: default;
    transform: none;
    filter: none;
  }

  /* ---- messages ---- */
  .msg {
    max-width: min(680px, 92%);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .msg.user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .msg.osprey {
    align-self: flex-start;
  }

  .who {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 0.4rem;
  }

  .body {
    margin: 0;
    padding: 0.7rem 1rem;
    border-radius: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-wrap: break-word;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid var(--glass-border);
    box-shadow: 0 1px 2px rgba(20, 22, 26, 0.05);
  }

  .msg.user .body {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: rgba(245, 184, 0, 0.35);
  }

  .save-btn {
    align-self: flex-start;
    margin-top: 0.4rem;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--field-bg);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .save-btn:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  .save-btn.saved {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  .tick {
    font-weight: 700;
  }

  /* ---- saved view ---- */
  .saved-head {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .saved-empty {
    color: var(--muted);
  }

  .saved-item {
    max-width: min(680px, 92%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .saved-item .body {
    align-self: stretch;
    background: var(--glass-bg);
  }

  /* ---- thinking + cursor ---- */
  .thinking {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: 0.01em;
    /* site yellow with a silver/white chrome sheen passing through */
    background-image: linear-gradient(
      100deg,
      var(--accent) 0%,
      var(--accent) 28%,
      #f4f6f8 40%,
      #ffffff 50%,
      #f4f6f8 60%,
      var(--accent) 72%,
      var(--accent) 100%
    );
    background-size: 260% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: chrome-shimmer 4.2s linear infinite;
  }

  .thinking-time {
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
  }

  @keyframes chrome-shimmer {
    to {
      background-position: 200% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thinking {
      animation: none;
    }
  }

  .cursor {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--accent-strong);
    border-radius: 1px;
    animation: cursor-pulse 1s steps(1) infinite;
  }

  @keyframes cursor-pulse {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .sidebar {
      display: none;
    }
    .app {
      padding: 0.6rem;
    }
  }
</style>
