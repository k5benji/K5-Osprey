import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="app">
    <aside class="sidebar" id="sidebar">
      <button class="side-btn new-chat btn-accent" id="new-chat">+ New chat</button>
      <button class="side-btn saved-btn" id="saved-btn">Saved texts</button>

      <p class="side-label">Chats</p>
      <div class="chat-list" id="chat-list"></div>
    </aside>

    <main class="chat-main empty" id="chat-main">
      <div class="thread" id="thread"></div>

      <div class="composer" id="composer">
        <div class="empty-hero">
          <h1 class="empty-title" id="empty-title">Osprey</h1>
          <p class="empty-sub" id="empty-sub">Your private AI OS — guarding against breaches, malware &amp; data risk</p>
        </div>
        <form id="chat-form" class="chat-form">
          <span class="prompt" aria-hidden="true">&gt;</span>
          <textarea
            id="chat-input"
            rows="1"
            maxlength="2000"
            placeholder="Ask about your privacy, threats, or system…"
            autocomplete="off"></textarea>
          <button type="button" id="search-toggle" class="search-toggle" aria-pressed="false" aria-label="Search the web" title="Search the web">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 0c2.5 2.5 2.5 15.5 0 18m0-18c-2.5 2.5-2.5 15.5 0 18M3.5 9h17M3.5 15h17"/></svg>
          </button>
          <button type="submit" id="chat-send" class="btn-accent">Send</button>
        </form>
      </div>
    </main>
  </div>
</Layout>

<script>
  interface Msg {
    role: 'user' | 'assistant';
    content: string;
  }
  interface Chat {
    id: string;
    title: string;
    messages: Msg[];
    createdAt: number;
  }
  interface Saved {
    id: string;
    content: string;
    savedAt: number;
  }

  const CHATS_KEY = 'osprey_chats';
  const SAVED_KEY = 'osprey_saved';

  function load<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }
  function persist() {
    localStorage.setItem(CHATS_KEY, JSON.stringify(chats));
    localStorage.setItem(SAVED_KEY, JSON.stringify(saved));
  }

  let chats: Chat[] = load<Chat[]>(CHATS_KEY, []);
  let saved: Saved[] = load<Saved[]>(SAVED_KEY, []);
  let currentId: string | null = null;
  let busy = false;
  let controller: AbortController | null = null;
  let searchOn = false;

  const chatMain = document.getElementById('chat-main')!;
  const thread = document.getElementById('thread')!;
  const composer = document.getElementById('composer')!;
  const emptyTitle = document.getElementById('empty-title')!;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
  const chatList = document.getElementById('chat-list')!;

  function currentChat(): Chat | null {
    return chats.find((c) => c.id === currentId) ?? null;
  }

  // ---------- rendering ----------
  function renderSidebar() {
    chatList.textContent = '';
    for (const chat of [...chats].sort((a, b) => b.createdAt - a.createdAt)) {
      const item = document.createElement('div');
      item.className = 'chat-item' + (chat.id === currentId ? ' active' : '');

      const title = document.createElement('span');
      title.className = 'chat-item-title';
      title.textContent = chat.title || 'New chat';
      title.addEventListener('click', () => openChat(chat.id));

      const del = document.createElement('button');
      del.className = 'chat-item-del';
      del.textContent = '×';
      del.title = 'Delete chat';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteChat(chat.id);
      });

      item.append(title, del);
      chatList.appendChild(item);
    }
  }

  // ---------- markdown (escape-first, so model output can never inject HTML) ----------
  function escapeHtml(s: string): string {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string
    );
  }

  function inlineMd(text: string): string {
    let t = escapeHtml(text);
    // inline code (contents already escaped)
    t = t.replace(/`([^`]+)`/g, (_, c) => `<code>${c}</code>`);
    // bold then italic
    t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    t = t.replace(/__([^_]+)__/g, '<strong>$1</strong>');
    t = t.replace(/(^|[^*])\*(?!\s)([^*]+?)\*/g, '$1<em>$2</em>');
    t = t.replace(/(^|[^_])_(?!\s)([^_]+?)_/g, '$1<em>$2</em>');
    // links — only http(s), so no javascript: vectors
    t = t.replace(
      /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
    );
    return t.replace(/\n/g, '<br>');
  }

  function renderMarkdown(src: string): string {
    const lines = src.replace(/\r\n/g, '\n').split('\n');
    let html = '';
    let list: 'ul' | 'ol' | null = null;
    const closeList = () => {
      if (list) {
        html += `</${list}>`;
        list = null;
      }
    };
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      const fence = line.match(/^```(\w*)\s*$/);
      if (fence) {
        closeList();
        const code: string[] = [];
        i++;
        while (i < lines.length && !/^```\s*$/.test(lines[i])) code.push(lines[i++]);
        i++;
        html += `<pre class="md-pre"><button class="md-copy" type="button">Copy</button><code>${escapeHtml(code.join('\n'))}</code></pre>`;
        continue;
      }
      const h = line.match(/^(#{1,6})\s+(.*)$/);
      if (h) {
        closeList();
        const lvl = h[1].length;
        html += `<h${lvl}>${inlineMd(h[2])}</h${lvl}>`;
        i++;
        continue;
      }
      if (/^\s*(---|\*\*\*|___)\s*$/.test(line)) {
        closeList();
        html += '<hr>';
        i++;
        continue;
      }
      if (/^>\s?/.test(line)) {
        closeList();
        const quote: string[] = [];
        while (i < lines.length && /^>\s?/.test(lines[i])) quote.push(lines[i++].replace(/^>\s?/, ''));
        html += `<blockquote>${renderMarkdown(quote.join('\n'))}</blockquote>`;
        continue;
      }
      const ul = line.match(/^\s*[-*+]\s+(.*)$/);
      if (ul) {
        if (list !== 'ul') {
          closeList();
          html += '<ul>';
          list = 'ul';
        }
        html += `<li>${inlineMd(ul[1])}</li>`;
        i++;
        continue;
      }
      const ol = line.match(/^\s*\d+\.\s+(.*)$/);
      if (ol) {
        if (list !== 'ol') {
          closeList();
          html += '<ol>';
          list = 'ol';
        }
        html += `<li>${inlineMd(ol[1])}</li>`;
        i++;
        continue;
      }
      if (/^\s*$/.test(line)) {
        closeList();
        i++;
        continue;
      }
      closeList();
      const para: string[] = [line];
      i++;
      while (
        i < lines.length &&
        !/^\s*$/.test(lines[i]) &&
        !/^(#{1,6}\s|```|>\s?|\s*[-*+]\s|\s*\d+\.\s)/.test(lines[i]) &&
        !/^\s*(---|\*\*\*|___)\s*$/.test(lines[i])
      ) {
        para.push(lines[i++]);
      }
      html += `<p>${inlineMd(para.join('\n'))}</p>`;
    }
    closeList();
    return html;
  }

  // Render assistant text as markdown; keep the raw source on a data attr for save.
  function setAnswer(el: HTMLElement, md: string) {
    el.dataset.md = md;
    el.innerHTML = renderMarkdown(md);
  }

  function messageEl(
    role: 'user' | 'assistant',
    text: string,
    withSave = true,
    sources: any[] | null = null
  ): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = `msg ${role === 'user' ? 'user' : 'osprey'}`;

    const who = document.createElement('p');
    who.className = 'who';
    who.textContent = role === 'user' ? 'You' : 'Osprey';

    const body = document.createElement('div');
    body.className = 'body';

    const textEl = document.createElement('div');
    textEl.className = 'body-text';
    if (role === 'assistant') setAnswer(textEl, text);
    else textEl.textContent = text;
    body.appendChild(textEl);

    wrap.append(who, body);

    if (role === 'assistant' && sources && sources.length) renderSources(wrap, sources);
    if (role === 'assistant' && withSave) attachSave(wrap, textEl);

    return wrap;
  }

  // Sources — the web sources used for an answer, shown below the bubble.
  function renderSources(wrap: HTMLElement, sources: any[]) {
    if (wrap.querySelector(':scope > .sources')) return;
    const box = document.createElement('div');
    box.className = 'sources';
    const head = document.createElement('div');
    head.className = 'sources-head';
    head.textContent = `Sources · ${sources.length} source${sources.length > 1 ? 's' : ''}`;
    const list = document.createElement('ol');
    list.className = 'sources-list';
    for (const s of sources) {
      let host = s.url;
      try {
        host = new URL(s.url).hostname.replace(/^www\./, '');
      } catch {}
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = s.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = s.title || host;
      const dom = document.createElement('span');
      dom.className = 'sources-domain';
      dom.textContent = host;
      li.append(a, dom);
      list.appendChild(li);
    }
    box.append(head, list);
    const actions = wrap.querySelector(':scope > .msg-actions');
    if (actions) wrap.insertBefore(box, actions);
    else wrap.appendChild(box);
  }

  // Actions (Save, Regenerate) sit in a row below the bubble, outside .body.
  function actionsRow(wrap: HTMLElement): HTMLElement {
    let row = wrap.querySelector(':scope > .msg-actions') as HTMLElement | null;
    if (!row) {
      row = document.createElement('div');
      row.className = 'msg-actions';
      wrap.appendChild(row);
    }
    return row;
  }

  function attachSave(wrap: HTMLElement, textEl: HTMLElement) {
    const row = actionsRow(wrap);
    if (row.querySelector('.save-btn:not(.regen-btn)')) return;
    const raw = () => textEl.dataset.md ?? textEl.textContent ?? '';
    const save = document.createElement('button');
    save.className = 'save-btn';
    const existing = saved.find((s) => s.content === raw());
    if (existing) markSaved(save, existing.id);
    else markUnsaved(save);
    save.addEventListener('click', () => toggleSave(save, raw()));
    row.appendChild(save);
  }

  function markSaved(btn: HTMLElement, id: string) {
    btn.dataset.savedId = id;
    btn.classList.add('saved');
    btn.innerHTML = 'Saved <span class="tick">✓</span>';
  }

  function markUnsaved(btn: HTMLElement) {
    delete btn.dataset.savedId;
    btn.classList.remove('saved');
    btn.textContent = 'Save text';
  }

  function toggleSave(btn: HTMLElement, content: string) {
    if (!content.trim()) return;
    if (btn.dataset.savedId) {
      const id = btn.dataset.savedId;
      saved = saved.filter((s) => s.id !== id);
      persist();
      markUnsaved(btn);
    } else {
      const id = crypto.randomUUID();
      saved.unshift({ id, content, savedAt: Date.now() });
      persist();
      markSaved(btn, id);
    }
  }

  // Chrome-yellow "Thinking" indicator with a live elapsed timer.
  function thinkingEl(startedAt: number): { el: HTMLElement; stop: () => void } {
    const el = document.createElement('span');
    el.className = 'thinking';
    const label = document.createElement('span');
    label.className = 'thinking-label';
    label.textContent = 'Thinking';
    const time = document.createElement('span');
    time.className = 'thinking-time';
    el.append(label, time);
    const tick = () => {
      time.textContent = ((Date.now() - startedAt) / 1000).toFixed(1) + 's';
    };
    tick();
    const timer = setInterval(tick, 100);
    return { el, stop: () => clearInterval(timer) };
  }

  function renderThread() {
    thread.textContent = '';
    const chat = currentChat();
    if (!chat) return;
    for (const m of chat.messages) {
      thread.appendChild(messageEl(m.role, m.content, true, (m as any).sources ?? null));
    }
    refreshRegenerate();
    thread.scrollTop = thread.scrollHeight;
  }

  function showEmpty() {
    chatMain.classList.add('empty');
    chatMain.classList.remove('viewing-saved');
    thread.textContent = '';
  }
  function showThread() {
    chatMain.classList.remove('empty', 'viewing-saved');
  }

  // ---------- actions ----------
  function newChat() {
    currentId = null;
    showEmpty();
    renderSidebar();
    input.value = '';
    autoGrow();
    input.focus();
  }

  function openChat(id: string) {
    currentId = id;
    showThread();
    renderThread();
    renderSidebar();
    input.focus();
  }

  function deleteChat(id: string) {
    chats = chats.filter((c) => c.id !== id);
    persist();
    if (currentId === id) newChat();
    else renderSidebar();
  }

  function openSaved() {
    currentId = null;
    chatMain.classList.remove('empty');
    chatMain.classList.add('viewing-saved');
    renderSidebar();
    thread.textContent = '';

    const head = document.createElement('p');
    head.className = 'saved-head';
    head.textContent = 'Saved Texts';
    thread.appendChild(head);

    if (saved.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'saved-empty';
      empty.textContent = 'Nothing saved yet. Save an answer to keep it here.';
      thread.appendChild(empty);
      return;
    }

    for (const item of saved) {
      const wrap = document.createElement('div');
      wrap.className = 'saved-item';

      const body = document.createElement('div');
      body.className = 'body';

      const textEl = document.createElement('div');
      textEl.className = 'body-text';
      setAnswer(textEl, item.content);
      body.appendChild(textEl);

      const remove = document.createElement('button');
      remove.className = 'save-btn';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => {
        saved = saved.filter((s) => s.id !== item.id);
        persist();
        openSaved();
      });

      // remove sits below the bubble, matching the "Save text" control
      wrap.append(body, remove);
      thread.appendChild(wrap);
    }
    thread.scrollTop = 0;
  }

  async function generateTitle(chat: Chat, seed: string) {
    try {
      const res = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ titleFor: seed }),
      });
      const data = await res.json();
      if (data.title) {
        chat.title = data.title;
        persist();
        renderSidebar();
      }
    } catch {
      /* keep fallback title */
    }
  }

  // ---------- input ----------
  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 200)}px`;
  }
  input.addEventListener('input', autoGrow);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  // While generating, Send becomes a Stop button that aborts the stream.
  function setSendMode(generating: boolean) {
    sendBtn.textContent = generating ? 'Stop' : 'Send';
    sendBtn.classList.toggle('stop', generating);
  }

  sendBtn.addEventListener('click', (e) => {
    if (busy) {
      e.preventDefault();
      controller?.abort();
    }
  });

  // Stream one assistant reply for the current state of `chat`. Shared by the
  // composer and by Regenerate.
  async function runReply(chat: Chat, isFirst: boolean, seed: string) {
    busy = true;
    controller = new AbortController();
    setSendMode(true);
    refreshRegenerate();

    // Always show the thinking indicator for a beat before the answer appears,
    // so a fast model still reads as deliberate rather than blurting an answer.
    const thinkStart = Date.now();
    const MIN_THINK = 1200 + Math.floor(Math.random() * 600); // 1.2–1.8s
    const wait = (ms: number) => new Promise((r) => setTimeout(r, Math.max(0, ms)));
    let revealTimer: ReturnType<typeof setTimeout> | undefined;

    // chrome-yellow "Thinking 0.0s" indicator until the answer is revealed
    const pending = messageEl('assistant', '', false);
    const pendingBody = pending.querySelector('.body-text') as HTMLElement;
    const think = thinkingEl(thinkStart);
    pendingBody.appendChild(think.el);
    thread.appendChild(pending);
    thread.scrollTop = thread.scrollHeight;

    // trailing pulsing cursor shown while Osprey writes
    const cursor = document.createElement('span');
    cursor.className = 'cursor';

    let answer = '';
    let sources: any[] | null = null;
    // Commit whatever has been produced — used on normal completion and on Stop.
    const finalizeAnswer = (aborted = false) => {
      think.stop();
      cursor.remove();
      const text = answer.trim();
      if (text) {
        setAnswer(pendingBody, text);
        if (sources && sources.length) renderSources(pending, sources);
        attachSave(pending, pendingBody);
        chat.messages.push({ role: 'assistant', content: text, ...(sources ? { sources } : {}) } as any);
        persist();
        if (isFirst) generateTitle(chat, seed);
      } else {
        pendingBody.textContent = aborted ? 'Stopped.' : 'Connection dropped. Try again.';
      }
    };

    try {
      const res = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: chat.messages, search: searchOn }),
        signal: controller.signal,
      });

      if (!res.ok || !res.body) {
        let msg = 'Connection dropped. Try again.';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
        } catch {
          /* ignore */
        }
        think.stop();
        pendingBody.textContent = msg;
        return;
      }

      // stream tokens
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let started = false;

      // Park the blinking cursor at the end of the last rendered block.
      const placeCursor = () => {
        (pendingBody.lastElementChild ?? pendingBody).appendChild(cursor);
      };
      const paint = () => {
        setAnswer(pendingBody, answer);
        placeCursor();
        const nearBottom =
          thread.scrollHeight - thread.scrollTop - thread.clientHeight < 80;
        if (nearBottom) thread.scrollTop = thread.scrollHeight;
      };

      // Swap the thinking indicator for the answer. Held back until the minimum
      // think time has passed, so tokens buffer behind the indicator first.
      const reveal = () => {
        if (started) return;
        started = true;
        think.stop();
        paint();
        thread.scrollTop = thread.scrollHeight;
      };
      const pushToken = (token: string) => {
        answer += token;
        if (!started) {
          const elapsed = Date.now() - thinkStart;
          // Keep showing "Thinking" until BOTH the minimum window has passed
          // AND the first token has arrived — whichever is later.
          if (elapsed < MIN_THINK) {
            if (revealTimer === undefined) revealTimer = setTimeout(reveal, MIN_THINK - elapsed);
            return;
          }
          reveal();
          return;
        }
        paint();
      };

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() ?? '';
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed.startsWith('data:')) continue;
          const payload = trimmed.slice(5).trim();
          if (!payload || payload === '[DONE]') continue;
          try {
            const obj = JSON.parse(payload);
            if (obj.sources) sources = obj.sources;
            if (obj.response) pushToken(obj.response);
          } catch {
            /* skip malformed chunk */
          }
        }
      }

      // If the whole answer arrived faster than the think window, keep the dots
      // up until it elapses, then reveal — so thinking is always visible.
      clearTimeout(revealTimer);
      await wait(MIN_THINK - (Date.now() - thinkStart));
      reveal();
      finalizeAnswer();
    } catch (err) {
      clearTimeout(revealTimer);
      if (err && (err as Error).name === 'AbortError') {
        // user pressed Stop — keep whatever was streamed so far
        finalizeAnswer(true);
      } else {
        think.stop();
        cursor.remove();
        pendingBody.textContent = 'Connection dropped. Try again.';
      }
    } finally {
      clearTimeout(revealTimer);
      think.stop();
      controller = null;
      busy = false;
      setSendMode(false);
      refreshRegenerate();
      thread.scrollTop = thread.scrollHeight;
      input.focus();
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    const question = input.value.trim();
    if (!question) return;

    // start a new chat if needed
    let chat = currentChat();
    const isFirst = !chat;
    if (!chat) {
      chat = {
        id: crypto.randomUUID(),
        title: question.slice(0, 40),
        messages: [],
        createdAt: Date.now(),
      };
      chats.push(chat);
      currentId = chat.id;
    }

    showThread();
    chat.messages.push({ role: 'user', content: question });
    thread.appendChild(messageEl('user', question));

    input.value = '';
    autoGrow();
    persist();
    renderSidebar();
    await runReply(chat, isFirst, question);
  });

  // Drop the last assistant reply and ask again from the same point.
  function regenerate() {
    if (busy) return;
    const chat = currentChat();
    if (!chat || chat.messages.length === 0) return;
    if (chat.messages[chat.messages.length - 1].role === 'assistant') chat.messages.pop();
    if (chat.messages.length === 0) return;
    const seed = chat.messages.find((m) => m.role === 'user')?.content ?? '';
    persist();
    renderThread();
    runReply(chat, false, seed);
  }

  // Keep a single Regenerate control on the latest finished assistant message.
  function refreshRegenerate() {
    thread.querySelectorAll('.regen-btn').forEach((b) => b.remove());
    if (busy) return;
    const msgs = thread.querySelectorAll('.msg.osprey');
    const last = msgs[msgs.length - 1] as HTMLElement | undefined;
    if (!last || !last.querySelector('.save-btn')) return;
    const regen = document.createElement('button');
    regen.className = 'save-btn regen-btn';
    regen.textContent = 'Regenerate';
    regen.addEventListener('click', regenerate);
    (last.querySelector(':scope > .msg-actions') ?? last).appendChild(regen);
  }

  document.getElementById('new-chat')!.addEventListener('click', newChat);
  document.getElementById('saved-btn')!.addEventListener('click', openSaved);

  // web-search toggle (sticky until turned off)
  const searchToggle = document.getElementById('search-toggle')!;
  searchToggle.addEventListener('click', () => {
    searchOn = !searchOn;
    searchToggle.classList.toggle('active', searchOn);
    searchToggle.setAttribute('aria-pressed', String(searchOn));
  });

  // copy buttons on code blocks (event-delegated)
  thread.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.md-copy') as HTMLElement | null;
    if (!btn) return;
    const code = btn.parentElement?.querySelector('code');
    if (!code) return;
    navigator.clipboard?.writeText(code.textContent ?? '');
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = 'Copy'), 1500);
  });

  // ---------- init ----------
  renderSidebar();
  showEmpty();
  input.focus();
</script>

