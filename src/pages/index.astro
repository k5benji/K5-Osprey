---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
    <header>
      <h1>Osprey Thread Kastle Five. Built by Benjamin Weberink.</h1>
    </header>
    <div class="description">
      <p>An ongoing body of written work. In partnership with Red Bull.</p>
      <p>Engineer of Kastle Five.</p>
    </div>

    <p class="rss-link">
      <a href="/rss.xml" class="muted-link">RSS Feed</a>
    </p>
    <p>
      <a href="/blog/" class="muted-link">View Archive</a>
    </p>
    <p>
      <a href="/kastlefive/" class="muted-link">Architecture of Kastle Five</a>
    </p>
    <div class="build-info">
      <p class="build-number">
        Site Status:
        <span>
          Active
          <span class="status-dot" aria-hidden="true"></span>
        </span>
      </p>
      <p class="build-number">Osprey Kastle Five Build 0.8.1</p>
      <p class="build-number">Published: Jan 5, 2026</p>
      <p class="build-number">Updated: Jun 9, 2026</p>
    </div>
  </main>
</Layout>

<style>
  .rss-link {
    margin-top: 3rem;
    font-size: 1rem;
  }

  .rss-link a {
    color: #888;
    text-decoration: none;
  }

  .rss-link a:hover {
    color: #666;
  }

  a.muted-link,
  a.muted-link:visited {
    color: #888;
    text-decoration: none;
  }

  a.muted-link:hover,
  a.muted-link:visited:hover {
    color: #ffce1c;
    text-decoration: none;
  }

  .description p {
    margin: 0;
  }

  .build-info {
    margin-top: 3rem;
  }

  .build-number {
    margin: 0;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 4px;
    border-radius: 50%;
    background-color: #facc15;
    animation: status-blink 2s ease-in-out infinite;
    vertical-align: middle;
  }

  @keyframes status-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
</style>
