---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="app">
    <aside class="sidebar glass" id="sidebar">
      <button class="side-btn new-chat btn-accent" id="new-chat">+ New chat</button>
      <button class="side-btn saved-btn" id="saved-btn">Saved texts</button>

      <p class="side-label">Chats</p>
      <div class="chat-list" id="chat-list"></div>
    </aside>

    <main class="chat-main empty glass" id="chat-main">
      <div class="thread" id="thread"></div>

      <div class="composer" id="composer">
        <div class="empty-hero">
          <h1 class="empty-title" id="empty-title">Chat with Osprey</h1>
          <p class="empty-sub" id="empty-sub">Powered by Kastle Five Systems</p>
        </div>
        <form id="chat-form" class="chat-form glass">
          <span class="prompt" aria-hidden="true">&gt;</span>
          <textarea
            id="chat-input"
            rows="1"
            maxlength="2000"
            placeholder="Ask Osprey something."
            autocomplete="off"></textarea>
          <button type="submit" id="chat-send" class="btn-accent">Send</button>
        </form>
      </div>
    </main>
  </div>
</Layout>

<script>
  interface Msg {
    role: 'user' | 'assistant';
    content: string;
  }
  interface Chat {
    id: string;
    title: string;
    messages: Msg[];
    createdAt: number;
  }
  interface Saved {
    id: string;
    content: string;
    savedAt: number;
  }

  const CHATS_KEY = 'osprey_chats';
  const SAVED_KEY = 'osprey_saved';

  function load<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }
  function persist() {
    localStorage.setItem(CHATS_KEY, JSON.stringify(chats));
    localStorage.setItem(SAVED_KEY, JSON.stringify(saved));
  }

  let chats: Chat[] = load<Chat[]>(CHATS_KEY, []);
  let saved: Saved[] = load<Saved[]>(SAVED_KEY, []);
  let currentId: string | null = null;
  let busy = false;

  const chatMain = document.getElementById('chat-main')!;
  const thread = document.getElementById('thread')!;
  const composer = document.getElementById('composer')!;
  const emptyTitle = document.getElementById('empty-title')!;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
  const chatList = document.getElementById('chat-list')!;

  function currentChat(): Chat | null {
    return chats.find((c) => c.id === currentId) ?? null;
  }

  // ---------- rendering ----------
  function renderSidebar() {
    chatList.textContent = '';
    for (const chat of [...chats].sort((a, b) => b.createdAt - a.createdAt)) {
      const item = document.createElement('div');
      item.className = 'chat-item' + (chat.id === currentId ? ' active' : '');

      const title = document.createElement('span');
      title.className = 'chat-item-title';
      title.textContent = chat.title || 'New chat';
      title.addEventListener('click', () => openChat(chat.id));

      const del = document.createElement('button');
      del.className = 'chat-item-del';
      del.textContent = '×';
      del.title = 'Delete chat';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteChat(chat.id);
      });

      item.append(title, del);
      chatList.appendChild(item);
    }
  }

  function messageEl(role: 'user' | 'assistant', text: string, withSave = true): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = `msg ${role === 'user' ? 'user' : 'osprey'}`;

    const who = document.createElement('p');
    who.className = 'who';
    who.textContent = role === 'user' ? 'You' : 'Osprey';

    const body = document.createElement('p');
    body.className = 'body';

    const textEl = document.createElement('span');
    textEl.className = 'body-text';
    textEl.textContent = text;
    body.appendChild(textEl);

    if (role === 'assistant' && withSave) attachSave(body, textEl);

    wrap.append(who, body);
    return wrap;
  }

  function attachSave(body: HTMLElement, textEl: HTMLElement) {
    const save = document.createElement('button');
    save.className = 'save-btn';
    const existing = saved.find((s) => s.content === (textEl.textContent ?? ''));
    if (existing) markSaved(save, existing.id);
    else markUnsaved(save);
    save.addEventListener('click', () => toggleSave(save, textEl.textContent ?? ''));
    body.appendChild(save);
  }

  function markSaved(btn: HTMLElement, id: string) {
    btn.dataset.savedId = id;
    btn.classList.add('saved');
    btn.innerHTML = 'Saved <span class="tick">✓</span>';
  }

  function markUnsaved(btn: HTMLElement) {
    delete btn.dataset.savedId;
    btn.classList.remove('saved');
    btn.textContent = 'Save text';
  }

  function toggleSave(btn: HTMLElement, content: string) {
    if (!content.trim()) return;
    if (btn.dataset.savedId) {
      const id = btn.dataset.savedId;
      saved = saved.filter((s) => s.id !== id);
      persist();
      markUnsaved(btn);
    } else {
      const id = crypto.randomUUID();
      saved.unshift({ id, content, savedAt: Date.now() });
      persist();
      markSaved(btn, id);
    }
  }

  function thinkingEl(): HTMLElement {
    const wrap = document.createElement('span');
    wrap.className = 'thinking';
    for (let i = 0; i < 3; i++) {
      const dot = document.createElement('span');
      dot.className = 'dot';
      wrap.appendChild(dot);
    }
    return wrap;
  }

  function renderThread() {
    thread.textContent = '';
    const chat = currentChat();
    if (!chat) return;
    for (const m of chat.messages) {
      thread.appendChild(messageEl(m.role, m.content));
    }
    thread.scrollTop = thread.scrollHeight;
  }

  function showEmpty() {
    chatMain.classList.add('empty');
    chatMain.classList.remove('viewing-saved');
    thread.textContent = '';
  }
  function showThread() {
    chatMain.classList.remove('empty', 'viewing-saved');
  }

  // ---------- actions ----------
  function newChat() {
    currentId = null;
    showEmpty();
    renderSidebar();
    input.value = '';
    autoGrow();
    input.focus();
  }

  function openChat(id: string) {
    currentId = id;
    showThread();
    renderThread();
    renderSidebar();
    input.focus();
  }

  function deleteChat(id: string) {
    chats = chats.filter((c) => c.id !== id);
    persist();
    if (currentId === id) newChat();
    else renderSidebar();
  }

  function openSaved() {
    currentId = null;
    chatMain.classList.remove('empty');
    chatMain.classList.add('viewing-saved');
    renderSidebar();
    thread.textContent = '';

    const head = document.createElement('p');
    head.className = 'saved-head';
    head.textContent = 'Saved Texts';
    thread.appendChild(head);

    if (saved.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'saved-empty';
      empty.textContent = 'Nothing saved yet. Press save text after receiving an Osprey answer.';
      thread.appendChild(empty);
      return;
    }

    for (const item of saved) {
      const wrap = document.createElement('div');
      wrap.className = 'saved-item';

      const body = document.createElement('p');
      body.className = 'body';

      const textEl = document.createElement('span');
      textEl.className = 'body-text';
      textEl.textContent = item.content;
      body.appendChild(textEl);

      const remove = document.createElement('button');
      remove.className = 'save-btn';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => {
        saved = saved.filter((s) => s.id !== item.id);
        persist();
        openSaved();
      });
      body.appendChild(remove);

      wrap.appendChild(body);
      thread.appendChild(wrap);
    }
    thread.scrollTop = 0;
  }

  async function generateTitle(chat: Chat, seed: string) {
    try {
      const res = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ titleFor: seed }),
      });
      const data = await res.json();
      if (data.title) {
        chat.title = data.title;
        persist();
        renderSidebar();
      }
    } catch {
      /* keep fallback title */
    }
  }

  // ---------- input ----------
  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 200)}px`;
  }
  input.addEventListener('input', autoGrow);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    const question = input.value.trim();
    if (!question) return;

    // start a new chat if needed
    let chat = currentChat();
    const isFirst = !chat;
    if (!chat) {
      chat = {
        id: crypto.randomUUID(),
        title: question.slice(0, 40),
        messages: [],
        createdAt: Date.now(),
      };
      chats.push(chat);
      currentId = chat.id;
    }

    showThread();
    chat.messages.push({ role: 'user', content: question });
    thread.appendChild(messageEl('user', question));

    input.value = '';
    autoGrow();
    busy = true;
    sendBtn.disabled = true;
    persist();
    renderSidebar();

    // animated thinking indicator while the answer loads, no save button yet
    const pending = messageEl('assistant', '', false);
    const pendingBody = pending.querySelector('.body-text') as HTMLElement;
    const pendingP = pending.querySelector('.body') as HTMLElement;
    pendingBody.appendChild(thinkingEl());
    thread.appendChild(pending);
    thread.scrollTop = thread.scrollHeight;

    // trailing pulsing cursor shown while Osprey writes
    const cursor = document.createElement('span');
    cursor.className = 'cursor';

    try {
      const res = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: chat.messages }),
      });

      if (!res.ok || !res.body) {
        let msg = 'Osprey is silent. Try again.';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
        } catch {
          /* ignore */
        }
        pendingBody.textContent = msg;
        return;
      }

      // stream tokens
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let answer = '';
      let started = false;

      const pushToken = (token: string) => {
        if (!started) {
          started = true;
          pendingBody.textContent = '';
          pendingP.appendChild(cursor);
        }
        answer += token;
        pendingBody.textContent = answer;
        const nearBottom =
          thread.scrollHeight - thread.scrollTop - thread.clientHeight < 80;
        if (nearBottom) thread.scrollTop = thread.scrollHeight;
      };

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() ?? '';
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed.startsWith('data:')) continue;
          const payload = trimmed.slice(5).trim();
          if (!payload || payload === '[DONE]') continue;
          try {
            const obj = JSON.parse(payload);
            if (obj.response) pushToken(obj.response);
          } catch {
            /* skip malformed chunk */
          }
        }
      }

      cursor.remove();
      answer = answer.trim();

      if (answer) {
        pendingBody.textContent = answer;
        attachSave(pendingP, pendingBody);
        chat.messages.push({ role: 'assistant', content: answer });
        persist();
        if (isFirst) generateTitle(chat, question);
      } else {
        pendingBody.textContent = 'Osprey is silent. Try again.';
      }
    } catch {
      cursor.remove();
      pendingBody.textContent = 'Osprey is silent. Try again.';
    } finally {
      busy = false;
      sendBtn.disabled = false;
      thread.scrollTop = thread.scrollHeight;
      input.focus();
    }
  });

  document.getElementById('new-chat')!.addEventListener('click', newChat);
  document.getElementById('saved-btn')!.addEventListener('click', openSaved);

  // ---------- init ----------
  renderSidebar();
  showEmpty();
  input.focus();
</script>

<style is:global>
  .app {
    flex: 1;
    min-height: 0;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
  }

  /* ---- sidebar ---- */
  .sidebar {
    width: 250px;
    flex-shrink: 0;
    border-radius: var(--radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
  }

  .side-btn {
    text-align: center;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    background: var(--field-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .side-btn.btn-accent {
    border: none;
    box-shadow: none;
  }

  .side-btn.btn-accent:hover {
    transform: translateY(-1px);
    box-shadow: none;
    filter: brightness(1.05);
  }

  .side-btn.btn-accent:active {
    transform: translateY(0);
    filter: brightness(0.97);
  }

  .saved-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .side-label {
    margin: 1rem 0 0.25rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .chat-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .chat-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .chat-item:hover {
    background: var(--field-bg);
  }

  .chat-item.active {
    background: var(--glass-bg);
    box-shadow: inset 0 0 0 1px var(--glass-border);
  }

  .chat-item-title {
    flex: 1;
    font-size: 0.88rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-item-del {
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .chat-item:hover .chat-item-del {
    opacity: 1;
  }

  .chat-item-del:hover {
    color: #ff5a72;
  }

  /* ---- chat main ---- */
  .chat-main {
    flex: 1;
    min-width: 0;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  .thread {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.5rem clamp(1rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .chat-main.empty .thread {
    display: none;
  }

  /* composer pinned at the bottom while chatting */
  .composer {
    padding: 1rem clamp(1rem, 5vw, 3rem) 1.4rem;
  }

  .empty-hero {
    display: none;
  }

  .chat-main.empty {
    justify-content: center;
  }

  .chat-main.empty .composer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  .chat-main.empty .empty-hero {
    display: block;
    text-align: center;
  }

  .empty-title {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .empty-sub {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* ---- composer form ---- */
  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    border-radius: 26px;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
  }

  .chat-main.empty .chat-form {
    max-width: 640px;
  }

  .prompt {
    color: var(--accent-strong);
    font-weight: 800;
    line-height: 1;
  }

  #chat-input {
    flex: 1;
    resize: none;
    border: none;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    padding: 0.55rem 0;
    max-height: 200px;
    outline: none;
  }

  #chat-input::placeholder {
    color: var(--muted);
  }

  #chat-send {
    flex-shrink: 0;
    padding: 0.6rem 1.3rem;
    font-size: 0.95rem;
  }

  #chat-send:disabled {
    opacity: 0.5;
    cursor: default;
  }

  /* ---- messages ---- */
  .msg {
    max-width: min(680px, 92%);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .msg.user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .msg.osprey {
    align-self: flex-start;
  }

  .who {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 0.4rem;
  }

  .body {
    margin: 0;
    padding: 0.8rem 1.05rem;
    border-radius: 18px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-wrap: break-word;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow), inset 0 1px 0 var(--glass-highlight);
  }

  .msg.user .body {
    background: linear-gradient(135deg, rgba(255, 206, 28, 0.92), rgba(245, 184, 0, 0.92));
    color: var(--accent-ink);
    border-color: rgba(245, 184, 0, 0.5);
    border-bottom-right-radius: 6px;
  }

  .msg.osprey .body {
    border-bottom-left-radius: 6px;
  }

  .save-btn {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--field-bg);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .save-btn:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  .save-btn.saved {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  .tick {
    font-weight: 700;
  }

  /* ---- saved view ---- */
  .saved-head {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    font-weight: 800;
  }

  .saved-empty {
    color: var(--muted);
  }

  .saved-item .body {
    background: var(--glass-bg);
  }

  /* ---- thinking + cursor ---- */
  .thinking {
    display: inline-flex;
    gap: 5px;
    align-items: center;
  }

  .thinking .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.3;
    animation: think 1.3s infinite ease-in-out;
  }

  .thinking .dot:nth-child(2) {
    animation-delay: 0.18s;
  }

  .thinking .dot:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes think {
    0%,
    70%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
      transform: translateY(-4px);
    }
  }

  .cursor {
    display: inline-block;
    width: 7px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--accent-strong);
    border-radius: 2px;
    animation: cursor-pulse 1s steps(1) infinite;
  }

  @keyframes cursor-pulse {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .sidebar {
      display: none;
    }
    .app {
      padding: 0.6rem;
    }
  }
</style>
