---
import Layout from '../layouts/Layout.astro';
import RadomeRadar from '../components/RadomeRadar.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto; position: relative;">
    <header>
      <h1>Osprey, engineered by Kastle Five systems.</h1>
      <p class="byline">
        <a href="https://x.com/k5binya" target="_blank" rel="noopener">Built by @k5binya</a>
      </p>
    </header>
    <p class="rss-link">
      <a href="/rss.xml" class="muted-link">RSS Feed</a>
    </p>
    <p>
      <a href="/blog/" class="muted-link">View Archive</a>
    </p>
    <p>
      <a href="/kastlefive/" class="muted-link">Architecture of Kastle Five</a>
    </p>
    <p>
      <a href="/outpost/" class="muted-link">Outpost</a>
    </p>
    <p>
      <a href="/notebook/" class="muted-link">Notebook</a>
    </p>
    <section class="oracle">
      <p class="oracle-label">Ask our AI Cardinal</p>
      <form id="oracle-form">
        <span class="oracle-prompt" aria-hidden="true">&gt;</span>
        <input
          id="oracle-input"
          type="text"
          maxlength="500"
          autocomplete="off"
          placeholder="Ask something."
        />
      </form>
      <p class="oracle-answer" id="oracle-answer" hidden></p>
    </section>

    <div class="status-row-wrap">
      <div class="build-info">
      <p class="build-number status-row">
        <span>Site Status:</span>
        <span class="status-dot" aria-hidden="true"></span>
        <span>Active</span>
      </p>
      <p class="build-number">Osprey Kastle Five Build 0.8.1</p>
      <p class="build-number">Published: Sept 5, 2025</p>
      <p class="build-number">Updated: Jun 9, 2026</p>
      </div>
      <RadomeRadar />
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('oracle-form') as HTMLFormElement | null;
  const input = document.getElementById('oracle-input') as HTMLInputElement | null;
  const answerEl = document.getElementById('oracle-answer');

  let busy = false;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy || !input || !answerEl) return;

    const question = input.value.trim();
    if (!question) return;

    busy = true;
    answerEl.textContent = '…';
    answerEl.removeAttribute('hidden');

    try {
      const response = await fetch('/api/oracle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question }),
      });
      const data = await response.json();
      answerEl.textContent = response.ok && data.answer
        ? data.answer
        : (data.error ?? 'The Oracle is silent. Try again.');
    } catch {
      answerEl.textContent = 'The Oracle is silent. Try again.';
    } finally {
      busy = false;
    }
  });
</script>

<style>
  .rss-link {
    margin-top: 3rem;
    font-size: 1rem;
  }

  .rss-link a {
    color: #888;
    text-decoration: none;
  }

  .rss-link a:hover {
    color: #666;
  }

  a.muted-link,
  a.muted-link:visited {
    color: #888;
    text-decoration: none;
    position: relative;
  }

  a.muted-link::before {
    content: '>';
    position: absolute;
    left: -0.9em;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.75em;
    color: #ffce1c;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  a.muted-link:hover,
  a.muted-link:visited:hover {
    color: #ffce1c;
    text-decoration: none;
  }

  a.muted-link:hover::before {
    opacity: 1;
  }

  header {
    /* shrink-wrap to the title so the byline's right edge
       lands on the title's last character */
    width: fit-content;
  }

  header h1 {
    margin-bottom: 0;
  }

  .byline {
    /* negative top pulls it against the title; bottom offsets the
       size reduction so everything below stays in place */
    margin: -0.45rem 0 1.33rem;
    font-size: 0.85rem;
    text-align: right;
  }

  .byline a,
  .byline a:visited {
    color: #f5f7fa;
    text-decoration: none;
  }

  .byline a:hover,
  .byline a:visited:hover {
    color: #ffce1c;
  }

  .oracle {
    margin-top: 4.6rem;
    max-width: 42rem;
  }

  .oracle-label {
    margin: 0 0 0.5rem;
    color: #888;
    font-size: 0.85rem;
  }

  #oracle-form {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .oracle-prompt {
    color: #ffce1c;
    font-weight: 700;
  }

  #oracle-input {
    flex: 1;
    font-family: inherit;
    font-size: 1rem;
    color: #f5f7fa;
    background: transparent;
    border: none;
    border-bottom: 1px solid #333;
    padding: 0.25rem 0;
  }

  #oracle-input:focus {
    outline: none;
    border-bottom-color: #ffce1c;
  }

  #oracle-input::placeholder {
    color: #555;
  }

  .oracle-answer {
    margin: 1rem 0 0;
    color: #bbb;
    white-space: pre-wrap;
  }

  .status-row-wrap {
    margin-top: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .build-number {
    margin: 0;
    color: #ffce1c;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 4px;
    border-radius: 50%;
    background: #ffce1c;
    box-shadow: 0 0 4px 1px rgba(255, 206, 28, 0.6);
    animation: status-blink 2.5s ease-in-out infinite;
    flex-shrink: 0;
    margin-right: 0;
  }

  @keyframes status-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
</style>
