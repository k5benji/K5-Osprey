---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div id="boot" aria-hidden="true">
    <div class="boot-inner">
      <pre id="boot-text"></pre>
      <span class="boot-skip">click anywhere to skip</span>
    </div>
  </div>
  <script is:inline>
    if (sessionStorage.getItem('k5-booted')) {
      var b = document.getElementById('boot');
      if (b) b.remove();
    }
  </script>

  <!-- shared chrome gradient for engineer badges -->
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8a9098"></stop>
        <stop offset="35%" stop-color="#f3f6f9"></stop>
        <stop offset="50%" stop-color="#ffffff"></stop>
        <stop offset="66%" stop-color="#b9bfc5"></stop>
        <stop offset="100%" stop-color="#5f656b"></stop>
        <animateTransform
          attributeName="gradientTransform"
          type="translate"
          values="-1 -1; 1 1; -1 -1"
          dur="3.5s"
          repeatCount="indefinite"></animateTransform>
      </linearGradient>
    </defs>
  </svg>

  <main style="padding: 2rem 2rem 0; max-width: 760px; margin: 0 auto; position: relative; height: 100vh; display: flex; flex-direction: column; box-sizing: border-box;">
    <nav class="topnav">
      <a href="/rss.xml" class="topnav-link">RSS Feed</a>
      <a href="/kastlefive/" class="topnav-link">Architecture of Kastle Five</a>
      <a href="/outpost/" class="topnav-link">Outpost</a>
    </nav>

    <header>
      <h1><span class="title-main">Osprey,</span><br /><span class="title-sub">engineered by Kastle Five systems.</span></h1>
    </header>

    <section id="composer" class="composer"></section>

    <div id="feed" class="feed">
      <div class="feed-loading" role="status" aria-label="Loading the feed">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      </div>
    </div>

    <footer class="home-footer">
      <p class="oracle-link">
        <a href="/ospreyai"><span class="oracle-prompt" aria-hidden="true">&gt;</span> Chat with Osprey AI</a>
      </p>

      <div class="status-row-wrap">
        <div class="build-info">
          <p class="current-time">Current time: <span id="local-time"></span></p>
          <p class="build-number status-row">
            <span>Site Status:</span>
            <span class="status-dot" aria-hidden="true"></span>
            <span>Active</span>
          </p>
          <p class="build-number">Osprey Kastle Five Build 0.8.1</p>
          <p class="current-time">
            <a class="built-by-link" href="https://x.com/k5binya" target="_blank" rel="noopener">Built by @k5binya</a>
          </p>
        </div>
      </div>
    </footer>
  </main>

</Layout>

<script>
  // ---------- boot sequence ----------
  const boot = document.getElementById('boot');
  const bootText = document.getElementById('boot-text');
  if (boot && bootText && !sessionStorage.getItem('k5-booted')) {
    const lines = ['KASTLE FIVE SYSTEMS', '> OSPREY ONLINE', '> RADAR ONLINE', '> SIGNAL CONNECTED'];
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      sessionStorage.setItem('k5-booted', '1');
      boot.classList.add('boot-out');
      setTimeout(() => boot.remove(), 600);
    };
    boot.addEventListener('click', finish);
    window.addEventListener('keydown', finish, { once: true });
    let li = 0;
    let ci = 0;
    const type = () => {
      if (done) return;
      if (li >= lines.length) {
        setTimeout(finish, 550);
        return;
      }
      const line = lines[li];
      if (ci <= line.length) {
        bootText.textContent =
          lines.slice(0, li).join('\n') + (li > 0 ? '\n' : '') + line.slice(0, ci);
        ci++;
        setTimeout(type, 22);
      } else {
        bootText.textContent = lines.slice(0, li + 1).join('\n');
        li++;
        ci = 0;
        setTimeout(type, 260);
      }
    };
    type();
  } else if (boot) {
    boot.remove();
  }

  // ---------- clock ----------
  const timeEl = document.getElementById('local-time');
  function tick() {
    if (!timeEl) return;
    timeEl.textContent = new Date().toLocaleTimeString(undefined, {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
  }
  tick();
  setInterval(tick, 1000);

  // ---------- live feed ----------
  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';
  const IC = {
    reply:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"/></svg>',
    repost:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>',
    like:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M16.697 5.5c-1.222 0-2.337.566-3.054 1.512l-1.643 2.16-1.643-2.16C9.64 6.066 8.525 5.5 7.303 5.5c-2.243 0-3.95 1.866-3.95 4.05 0 2.99 2.66 5.45 6.97 9.32l1.677 1.5 1.677-1.5c4.31-3.87 6.97-6.33 6.97-9.32 0-2.184-1.707-4.05-3.95-4.05z"/></svg>',
    share:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>',
  };

  const feedEl = document.getElementById('feed')!;
  const composerEl = document.getElementById('composer')!;
  let signedIn = false;
  let myUsername: string | null = null;

  const MENU_ICON =
    '<svg viewBox="0 0 24 24" class="post-icon"><circle cx="5" cy="12" r="1.8" fill="currentColor"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/><circle cx="19" cy="12" r="1.8" fill="currentColor"/></svg>';

  function postMenu(p) {
    if (!myUsername || p.author.username !== myUsername) return '';
    return `
      <div class="post-menu-wrap">
        <button class="post-menu-btn" data-act="menu" aria-label="More">${MENU_ICON}</button>
        <div class="post-menu" hidden>
          <button class="post-menu-item" data-act="edit">Edit post</button>
          <button class="post-menu-item danger" data-act="delete">Delete post</button>
        </div>
      </div>`;
  }

  function esc(s) {
    return (s ?? '').replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
    );
  }

  function badges(a) {
    let h = '';
    if (a.verified)
      h += ` <svg class="badge-svg" viewBox="0 0 22 22" aria-label="Verified User"><title>Verified User</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    if (a.engineer)
      h += `<svg class="badge-svg" viewBox="0 0 22 22" aria-label="Engineer of Kastle Five"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text></svg>`;
    return h;
  }

  function relTime(iso) {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    const s = (Date.now() - d.getTime()) / 1000;
    if (s < 60) return Math.max(1, Math.floor(s)) + 's';
    if (s < 3600) return Math.floor(s / 60) + 'm';
    if (s < 86400) return Math.floor(s / 3600) + 'h';
    const days = Math.floor(s / 86400);
    if (days < 7) return days + 'd';
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  }

  function avatarHtml(a) {
    if (a.avatar) return `<img class="post-avatar-img" src="${esc(a.avatar)}" alt="" />`;
    const initial = (a.displayName || a.username || '?').charAt(0).toUpperCase();
    return `<span class="post-avatar-img fallback">${esc(initial)}</span>`;
  }

  function fmtCount(n) {
    if (!n) return '';
    if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K';
    return String(n);
  }

  function postHtml(p) {
    const a = p.author;
    return `
      <article class="post" data-id="${esc(p.id)}">
        <a class="post-avatar" href="/u/${esc(a.username)}">${avatarHtml(a)}</a>
        <div class="post-main">
          <div class="post-head">
            <span class="post-namegroup"><a class="post-name" href="/u/${esc(a.username)}">${esc(a.displayName || a.username)}</a>${badges(a)}</span>
            <span class="post-meta">@${esc(a.username)} · ${relTime(p.createdAt)}</span>
            ${postMenu(p)}
          </div>
          <div class="post-body">${esc(p.content)}</div>
          <div class="post-actions">
            <span class="post-action" data-act="reply">${IC.reply}<span class="cnt">${fmtCount(p.commentCount)}</span></span>
            <button class="post-action act repost${p.reposted ? ' on' : ''}" data-act="repost">${IC.repost}<span class="cnt">${fmtCount(p.repostCount)}</span></button>
            <button class="post-action act like${p.liked ? ' on' : ''}" data-act="like">${IC.like}<span class="cnt">${fmtCount(p.likeCount)}</span></button>
            <span class="post-action" data-act="share">${IC.share}</span>
          </div>
        </div>
      </article>`;
  }

  function renderComposer() {
    if (signedIn) {
      composerEl.innerHTML = `
        <div class="composer-inner">
          <textarea id="post-input" maxlength="500" rows="1" placeholder="What's the signal?"></textarea>
          <button id="post-btn" class="post-btn">Post</button>
        </div>
        <span class="composer-status" id="composer-status"></span>`;
      const input = document.getElementById('post-input') as HTMLTextAreaElement;
      const btn = document.getElementById('post-btn') as HTMLButtonElement;
      const grow = () => {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 240) + 'px';
      };
      input.addEventListener('input', grow);
      btn.addEventListener('click', submitPost);
    } else {
      composerEl.innerHTML = `
        <div class="composer-inner">
          <span class="composer-prompt">What's the signal?</span>
          <a class="post-btn" href="/profile">Sign in to post</a>
        </div>`;
    }
  }

  async function submitPost() {
    const input = document.getElementById('post-input') as HTMLTextAreaElement;
    const btn = document.getElementById('post-btn') as HTMLButtonElement;
    const status = document.getElementById('composer-status');
    const content = input.value.trim();
    if (!content) return;
    btn.disabled = true;
    if (status) status.textContent = '';
    try {
      const res = await fetch('/api/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not post.');
      input.value = '';
      input.style.height = 'auto';
      const note = feedEl.querySelector('.feed-note');
      if (note) note.remove();
      feedEl.insertAdjacentHTML('afterbegin', postHtml(data.post));
    } catch (e) {
      if (status) status.textContent = e.message;
    } finally {
      btn.disabled = false;
    }
  }

  async function toggle(kind, postId, article) {
    try {
      const res = await fetch('/api/posts/' + kind, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ postId }),
      });
      const data = await res.json();
      if (res.status === 401) {
        location.href = '/profile';
        return;
      }
      if (!res.ok) return;
      const btn = article.querySelector('.act.' + kind);
      const cnt = btn.querySelector('.cnt');
      if (kind === 'like') {
        btn.classList.toggle('on', data.liked);
        cnt.textContent = fmtCount(data.likeCount);
      } else {
        btn.classList.toggle('on', data.reposted);
        cnt.textContent = fmtCount(data.repostCount);
      }
    } catch {
      /* ignore */
    }
  }

  function closeMenus(except) {
    feedEl.querySelectorAll('.post-menu').forEach((m) => {
      if (m !== except) m.setAttribute('hidden', '');
    });
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.post-menu-wrap')) closeMenus(null);
  });

  // Navigate to a post, bypassing any stale browser cache for /post/<id>.
  function openPost(id) {
    location.href = '/post/' + encodeURIComponent(id) + '?r=' + Date.now();
  }

  feedEl.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const article = target.closest('.post') as HTMLElement | null;
    if (!article) return;
    const id = article.getAttribute('data-id');

    // three-dot menu
    const menuBtn = target.closest('.post-menu-btn');
    if (menuBtn) {
      e.stopPropagation();
      const menu = article.querySelector('.post-menu');
      const isHidden = menu.hasAttribute('hidden');
      closeMenus(null);
      if (isHidden) menu.removeAttribute('hidden');
      return;
    }
    const item = target.closest('.post-menu-item');
    if (item) {
      const act = item.getAttribute('data-act');
      closeMenus(null);
      if (act === 'edit') editPost(article, id);
      else if (act === 'delete') deletePost(article, id);
      return;
    }

    const actionEl = target.closest('.post-action');
    if (actionEl) {
      const act = actionEl.getAttribute('data-act');
      if (act === 'like' || act === 'repost') {
        toggle(act, id, article);
      } else if (act === 'share') {
        navigator.clipboard?.writeText(location.origin + '/post/' + id).catch(() => {});
      } else if (act === 'reply' && id) {
        openPost(id);
      }
      return;
    }

    // editing UI inside the post should not navigate
    if (target.closest('.post-edit')) return;
    // a link inside the post (username / avatar) navigates itself
    if (target.closest('a')) return;

    // clicking anywhere else on the post opens it
    if (!id) return;
    openPost(id);
  });

  function editPost(article, id) {
    const bodyEl = article.querySelector('.post-body') as HTMLElement;
    if (!bodyEl || bodyEl.querySelector('.post-edit')) return;
    const original = bodyEl.textContent;
    bodyEl.innerHTML = '';
    bodyEl.classList.add('editing');
    const wrap = document.createElement('div');
    wrap.className = 'post-edit';
    const ta = document.createElement('textarea');
    ta.className = 'post-edit-area';
    ta.value = original;
    const row = document.createElement('div');
    row.className = 'post-edit-row';
    const cancel = document.createElement('button');
    cancel.className = 'post-edit-cancel';
    cancel.textContent = 'Cancel';
    const save = document.createElement('button');
    save.className = 'post-edit-save';
    save.textContent = 'Save';
    row.append(cancel, save);
    wrap.append(ta, row);
    bodyEl.append(wrap);
    ta.style.height = 'auto';
    ta.style.height = ta.scrollHeight + 'px';
    ta.focus();
    ta.addEventListener('input', () => {
      ta.style.height = 'auto';
      ta.style.height = ta.scrollHeight + 'px';
    });
    cancel.addEventListener('click', () => {
      bodyEl.textContent = original;
      bodyEl.classList.remove('editing');
    });
    save.addEventListener('click', async () => {
      const content = ta.value.trim();
      if (!content) return;
      save.disabled = true;
      try {
        const res = await fetch('/api/posts/edit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId: id, content }),
        });
        const data = await res.json();
        bodyEl.textContent = res.ok ? data.content : original;
      } catch {
        bodyEl.textContent = original;
      }
      bodyEl.classList.remove('editing');
    });
  }

  async function deletePost(article, id) {
    if (!confirm('Delete this post?')) return;
    try {
      const res = await fetch('/api/posts/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ postId: id }),
      });
      if (res.ok) article.remove();
    } catch {
      /* ignore */
    }
  }

  async function loadFeed() {
    try {
      const res = await fetch('/api/posts');
      const data = await res.json();
      signedIn = !!data.me;
      myUsername = data.me ? data.me.username : null;
      renderComposer();
      if (!data.posts || data.posts.length === 0) {
        feedEl.innerHTML = '';
        return;
      }
      feedEl.innerHTML = data.posts.map(postHtml).join('');
    } catch {
      feedEl.innerHTML = `<p class="feed-note">Could not load the feed.</p>`;
    }
  }

  loadFeed();
</script>

<style>
  .topnav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    min-height: 34px;
    margin-bottom: 2rem;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  header {
    flex-shrink: 0;
  }

  .topnav-link,
  .topnav-link:visited {
    color: #888;
    text-decoration: none;
  }

  .topnav-link:hover {
    color: #ffce1c;
  }

  header h1 {
    margin: 0 0 1.5rem;
    line-height: 1;
  }

  .title-main {
    color: #ffce1c;
  }

  .title-sub {
    color: #f5f7fa;
    display: inline-block;
    margin-top: 0.05em;
  }
</style>

<style is:global>
  .composer {
    flex-shrink: 0;
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid #222;
    padding-bottom: 0.75rem;
  }

  .composer-inner {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }

  #post-input {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 1.1rem;
    line-height: 1.5;
    color: #f5f7fa;
    background: transparent;
    border: none;
    resize: none;
    overflow-y: auto;
    padding: 0;
  }

  .composer-prompt {
    flex: 1;
    min-width: 0;
    font-size: 1.1rem;
    line-height: 1.5;
    color: #666;
  }

  #post-input:focus {
    outline: none;
  }

  #post-input::placeholder {
    color: #555;
  }

  .composer-status {
    display: block;
    margin-top: 0.4rem;
    color: #ff6b6b;
    font-size: 0.8rem;
  }

  .composer-status:empty {
    display: none;
  }

  .post-btn {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    color: #111;
    background: #ffce1c;
    border: 1px solid #ffce1c;
    border-radius: 999px;
    padding: 0.45rem 1.3rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .post-btn:hover {
    background: transparent;
    color: #ffce1c;
  }

  .post-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .feed {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-bottom: 2rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .feed::-webkit-scrollbar {
    display: none;
  }

  .feed-note {
    color: #888;
    font-size: 0.9rem;
  }

  /* yellow "thinking" dots, same as the Osprey AI loader */
  .feed-loading {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 2rem 0;
  }

  .feed-loading .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffce1c;
    opacity: 0.25;
    animation: think 1.3s infinite ease-in-out;
  }

  .feed-loading .dot:nth-child(2) {
    animation-delay: 0.18s;
  }

  .feed-loading .dot:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes think {
    0%,
    70%,
    100% {
      opacity: 0.2;
      transform: translateY(0);
      box-shadow: none;
    }
