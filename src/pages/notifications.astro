---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8a9098"></stop>
        <stop offset="35%" stop-color="#f3f6f9"></stop>
        <stop offset="50%" stop-color="#ffffff"></stop>
        <stop offset="66%" stop-color="#b9bfc5"></stop>
        <stop offset="100%" stop-color="#5f656b"></stop>
        <animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
      </linearGradient>
    </defs>
  </svg>

  <main>
    <h1 class="page-title">Notifications</h1>
    <div id="notif-root">
      <div class="feed-loading" role="status" aria-label="Loading notifications">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      </div>
    </div>
  </main>
</Layout>

<script>
  const root = document.getElementById('notif-root');

  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';

  const ICONS = {
    like:
      '<svg viewBox="0 0 24 24" class="notif-icon like"><path fill="currentColor" d="M16.697 5.5c-1.222 0-2.337.566-3.054 1.512l-1.643 2.16-1.643-2.16C9.64 6.066 8.525 5.5 7.303 5.5c-2.243 0-3.95 1.866-3.95 4.05 0 2.99 2.66 5.45 6.97 9.32l1.677 1.5 1.677-1.5c4.31-3.87 6.97-6.33 6.97-9.32 0-2.184-1.707-4.05-3.95-4.05z"/></svg>',
    repost:
      '<svg viewBox="0 0 24 24" class="notif-icon repost"><path fill="currentColor" d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>',
    follow:
      '<svg viewBox="0 0 24 24" class="notif-icon follow"><path fill="currentColor" d="M10 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.4 0-8 2.5-8 5.5V21h13v-1.5c0-3-3.6-5.5-5-5.5zm10-3h-2v-2h-2v2h-2v2h2v2h2v-2h2z"/></svg>',
    mention:
      '<svg viewBox="0 0 24 24" class="notif-icon mention"><path fill="currentColor" d="M12 2a10 10 0 1 0 4 19.2l-.8-1.84A8 8 0 1 1 20 12v1a1.5 1.5 0 0 1-3 0V8h-2v.7A4 4 0 1 0 16 15a3.5 3.5 0 0 0 6-2v-1A10 10 0 0 0 12 2zm0 13a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>',
    comment:
      '<svg viewBox="0 0 24 24" class="notif-icon comment"><path fill="currentColor" d="M3 4a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H8l-5 4z"/></svg>',
  };

  function esc(s) {
    return (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  }

  function avatarHtml(a) {
    if (a.avatar) return `<img class="notif-avatar" src="${esc(a.avatar)}" alt="" />`;
    const initial = (a.displayName || a.username || '?').charAt(0).toUpperCase();
    return `<span class="notif-avatar fallback">${esc(initial)}</span>`;
  }

  function badges(a) {
    let h = '';
    if (a.username === 'sia') h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>First official user</title><path fill="#ff4d8d" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8" font-weight="700" fill="#fff">#1</text></svg>`;
    else if (a.verified) h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>Verified User</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    if (a.engineer) h += `<svg class="badge-svg" viewBox="0 0 22 22"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text></svg>`;
    return h;
  }

  function relTime(iso) {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    const s = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
    if (s < 60) return s + 's';
    if (s < 3600) return Math.floor(s / 60) + 'm';
    if (s < 86400) return Math.floor(s / 3600) + 'h';
    return Math.floor(s / 86400) + 'd';
  }

  const VERB = {
    like: 'liked your post',
    repost: 'reposted your post',
    follow: 'followed you',
    mention: 'mentioned you',
    comment: 'commented on your post',
  };

  function notifHtml(n) {
    const a = n.actor;
    const href = n.type === 'follow' ? '/u/' + esc(a.username) : n.postId ? '/post/' + esc(n.postId) : '#';
    const name = `<span class="notif-name">${esc(a.displayName || a.username)}</span>${badges(a)}`;
    const snippet = n.postSnippet ? `<p class="notif-snippet">${esc(n.postSnippet)}</p>` : '';
    return `
      <a class="notif${n.read ? '' : ' unread'}" href="${href}">
        ${ICONS[n.type] || ''}
        <div class="notif-body">
          ${avatarHtml(a)}
          <div class="notif-text">
            <p class="notif-line">${name} ${VERB[n.type] || ''} <span class="notif-time">· ${relTime(n.createdAt)}</span></p>
            ${snippet}
          </div>
        </div>
      </a>`;
  }

  async function init() {
    let me = null;
    try {
      me = await (await fetch('/api/me')).json();
    } catch {
      /* ignore */
    }
    if (!me) {
      root.innerHTML = '<p class="notif-empty">Sign in to see your notifications. <a href="/profile">Go to sign in</a></p>';
      return;
    }
    try {
      const res = await fetch('/api/notifications');
      const data = await res.json();
      const list = data.notifications || [];
      root.innerHTML = list.length
        ? list.map(notifHtml).join('')
        : '<p class="notif-empty">No notifications yet.</p>';
      // mark everything read now that they have been seen
      if ((data.unreadCount || 0) > 0) fetch('/api/notifications', { method: 'POST' }).catch(() => {});
    } catch {
      root.innerHTML = '<p class="notif-empty">Could not load notifications.</p>';
    }
  }

  init();
</script>

<style>
  main {
    padding: 2rem;
    max-width: 640px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .page-title {
    margin: 0 0 1.5rem;
    font-size: 1.5rem;
  }

  .notif {
    display: flex;
    gap: 0.85rem;
    padding: 0.95rem 0.5rem;
    border-bottom: 1px solid #222;
    text-decoration: none;
    color: #f5f7fa;
    transition: background-color 0.15s ease;
  }

  .notif:hover {
    background: #0b0b0b;
  }

  .notif.unread {
    background: #0d0d07;
  }

  .notif-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .notif-icon.like {
    color: #ff6b6b;
  }

  .notif-icon.repost {
    color: #4caf50;
  }

  .notif-icon.follow,
  .notif-icon.mention,
  .notif-icon.comment {
    color: #ffce1c;
  }

  .notif-body {
    flex: 1;
    min-width: 0;
  }

  .notif-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #333;
    background: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffce1c;
    font-weight: 700;
    vertical-align: middle;
  }

  .notif-text {
    margin-top: 0.4rem;
  }

  .notif-line {
    margin: 0;
    line-height: 1.4;
  }

  .notif-name {
    font-weight: 700;
  }

  .badge-svg {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
    margin-left: 0.05em;
  }

  .notif-time {
    color: #888;
  }

  .notif-snippet {
    margin: 0.25rem 0 0;
    color: #888;
    font-size: 0.9rem;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  :global(.notif-empty) {
    color: #888;
  }

  :global(.notif-empty a) {
    color: #ffce1c;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 206, 28, 0.4);
  }

  :global(.notif-empty a:hover) {
    border-bottom-color: #ffce1c;
  }

  .back-link {
    margin-top: 2rem;
  }

  .back-link a,
  .back-link a:visited {
    color: #888;
    text-decoration: none;
  }

  .back-link a:hover {
    color: #ffce1c;
  }

  .feed-loading {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 2rem 0;
  }

  .feed-loading .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffce1c;
    opacity: 0.25;
    animation: think 1.3s infinite ease-in-out;
  }

  .feed-loading .dot:nth-child(2) {
    animation-delay: 0.18s;
  }

  .feed-loading .dot:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes think {
    0%,
    70%,
    100% {
      opacity: 0.2;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
      transform: translateY(-4px);
      box-shadow: 0 0 6px 1px rgba(255, 206, 28, 0.5);
    }
  }
</style>
