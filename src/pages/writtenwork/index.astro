---
import Layout from '../../layouts/Layout.astro';

const rawAstroFiles = import.meta.glob('./*.astro', { query: '?raw', import: 'default', eager: true });
const rawMdFiles = import.meta.glob('../../content/blog/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const blogContents = {};

for (const [filePath, raw] of Object.entries(rawAstroFiles)) {
  if (filePath.endsWith('index.astro')) continue;
  const slug = filePath.split('/').pop().replace(/\.astro$/, '');

  const importMatch = raw.match(/import\s+\w+\s+from\s+['"](.+?\.md)['"]/);
  let mdBody = '';
  if (importMatch) {
    const mdPath = importMatch[1];
    mdBody = rawMdFiles[mdPath] ?? rawMdFiles[`../../content/blog/${slug}.md`] ?? '';
  }
  if (!mdBody) {
    const candidate = Object.keys(rawMdFiles).find((key) => key.endsWith(`${slug}.md`));
    mdBody = candidate ? rawMdFiles[candidate] : '';
  }

  const body = mdBody
    .replace(/^---[\s\S]*?---/, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<[^>]+>/g, '')
    .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
    .replace(/[*_`~]/g, '')
    .trim();

  blogContents[slug] = body;
}
const blogContentsJson = JSON.stringify(blogContents);
---

<Layout>
	<main style="padding: 2rem; max-width: 760px; margin: 0 auto;">

		<input
			id="search"
			type="search"
			placeholder="Search the written work…"
			class="search-box"
		/>

		<ul style="list-style: none; padding: 0; margin: 2rem 0;">
			<li class="archive-post" data-slug="doghood" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/doghood/" class="blog-link">Doghood</a>
				<p style="margin: 0.5rem 0 0; color: #555;">December 19, 2025</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="shepherds-work" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/shepherds-work/" class="blog-link">Shepherd’s Work</a>
				<p style="margin: 0.5rem 0 0; color: #555;">January 1, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="pale-blue-november" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/pale-blue-november/" class="blog-link">Pale Blue November</a>
				<p style="margin: 0.5rem 0 0; color: #555;">January 30, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="a-little-boys-prayer" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/a-little-boys-prayer/" class="blog-link">A Little Boy's Prayer</a>
				<p style="margin: 0.5rem 0 0; color: #555;">February 5, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="be-well-tomahawk" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/be-well-tomahawk/" class="blog-link">Be Well, Tomahawk</a>
				<p style="margin: 0.5rem 0 0; color: #555;">March 17, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="war-angel" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/war-angel/" class="blog-link">War Angel</a>
				<p style="margin: 0.5rem 0 0; color: #555;">April 30, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="architecture-of-a-mechanical-body" style="margin-bottom: 1.5rem;">
				<a href="/writtenwork/architecture-of-a-mechanical-body/" class="blog-link">Architecture of a Mechanical Body</a>
				<p style="margin: 0.5rem 0 0; color: #555;">May 25, 2026</p>
				<p class="search-snippet"></p>
			</li>
		</ul>
	</main>

<style>
.blog-link {
  font-size: 1.25rem;
  font-weight: 700;
  color: #f5f7fa;
  text-decoration: none;
}

.blog-link:hover,
.blog-link:visited:hover {
  color: #ffce1c;
  text-decoration: none;
}

.search-box {
  border: none;
  background: none;
  padding: 0;
  margin: 2rem 0;
  font-family: inherit;
  font-size: inherit;
  color: #888;
  width: 100%;
}

.search-box::placeholder {
  color: #888;
}

.search-box:focus {
  outline: none;
}

.search-snippet {
  color: #999;
  font-size: 0.9rem;
  margin-top: 0.35rem;
  max-width: 40rem;
}
</style>

<script type="application/json" id="blog-contents">
  {blogContentsJson}
</script>

<script>
  const contents = JSON.parse(
    document.getElementById("blog-contents")?.textContent || "{}"
  );
  const searchInput = document.getElementById("search");
  const archivePosts = document.querySelectorAll(".archive-post");

  function escapeHtml(s) {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]
    );
  }

  function snippetFor(text, query) {
    const idx = text.toLowerCase().indexOf(query);
    if (idx < 0) return "";
    const start = Math.max(0, idx - 50);
    const end = Math.min(text.length, idx + query.length + 80);
    const before = (start > 0 ? "… " : "") + text.slice(start, idx);
    const match = text.slice(idx, idx + query.length);
    const after = text.slice(idx + query.length, end) + (end < text.length ? " …" : "");
    return (
      escapeHtml(before) +
      '<mark style="background:transparent;color:#ffce1c;font-weight:700;">' +
      escapeHtml(match) +
      "</mark>" +
      escapeHtml(after)
    );
  }

  searchInput?.addEventListener("input", function () {
    const query = this.value.toLowerCase().trim();

    archivePosts.forEach((post) => {
      const slug = post.dataset.slug;
      const body = contents[slug] || "";
      const title = post.querySelector(".blog-link")?.textContent || "";
      const snippetEl = post.querySelector(".search-snippet");

      if (!query) {
        post.style.display = "";
        if (snippetEl) snippetEl.innerHTML = "";
        return;
      }

      const inBody = body.toLowerCase().includes(query);
      const inTitle = title.toLowerCase().includes(query);

      if (inBody || inTitle) {
        post.style.display = "";
        if (snippetEl) snippetEl.innerHTML = inBody ? snippetFor(body, query) : "";
      } else {
        post.style.display = "none";
        if (snippetEl) snippetEl.innerHTML = "";
      }
    });
  });
</script>
</Layout>
