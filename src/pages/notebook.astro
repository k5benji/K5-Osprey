---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

interface Entry {
  id: number;
  name: string;
  comment: string;
  created_at: string;
}

let entries: Entry[] = [];
let dbError = false;

try {
  const db = (Astro.locals as any).runtime.env.DB;
  const result = await db
    .prepare('SELECT id, name, comment, created_at FROM entries ORDER BY created_at DESC')
    .all();
  entries = result.results ?? [];
} catch {
  dbError = true;
}
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
    <h1>Notebook</h1>
    <p>Leave a comment here.</p>

    <form method="POST" action="/api/notebook" style="display:flex;flex-direction:column;gap:1rem;margin-bottom:2rem;">
      <label style="display:flex;flex-direction:column;gap:0.25rem;">
        Name
        <input name="name" required style="padding:0.5rem;" />
      </label>
      <label style="display:flex;flex-direction:column;gap:0.25rem;">
        Comment
        <textarea name="comment" required rows="4" style="padding:0.5rem;"></textarea>
      </label>
      <button type="submit" style="width:fit-content;padding:0.5rem 1rem;">Submit</button>
    </form>

    {dbError && <p style="color:red;">Could not load entries.</p>}

    {entries.length > 0 && (
      <section>
        <h2>Entries</h2>
        {entries.map((entry) => (
          <div style="border-top:1px solid #ccc;padding:1rem 0;">
            <strong>{entry.name}</strong>
            <span style="font-size:0.8em;color:#888;margin-left:0.5rem;">{entry.created_at}</span>
            <p style="margin:0.5rem 0 0;">{entry.comment}</p>
          </div>
        ))}
      </section>
    )}
  </main>
</Layout>
