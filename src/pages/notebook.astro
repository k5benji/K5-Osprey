---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
    <header>
      <h1>Notebook</h1>
    </header>
    <p class="intro">Leave a comment.</p>

    <form id="notebook-form">
      <input
        id="notebook-name"
        name="name"
        type="text"
        placeholder="Name"
        maxlength="60"
        required
      />
      <textarea
        id="notebook-comment"
        name="comment"
        placeholder="Comment"
        rows="3"
        maxlength="1000"
        required></textarea>
      <button type="submit" id="notebook-submit">Submit</button>
      <p class="form-status" id="notebook-status" hidden></p>
    </form>

    <div class="entries" id="notebook-entries">
      <p class="loading" id="notebook-loading">Loading entries…</p>
    </div>
  </main>
</Layout>

<script>
  interface NotebookEntry {
    id: number;
    name: string;
    comment: string;
    reply: string | null;
    created_at: string;
  }

  const form = document.getElementById('notebook-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('notebook-name') as HTMLInputElement | null;
  const commentInput = document.getElementById('notebook-comment') as HTMLTextAreaElement | null;
  const submitButton = document.getElementById('notebook-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('notebook-status');
  const entriesEl = document.getElementById('notebook-entries');

  function formatDate(value: string): string {
    const date = new Date(value.includes('T') ? value : value.replace(' ', 'T') + 'Z');
    if (isNaN(date.getTime())) return value;
    return date.toLocaleString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  async function loadEntries() {
    if (!entriesEl) return;
    try {
      const response = await fetch('/api/notebook');
      if (!response.ok) throw new Error(String(response.status));
      const entries: NotebookEntry[] = await response.json();

      entriesEl.textContent = '';
      if (entries.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'loading';
        empty.textContent = 'No entries yet.';
        entriesEl.appendChild(empty);
        return;
      }

      for (const entry of entries) {
        const line = document.createElement('div');
        line.className = 'entry';

        const meta = document.createElement('p');
        meta.className = 'entry-meta';

        const prompt = document.createElement('span');
        prompt.className = 'entry-prompt';
        prompt.textContent = '> ';

        const name = document.createElement('span');
        name.className = 'entry-name';
        name.textContent = entry.name;

        const time = document.createElement('span');
        time.className = 'entry-time';
        time.textContent = ` — ${formatDate(entry.created_at)}`;

        meta.append(prompt, name, time);

        const body = document.createElement('p');
        body.className = 'entry-comment';
        body.textContent = entry.comment;

        line.append(meta, body);

        if (entry.reply) {
          const reply = document.createElement('p');
          reply.className = 'entry-reply';
          const who = document.createElement('span');
          who.className = 'entry-reply-who';
          who.textContent = 'Osprey ';
          reply.appendChild(who);
          reply.appendChild(document.createTextNode(entry.reply));
          line.appendChild(reply);
        }

        entriesEl.appendChild(line);
      }
    } catch {
      entriesEl.textContent = '';
      const error = document.createElement('p');
      error.className = 'loading';
      error.textContent = 'Could not load entries.';
      entriesEl.appendChild(error);
    }
  }

  function setStatus(message: string) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.toggleAttribute('hidden', !message);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!nameInput || !commentInput || !submitButton) return;

    submitButton.disabled = true;
    setStatus('');

    try {
      const body = new FormData();
      body.set('name', nameInput.value);
      body.set('comment', commentInput.value);

      const response = await fetch('/api/notebook', { method: 'POST', body });
      if (!response.ok) {
        const data = await response.json().catch(() => null);
        throw new Error(data?.error ?? 'Failed to submit.');
      }

      commentInput.value = '';
      await loadEntries();
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to submit.');
    } finally {
      submitButton.disabled = false;
    }
  });

  loadEntries();
</script>

<style>
  .intro {
    color: #888;
    margin: 0 0 3rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  input,
  textarea {
    font-family: inherit;
    font-size: 1rem;
    color: #f5f7fa;
    background: #000;
    border: 1px solid #444;
    padding: 0.6rem;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: #ffce1c;
  }

  button {
    align-self: flex-start;
    padding: 0.6rem 1.2rem;
    font-family: inherit;
    font-size: 0.85rem;
    color: #ffce1c;
    background: transparent;
    border: 1px solid #ffce1c;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  button:hover {
    background: #ffce1c;
    color: #111;
  }

  button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .form-status {
    margin: 0;
    color: #ff6b6b;
    font-size: 0.85rem;
  }

  .loading {
    color: #888;
    font-size: 0.85rem;
  }

  .entry {
    margin-bottom: 1.5rem;
  }

  .entry-meta {
    margin: 0;
  }

  .entry-prompt {
    color: #ffce1c;
    font-weight: 700;
  }

  .entry-name {
    color: #f5f7fa;
    font-weight: 700;
  }

  .entry-time {
    color: #888;
    font-size: 0.75rem;
  }

  .entry-comment {
    margin: 0.25rem 0 0;
    color: #555;
    white-space: pre-wrap;
  }

  .entry-reply {
    margin: 0.5rem 0 0 1rem;
    padding-left: 0.75rem;
    border-left: 1px solid #333;
    color: #999;
    white-space: pre-wrap;
  }

  .entry-reply-who {
    color: #ffce1c;
    font-weight: 700;
  }
</style>
