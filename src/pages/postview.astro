---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8a9098"></stop>
        <stop offset="35%" stop-color="#f3f6f9"></stop>
        <stop offset="50%" stop-color="#ffffff"></stop>
        <stop offset="66%" stop-color="#b9bfc5"></stop>
        <stop offset="100%" stop-color="#5f656b"></stop>
        <animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
      </linearGradient>
    </defs>
  </svg>

  <main>
    <p class="back-link"><a href="/">← Home</a></p>
    <div id="post-root"><p class="feed-note">Loading…</p></div>
  </main>
</Layout>

<script>
  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';
  const IC = {
    repost:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>',
    like:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M16.697 5.5c-1.222 0-2.337.566-3.054 1.512l-1.643 2.16-1.643-2.16C9.64 6.066 8.525 5.5 7.303 5.5c-2.243 0-3.95 1.866-3.95 4.05 0 2.99 2.66 5.45 6.97 9.32l1.677 1.5 1.677-1.5c4.31-3.87 6.97-6.33 6.97-9.32 0-2.184-1.707-4.05-3.95-4.05z"/></svg>',
    share:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>',
  };

  const root = document.getElementById('post-root')!;

  function esc(s) {
    return (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  }
  function badges(a) {
    let h = '';
    if (a.verified) h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>Verified User</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    if (a.engineer) h += `<svg class="badge-svg" viewBox="0 0 22 22"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    return h;
  }
  function fmtCount(n) {
    if (!n) return '';
    if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K';
    return String(n);
  }
  function fmtDate(iso) {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    return d.toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  function avatarHtml(a) {
    if (a.avatar) return `<img class="post-avatar-img" src="${esc(a.avatar)}" alt="" />`;
    const initial = (a.displayName || a.username || '?').charAt(0).toUpperCase();
    return `<span class="post-avatar-img fallback">${esc(initial)}</span>`;
  }

  function render(p) {
    const a = p.author;
    root.innerHTML = `
      <article class="post solo" data-id="${esc(p.id)}">
        <div class="post-head-row">
          <a class="post-avatar" href="/u/${esc(a.username)}">${avatarHtml(a)}</a>
          <div>
            <div class="post-head">
              <span class="post-namegroup"><a class="post-name" href="/u/${esc(a.username)}">${esc(a.displayName || a.username)}</a>${badges(a)}</span>
            </div>
            <span class="post-meta">@${esc(a.username)}</span>
          </div>
        </div>
        <div class="post-body solo-body">${esc(p.content)}</div>
        <p class="post-meta solo-date">${fmtDate(p.createdAt)}</p>
        <div class="post-actions solo-actions">
          <button class="post-action act repost${p.reposted ? ' on' : ''}" data-act="repost">${IC.repost}<span class="cnt">${fmtCount(p.repostCount)}</span></button>
          <button class="post-action act like${p.liked ? ' on' : ''}" data-act="like">${IC.like}<span class="cnt">${fmtCount(p.likeCount)}</span></button>
          <span class="post-action" data-act="share">${IC.share}</span>
        </div>
      </article>`;
    root.querySelector('.solo-actions').addEventListener('click', (e) => {
      const actionEl = (e.target as HTMLElement).closest('.post-action');
      if (!actionEl) return;
      const act = actionEl.getAttribute('data-act');
      if (act === 'share') {
        navigator.clipboard?.writeText(location.href).catch(() => {});
      } else if (act === 'like' || act === 'repost') {
        toggle(act, p.id);
      }
    });
  }

  async function toggle(kind, id) {
    const res = await fetch('/api/posts/' + kind, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ postId: id }),
    });
    if (res.status === 401) {
      location.href = '/profile';
      return;
    }
    const data = await res.json();
    if (!res.ok) return;
    const btn = root.querySelector('.act.' + kind);
    btn.classList.toggle('on', kind === 'like' ? data.liked : data.reposted);
    btn.querySelector('.cnt').textContent = fmtCount(kind === 'like' ? data.likeCount : data.repostCount);
  }

  async function init() {
    const m = location.pathname.match(/^\/post\/([^/?#]+)/);
    const id = m ? decodeURIComponent(m[1]) : '';
    if (!id) {
      root.innerHTML = '<p class="feed-note">Post not found.</p>';
      return;
    }
    try {
      const res = await fetch('/api/post?id=' + encodeURIComponent(id));
      if (!res.ok) {
        root.innerHTML = '<p class="feed-note">Post not found.</p>';
        return;
      }
      render(await res.json());
    } catch {
      root.innerHTML = '<p class="feed-note">Could not load post.</p>';
    }
  }
  init();
</script>

<style is:global>
  main {
    padding: 2rem;
    max-width: 760px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .back-link {
    margin: 0 0 1.5rem;
  }
  .back-link a,
  .back-link a:visited {
    color: #888;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .back-link a:hover {
    color: #ffce1c;
  }

  .feed-note {
    color: #888;
  }

  .post.solo {
    border-bottom: 1px solid #222;
    padding-bottom: 1.25rem;
  }

  .post-head-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .post-avatar {
    flex-shrink: 0;
  }
  .post-avatar-img {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #333;
    background: #111;
    color: #ffce1c;
    font-weight: 700;
    font-size: 1.3rem;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .post-name,
  .post-name:visited {
    font-weight: 700;
    color: #f5f7fa;
    text-decoration: none;
  }
  .post-name:hover {
    text-decoration: underline;
  }
  .post-head .badge-svg {
    width: 1em;
    height: 1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
  }
  .post-meta {
    color: #888;
    font-size: 0.9rem;
  }

  .solo-body {
    margin-top: 1rem;
    font-size: 1.4rem;
    line-height: 1.5;
    color: #f5f7fa;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .solo-date {
    margin: 1rem 0 0;
  }

  .solo-actions {
    display: flex;
    gap: 2.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #222;
    color: #888;
  }

  .post-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    transition: color 0.15s ease;
  }
  .post-action:hover {
    color: #ffce1c;
  }
  .post-action.like.on {
    color: #ffce1c;
  }
  .post-action.repost.on {
    color: #ffce1c;
  }
  .post-icon {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
