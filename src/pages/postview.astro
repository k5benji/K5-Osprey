---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8a9098"></stop>
        <stop offset="35%" stop-color="#f3f6f9"></stop>
        <stop offset="50%" stop-color="#ffffff"></stop>
        <stop offset="66%" stop-color="#b9bfc5"></stop>
        <stop offset="100%" stop-color="#5f656b"></stop>
        <animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
      </linearGradient>
    </defs>
  </svg>

  <main>
    <div id="post-root"><p class="feed-note">Loading…</p></div>
  </main>
</Layout>

<script>
  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';
  const IC = {
    reply:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"/></svg>',
    repost:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>',
    like:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M16.697 5.5c-1.222 0-2.337.566-3.054 1.512l-1.643 2.16-1.643-2.16C9.64 6.066 8.525 5.5 7.303 5.5c-2.243 0-3.95 1.866-3.95 4.05 0 2.99 2.66 5.45 6.97 9.32l1.677 1.5 1.677-1.5c4.31-3.87 6.97-6.33 6.97-9.32 0-2.184-1.707-4.05-3.95-4.05z"/></svg>',
    share:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>',
    ask:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M11 2.5l1.8 5.2L18 9.5l-5.2 1.8L11 16.5l-1.8-5.2L4 9.5l5.2-1.8L11 2.5zm7.5 10l.95 2.55L22 16l-2.55.95L18.5 19.5l-.95-2.55L15 16l2.55-.95L18.5 12.5z"/></svg>',
  };

  const root = document.getElementById('post-root')!;

  function esc(s) {
    return (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  }
  function badges(a) {
    let h = '';
    if (a.verified) h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>Verified User</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    if (a.engineer) h += `<svg class="badge-svg" viewBox="0 0 22 22"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text></svg>`;
    return h;
  }
  function fmtCount(n) {
    if (!n) return '';
    if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K';
    return String(n);
  }
  function fmtDate(iso) {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    return d.toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  function avatarHtml(a) {
    if (a.avatar) return `<img class="post-avatar-img" src="${esc(a.avatar)}" alt="" />`;
    const initial = (a.displayName || a.username || '?').charAt(0).toUpperCase();
    return `<span class="post-avatar-img fallback">${esc(initial)}</span>`;
  }

  let signedIn = false;
  let myUsername = null;
  let postAuthor = null;

  function mediaHtml(m) {
    if (!m || !m.url) return '';
    if (m.type === 'video')
      return `<video class="post-media" src="${esc(m.url)}" controls playsinline preload="metadata"></video>`;
    return `<img class="post-media" src="${esc(m.url)}" alt="" loading="lazy" />`;
  }

  function commentHtml(c) {
    const a = c.author;
    const canDelete = myUsername && (a.username === myUsername || postAuthor === myUsername);
    return `
      <article class="comment" data-id="${esc(c.id)}">
        <a class="comment-avatar" href="/u/${esc(a.username)}">${avatarHtml(a)}</a>
        <div class="comment-main">
          <div class="comment-head">
            <span class="post-namegroup"><a class="post-name" href="/u/${esc(a.username)}">${esc(a.displayName || a.username)}</a>${badges(a)}</span>
            <span class="post-meta">@${esc(a.username)} · ${fmtDate(c.createdAt)}</span>
            ${canDelete ? `<button class="comment-del" data-id="${esc(c.id)}" aria-label="Delete reply">Delete</button>` : ''}
          </div>
          <div class="comment-body">${esc(c.content)}</div>
        </div>
      </article>`;
  }

  function render(p) {
    const a = p.author;
    postAuthor = a.username;
    root.innerHTML = `
      <article class="post solo" data-id="${esc(p.id)}">
        <div class="post-head-row">
          <a class="post-avatar" href="/u/${esc(a.username)}">${avatarHtml(a)}</a>
          <div>
            <div class="post-head">
              <span class="post-namegroup"><a class="post-name" href="/u/${esc(a.username)}">${esc(a.displayName || a.username)}</a>${badges(a)}</span>
            </div>
            <span class="post-meta">@${esc(a.username)}</span>
          </div>
        </div>
        <div class="post-body solo-body">${esc(p.content)}</div>
        ${mediaHtml(p.media)}
        ${(p.threadParts && p.threadParts.length) ? p.threadParts.map((t) => `<div class="thread-part">${esc(t)}</div>`).join('') : ''}
        <p class="post-meta solo-date">${fmtDate(p.createdAt)}</p>
        <div class="post-actions solo-actions">
          <button class="post-action act reply" data-act="reply">${IC.reply}<span class="cnt">${fmtCount(p.commentCount)}</span></button>
          <button class="post-action act repost${p.reposted ? ' on' : ''}" data-act="repost">${IC.repost}<span class="cnt">${fmtCount(p.repostCount)}</span></button>
          <button class="post-action act like${p.liked ? ' on' : ''}" data-act="like">${IC.like}<span class="cnt">${fmtCount(p.likeCount)}</span></button>
          <span class="post-action ask-osprey" data-act="ask" title="Ask Osprey about this post" aria-label="Ask Osprey about this post">${IC.ask}</span>
          <span class="post-action" data-act="share">${IC.share}</span>
        </div>
      </article>
      <section class="comments">
        ${
          signedIn
            ? `<form class="comment-composer" id="comment-form">
                 <textarea id="comment-input" rows="1" maxlength="500" placeholder="Post your comment"></textarea>
                 <button type="submit" class="comment-btn">Reply</button>
                 <span class="comment-status" id="comment-status"></span>
               </form>`
            : `<p class="comment-signin"><a href="/profile">Sign in</a> to reply.</p>`
        }
        <div class="comment-list" id="comment-list">
          <div class="feed-loading"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
        </div>
      </section>`;

    root.querySelector('.solo-actions').addEventListener('click', (e) => {
      const actionEl = (e.target as HTMLElement).closest('.post-action');
      if (!actionEl) return;
      const act = actionEl.getAttribute('data-act');
      if (act === 'share') {
        navigator.clipboard?.writeText(location.href).catch(() => {});
      } else if (act === 'ask') {
        try {
          sessionStorage.setItem('k5-ask', 'Tell me about this post:\n\n"' + p.content + '"');
        } catch {
          /* ignore */
        }
        location.href = '/ospreyai';
      } else if (act === 'like' || act === 'repost') {
        toggle(act, p.id);
      } else if (act === 'reply') {
        const input = document.getElementById('comment-input') as HTMLTextAreaElement | null;
        if (input) input.focus();
        else location.href = '/profile';
      }
    });

    const form = document.getElementById('comment-form') as HTMLFormElement | null;
    if (form) {
      const input = document.getElementById('comment-input') as HTMLTextAreaElement;
      input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 200) + 'px';
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitComment(p.id);
      });
    }

    const listEl = document.getElementById('comment-list');
    if (listEl) {
      listEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.comment-del') as HTMLElement | null;
        if (!btn) return;
        deleteComment(btn.getAttribute('data-id'), btn.closest('.comment') as HTMLElement | null);
      });
    }

    loadComments(p.id);
  }

  async function deleteComment(commentId, el) {
    if (!commentId) return;
    if (!confirm('Delete this reply?')) return;
    try {
      const res = await fetch('/api/posts/comment', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ commentId }),
      });
      if (!res.ok) return;
      const data = await res.json();
      if (el) el.remove();
      const cnt = root.querySelector('.act.reply .cnt');
      if (cnt) cnt.textContent = fmtCount(data.commentCount);
      const listEl = document.getElementById('comment-list');
      if (listEl && !listEl.querySelector('.comment')) {
        listEl.innerHTML = '';
      }
    } catch {
      /* ignore */
    }
  }

  async function loadComments(postId) {
    const list = document.getElementById('comment-list');
    if (!list) return;
    try {
      const res = await fetch('/api/posts/comment?postId=' + encodeURIComponent(postId));
      const data = await res.json();
      const comments = data.comments || [];
      list.innerHTML = comments.length ? comments.map(commentHtml).join('') : '';
    } catch {
      list.innerHTML = '<p class="feed-note">Could not load replies.</p>';
    }
  }

  async function submitComment(postId) {
    const input = document.getElementById('comment-input') as HTMLTextAreaElement;
    const status = document.getElementById('comment-status');
    const content = input.value.trim();
    if (!content) return;
    input.disabled = true;
    try {
      const res = await fetch('/api/posts/comment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ postId, content }),
      });
      if (res.status === 401) {
        location.href = '/profile';
        return;
      }
      const data = await res.json();
      if (!res.ok) {
        if (status) status.textContent = data.error || 'Could not reply.';
        return;
      }
      input.value = '';
      input.style.height = 'auto';
      const list = document.getElementById('comment-list');
      const note = list.querySelector('.feed-note');
      if (note) note.remove();
      list.insertAdjacentHTML('beforeend', commentHtml(data.comment));
      const cnt = root.querySelector('.act.reply .cnt');
      if (cnt) cnt.textContent = fmtCount(data.commentCount);
    } finally {
      input.disabled = false;
    }
  }

  async function toggle(kind, id) {
    const res = await fetch('/api/posts/' + kind, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ postId: id }),
    });
    if (res.status === 401) {
      location.href = '/profile';
      return;
    }
    const data = await res.json();
    if (!res.ok) return;
    const btn = root.querySelector('.act.' + kind);
    btn.classList.toggle('on', kind === 'like' ? data.liked : data.reposted);
    btn.querySelector('.cnt').textContent = fmtCount(kind === 'like' ? data.likeCount : data.repostCount);
  }

  async function init() {
    const m = location.pathname.match(/^\/post\/([^/?#]+)/);
    const id = m ? decodeURIComponent(m[1]) : '';
    // drop the cache-busting query the feed adds, so the address bar stays clean
    if (location.search) history.replaceState(null, '', location.pathname);
    if (!id) {
      root.innerHTML = '<p class="feed-note">Post not found.</p>';
      return;
    }
    try {
      const [postRes, me] = await Promise.all([
        fetch('/api/post?id=' + encodeURIComponent(id)),
        fetch('/api/me').then((r) => r.json()).catch(() => null),
      ]);
      signedIn = !!me;
      myUsername = me && me.username ? me.username : null;
      if (!postRes.ok) {
        root.innerHTML = '<p class="feed-note">Post not found.</p>';
        return;
      }
      render(await postRes.json());
    } catch {
      root.innerHTML = '<p class="feed-note">Could not load post.</p>';
    }
  }
  init();
</script>

<style is:global>
  main {
    padding: 2rem;
    max-width: 760px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .back-link {
    margin: 0 0 1.5rem;
  }
  .back-link a,
  .back-link a:visited {
    color: #888;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .back-link a:hover {
    color: #ffce1c;
  }

  .feed-note {
    color: #888;
  }

  .post.solo {
    border-bottom: 1px solid #222;
    padding-bottom: 1.25rem;
  }

  .post-head-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .post-avatar {
    flex-shrink: 0;
  }
  .post-avatar-img {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #333;
    background: #111;
    color: #ffce1c;
    font-weight: 700;
    font-size: 1.3rem;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .post-name,
  .post-name:visited {
    font-weight: 700;
    color: #f5f7fa;
    text-decoration: none;
  }
  .post-name:hover {
    text-decoration: underline;
  }
  .badge-svg {
    width: 1em;
    height: 1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
  }
  .post-meta {
    color: #888;
    font-size: 0.9rem;
  }

  .post-media {
    display: block;
    margin-top: 0.8rem;
    max-width: 100%;
    max-height: 560px;
    border-radius: 14px;
    border: 1px solid #222;
  }

  .thread-part {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid #1a1a1a;
    font-size: 1rem;
    line-height: 1.6;
    color: #f5f7fa;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .solo-body {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #f5f7fa;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .solo-date {
    margin: 1rem 0 0;
  }

  .solo-actions {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #222;
    color: #888;
  }

  .post-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    transition: color 0.15s ease;
  }
  .post-action:hover {
    color: #ffce1c;
  }
  .post-action.like.on,
  .post-action.repost.on {
    color: #ffce1c;
  }
  .post-icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* ---- comments ---- */
  .comments {
    margin-top: 1.5rem;
  }

  .comment-composer {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #222;
  }

  #comment-input {
    flex: 1;
    min-width: 0;
    resize: none;
    background: transparent;
    border: none;
    outline: none;
    color: #f5f7fa;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    padding: 0.4rem 0;
  }

  #comment-input::placeholder {
    color: #666;
  }

  .comment-btn {
    flex-shrink: 0;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: #111;
    background: #ffce1c;
    border: 1px solid #ffce1c;
    border-radius: 999px;
    padding: 0.45rem 1.3rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .comment-btn:hover {
    background: transparent;
    color: #ffce1c;
  }

  .comment-status {
    flex-basis: 100%;
    color: #ff6b6b;
    font-size: 0.8rem;
  }

  .comment-signin {
    color: #888;
    padding-bottom: 1rem;
    border-bottom: 1px solid #222;
  }

  .comment-signin a {
    color: #ffce1c;
  }

  .comment {
    display: flex;
    gap: 0.75rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid #1a1a1a;
  }

  .comment-avatar {
    flex-shrink: 0;
  }

  .comment-avatar .post-avatar-img {
    width: 36px;
    height: 36px;
  }

  .comment-main {
    flex: 1;
    min-width: 0;
  }

  .comment-head {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .comment-del {
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    color: #666;
    font-family: inherit;
    font-size: 0.8rem;
    padding: 0;
  }

  .comment-del:hover {
    color: #ff6b6b;
  }

  .comment-body {
    margin-top: 0.15rem;
    color: #f5f7fa;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .feed-loading {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 1.5rem 0;
  }

  .feed-loading .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffce1c;
    opacity: 0.25;
    animation: think 1.3s infinite ease-in-out;
  }

  .feed-loading .dot:nth-child(2) {
    animation-delay: 0.18s;
  }

  .feed-loading .dot:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes think {
    0%,
    70%,
    100% {
      opacity: 0.2;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
      transform: translateY(-4px);
      box-shadow: 0 0 6px 1px rgba(255, 206, 28, 0.5);
    }
  }
</style>
