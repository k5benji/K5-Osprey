---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8a9098"></stop>
        <stop offset="35%" stop-color="#f3f6f9"></stop>
        <stop offset="50%" stop-color="#ffffff"></stop>
        <stop offset="66%" stop-color="#b9bfc5"></stop>
        <stop offset="100%" stop-color="#5f656b"></stop>
        <animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
      </linearGradient>
    </defs>
  </svg>

  <main>
    <div id="messages-root">
      <div class="feed-loading"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
    </div>
  </main>
</Layout>

<script>
  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';

  const root = document.getElementById('messages-root');

  function esc(s) {
    return (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  }
  function badges(a) {
    let h = '';
    if (a.verified) h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>Verified</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    if (a.engineer) h += `<svg class="badge-svg" viewBox="0 0 22 22"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text></svg>`;
    return h;
  }
  function avatarHtml(a, cls) {
    if (a.avatar) return `<img class="${cls}" src="${esc(a.avatar)}" alt="" />`;
    const initial = (a.displayName || a.username || '?').charAt(0).toUpperCase();
    return `<span class="${cls} fallback">${esc(initial)}</span>`;
  }
  function relTime(iso) {
    if (!iso) return '';
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    const s = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
    if (s < 60) return s + 's';
    if (s < 3600) return Math.floor(s / 60) + 'm';
    if (s < 86400) return Math.floor(s / 3600) + 'h';
    return Math.floor(s / 86400) + 'd';
  }

  let pollTimer = null;
  function stopPoll() {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = null;
  }

  // ---------- conversation list ----------
  async function showList() {
    stopPoll();
    let me = null;
    try {
      me = await (await fetch('/api/me')).json();
    } catch {}
    if (!me) {
      root.innerHTML = '<h1 class="page-title">Messages</h1><p class="msg-empty">Sign in to use messages. <a href="/profile">Go to sign in</a></p>';
      return;
    }
    await renderList();
    pollTimer = setInterval(renderList, 6000);
  }

  function convRow(c) {
    const u = c.user;
    const prefix = c.lastFromMe ? 'You: ' : '';
    return `
      <a class="conv${c.unread ? ' unread' : ''}" href="/messages?with=${esc(u.username)}">
        ${avatarHtml(u, 'conv-avatar')}
        <div class="conv-main">
          <div class="conv-top">
            <span class="conv-name">${esc(u.displayName || u.username)}${badges(u)}</span>
            <span class="conv-time">${relTime(c.lastAt)}</span>
          </div>
          <div class="conv-snippet">${esc(prefix + (c.lastBody || ''))}</div>
        </div>
        ${c.unread ? '<span class="conv-dot" aria-label="unread"></span>' : ''}
      </a>`;
  }

  async function renderList() {
    try {
      const res = await fetch('/api/messages');
      if (!res.ok) return;
      const data = await res.json();
      const convs = data.conversations || [];
      root.innerHTML =
        '<h1 class="page-title">Messages</h1>' +
        (convs.length
          ? '<div class="conv-list">' + convs.map(convRow).join('') + '</div>'
          : '<p class="msg-empty">No conversations yet. Open someone’s profile and hit Message.</p>');
    } catch {
      /* ignore */
    }
  }

  // ---------- thread ----------
  let threadWith = null;
  let lastMsgId = null;

  function msgHtml(m) {
    return `<div class="bubble-row ${m.mine ? 'mine' : 'theirs'}"><div class="bubble">${esc(m.body)}</div></div>`;
  }

  async function showThread(withUser) {
    stopPoll();
    threadWith = withUser;
    let me = null;
    try {
      me = await (await fetch('/api/me')).json();
    } catch {}
    if (!me) {
      root.innerHTML = '<h1 class="page-title">Messages</h1><p class="msg-empty">Sign in to use messages. <a href="/profile">Go to sign in</a></p>';
      return;
    }
    let data;
    try {
      const res = await fetch('/api/messages/thread?with=' + encodeURIComponent(withUser));
      data = await res.json();
      if (!res.ok) {
        root.innerHTML = `<h1 class="page-title">Messages</h1><p class="msg-empty">${esc(data.error || 'Could not open conversation.')}</p>`;
        return;
      }
    } catch {
      root.innerHTML = '<h1 class="page-title">Messages</h1><p class="msg-empty">Could not open conversation.</p>';
      return;
    }

    const u = data.other;
    root.innerHTML = `
      <div class="thread-head">
        <a class="thread-back" href="/messages" aria-label="Back to messages">&larr;</a>
        <a class="thread-user" href="/u/${esc(u.username)}">
          ${avatarHtml(u, 'thread-avatar')}
          <span class="conv-name">${esc(u.displayName || u.username)}${badges(u)}</span>
        </a>
      </div>
      <div class="msg-scroll" id="msg-scroll">${data.messages.map(msgHtml).join('')}</div>
      <form class="msg-composer" id="msg-form">
        <textarea id="msg-input" rows="1" maxlength="2000" placeholder="Start a message"></textarea>
        <button type="submit" class="msg-send">Send</button>
      </form>`;

    const scroll = document.getElementById('msg-scroll');
    scroll.scrollTop = scroll.scrollHeight;
    lastMsgId = data.messages.length ? data.messages[data.messages.length - 1].id : null;

    const form = document.getElementById('msg-form');
    const input = document.getElementById('msg-input') as HTMLTextAreaElement;
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 160) + 'px';
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      sendMessage();
    });

    pollTimer = setInterval(pollThread, 4000);
  }

  async function sendMessage() {
    const input = document.getElementById('msg-input') as HTMLTextAreaElement;
    const text = input.value.trim();
    if (!text) return;
    input.disabled = true;
    try {
      const res = await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: threadWith, body: text }),
      });
      if (res.status === 401) {
        location.href = '/profile';
        return;
      }
      const data = await res.json();
      if (!res.ok) return;
      input.value = '';
      input.style.height = 'auto';
      const scroll = document.getElementById('msg-scroll');
      scroll.insertAdjacentHTML('beforeend', msgHtml(data.message));
      lastMsgId = data.message.id;
      scroll.scrollTop = scroll.scrollHeight;
    } finally {
      input.disabled = false;
      input.focus();
    }
  }

  async function pollThread() {
    if (!threadWith) return;
    try {
      const res = await fetch('/api/messages/thread?with=' + encodeURIComponent(threadWith));
      if (!res.ok) return;
      const data = await res.json();
      const msgs = data.messages || [];
      // append anything new
      let idx = msgs.length;
      if (lastMsgId) {
        const at = msgs.findIndex((m) => m.id === lastMsgId);
        idx = at >= 0 ? at + 1 : 0;
      } else {
        idx = 0;
      }
      const fresh = msgs.slice(idx);
      if (!fresh.length) return;
      const scroll = document.getElementById('msg-scroll');
      if (!scroll) return;
      const atBottom = scroll.scrollHeight - scroll.scrollTop - scroll.clientHeight < 60;
      scroll.insertAdjacentHTML('beforeend', fresh.map(msgHtml).join(''));
      lastMsgId = msgs[msgs.length - 1].id;
      if (atBottom) scroll.scrollTop = scroll.scrollHeight;
    } catch {
      /* ignore */
    }
  }

  function route() {
    const withUser = new URLSearchParams(location.search).get('with');
    if (withUser) showThread(withUser);
    else showList();
  }
  window.addEventListener('popstate', route);
  route();
</script>

<style is:global>
  main {
    padding: 2rem;
    max-width: 640px;
    margin: 0 auto;
    height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  #messages-root {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }

  .page-title {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
  }

  .msg-empty {
    color: #888;
  }
  .msg-empty a {
    color: #ffce1c;
  }

  /* conversation list */
  .conv-list {
    display: flex;
    flex-direction: column;
  }

  .conv {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid #1a1a1a;
    text-decoration: none;
    color: #f5f7fa;
    transition: background-color 0.15s ease;
  }
  .conv:hover {
    background: #0b0b0b;
  }

  .conv-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #333;
    background: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffce1c;
    font-weight: 700;
    flex-shrink: 0;
  }

  .conv-main {
    flex: 1;
    min-width: 0;
  }
  .conv-top {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .conv-name {
    font-weight: 700;
  }
  .conv-time {
    color: #888;
    font-size: 0.8rem;
    flex-shrink: 0;
  }
  .conv-snippet {
    color: #888;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 0.1rem;
  }
  .conv.unread .conv-snippet {
    color: #f5f7fa;
  }
  .conv-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffce1c;
    flex-shrink: 0;
  }

  /* thread */
  .thread-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid #222;
    flex-shrink: 0;
  }
  .thread-back {
    color: #f5f7fa;
    text-decoration: none;
    font-size: 1.3rem;
    line-height: 1;
  }
  .thread-back:hover {
    color: #ffce1c;
  }
  .thread-user {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #f5f7fa;
  }
  .thread-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #333;
    background: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffce1c;
    font-weight: 700;
  }

  .msg-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 0;
    scrollbar-width: none;
  }
  .msg-scroll::-webkit-scrollbar {
    display: none;
  }

  .bubble-row {
    display: flex;
  }
  .bubble-row.mine {
    justify-content: flex-end;
  }
  .bubble {
    max-width: 75%;
    padding: 0.55rem 0.85rem;
    border-radius: 16px;
    font-size: 0.95rem;
    line-height: 1.4;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .bubble-row.theirs .bubble {
    background: #1a1a1a;
    color: #f5f7fa;
    border-bottom-left-radius: 4px;
  }
  .bubble-row.mine .bubble {
    background: #ffce1c;
    color: #111;
    border-bottom-right-radius: 4px;
  }

  .msg-composer {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #222;
    flex-shrink: 0;
  }
  #msg-input {
    flex: 1;
    min-width: 0;
    resize: none;
    background: #0e0e0e;
    border: 1px solid #222;
    border-radius: 18px;
    color: #f5f7fa;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.4;
    padding: 0.55rem 0.9rem;
    outline: none;
  }
  #msg-input:focus {
    border-color: #ffce1c;
  }
  #msg-input::placeholder {
    color: #666;
  }
  .msg-send {
    flex-shrink: 0;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: #111;
    background: #ffce1c;
    border: 1px solid #ffce1c;
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    cursor: pointer;
  }
  .msg-send:hover {
    background: transparent;
    color: #ffce1c;
  }

  .badge-svg {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
    margin-left: 0.05em;
  }

  .feed-loading {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 2rem 0;
  }
  .feed-loading .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffce1c;
    opacity: 0.25;
    animation: think 1.3s infinite ease-in-out;
  }
  .feed-loading .dot:nth-child(2) {
    animation-delay: 0.18s;
  }
  .feed-loading .dot:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes think {
    0%, 70%, 100% { opacity: 0.2; transform: translateY(0); }
    35% { opacity: 1; transform: translateY(-4px); box-shadow: 0 0 6px 1px rgba(255, 206, 28, 0.5); }
  }
</style>
