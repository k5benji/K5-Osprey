import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="profile-page">
    <div id="profile-root">
      <div class="glass card center loading">Loading…</div>
    </div>
  </main>
</Layout>

<script>
  const root = document.getElementById('profile-root');

  function esc(s) {
    return (s ?? '').replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
    );
  }

  function avatarBlock(user) {
    const initial = (user.displayName || user.username || '?').charAt(0).toUpperCase();
    if (user.avatar) {
      return `<img class="avatar" src="${esc(user.avatar)}" alt="" />`;
    }
    return `<div class="avatar avatar-fallback">${esc(initial)}</div>`;
  }

  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';

  // First official user (@sia): pastel-pink holographic seal with a "#1".
  const SIA_BADGE =
    `<path fill="url(#sia-pink)" d="${SEAL.split('M9.662')[0]}"/>` +
    '<text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8" font-weight="700" fill="#9d2463">#1</text>';
  const YELLOW_SEAL = `<path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/>`;

  function badge(user) {
    let html = '';
    if (user.username === 'sia') {
      html +=
        ' <span class="badge-wrap"><svg class="badge-svg verified-badge" viewBox="0 0 22 22" aria-label="Verified User">' +
        YELLOW_SEAL +
        '</svg><span class="tip">Verified User</span></span>' +
        '<span class="badge-wrap"><svg class="badge-svg verified-badge" viewBox="0 0 22 22" aria-label="First official user">' +
        SIA_BADGE +
        '</svg><span class="tip">First official user</span></span>';
    } else if (user.verified) {
      html +=
        ' <span class="badge-wrap"><svg class="badge-svg verified-badge" viewBox="0 0 22 22" aria-label="Verified User">' +
        YELLOW_SEAL +
        '</svg><span class="tip">Verified User</span></span>';
    }
    if (user.engineer) {
      html +=
        '<span class="badge-wrap"><svg class="badge-svg engineer-badge" viewBox="0 0 22 22" aria-label="Engineer of Kastle Five">' +
        `<path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text>` +
        '</svg><span class="tip">Engineer of Kastle Five</span></span>';
    }
    return html;
  }

  function renderView(user, isMe) {
    const actions = isMe
      ? `<button class="btn" data-act="edit">Edit profile</button>
         <button class="btn ghost" data-act="logout">Log out</button>`
      : `<button class="btn ghost" data-act="copy">Copy link</button>`;
    root.innerHTML = `
      <div class="glass card center">
        ${avatarBlock(user)}
        <h1 class="display-name">${esc(user.displayName || user.username)}${badge(user)}</h1>
        <p class="handle">@${esc(user.username)}</p>
        ${user.bio ? `<p class="bio">${esc(user.bio)}</p>` : ''}
        <div class="actions">${actions}</div>
      </div>`;

    const card = root.querySelector('.card');
    card.querySelector('[data-act="edit"]')?.addEventListener('click', () => renderEdit(user));
    card.querySelector('[data-act="logout"]')?.addEventListener('click', logout);
    card.querySelector('[data-act="copy"]')?.addEventListener('click', (e) => {
      navigator.clipboard?.writeText(location.origin + '/u/' + user.username);
      e.target.textContent = 'Copied';
      setTimeout(() => (e.target.textContent = 'Copy link'), 1500);
    });
  }

  function renderEdit(user) {
    root.innerHTML = `
      <div class="glass card">
        <div class="avatar-edit">
          ${avatarBlock(user)}
          <label class="avatar-upload">
            Change picture
            <input type="file" id="avatar-input" accept="image/*" hidden />
          </label>
        </div>
        <label class="field">Username
          <input id="f-username" type="text" maxlength="20" value="${esc(user.username)}" />
        </label>
        <label class="field">Display name
          <input id="f-display" type="text" maxlength="40" value="${esc(user.displayName || '')}" />
        </label>
        <label class="field">Short description
          <textarea id="f-bio" rows="3" maxlength="200">${esc(user.bio || '')}</textarea>
        </label>
        <p class="form-status" id="form-status" hidden></p>
        <div class="actions">
          <button id="save-btn" class="btn">Save</button>
          <button id="cancel-btn" class="btn ghost">Cancel</button>
        </div>
      </div>`;

    document.getElementById('cancel-btn').addEventListener('click', () => renderView(user, true));
    document.getElementById('save-btn').addEventListener('click', () => save(user));

    const fileInput = document.getElementById('avatar-input');
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files[0];
      if (!file) return;
      setStatus('Uploading…', false);
      try {
        const res = await fetch('/api/avatar', {
          method: 'POST',
          headers: { 'Content-Type': file.type },
          body: file,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed.');
        user.avatar = data.avatar + '?t=' + Date.now();
        const img = root.querySelector('.avatar');
        if (img && img.tagName === 'IMG') img.src = user.avatar;
        else renderEdit(user);
        setStatus('Picture updated.', false);
      } catch (e) {
        setStatus(e.message, true);
      }
    });
  }

  function setStatus(msg, isError) {
    const el = document.getElementById('form-status');
    if (!el) return;
    el.textContent = msg;
    el.classList.toggle('error', !!isError);
    el.hidden = !msg;
  }

  async function save(user) {
    const username = document.getElementById('f-username').value.trim().toLowerCase();
    const displayName = document.getElementById('f-display').value.trim();
    const bio = document.getElementById('f-bio').value.trim();
    setStatus('Saving…', false);
    try {
      const res = await fetch('/api/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, displayName, bio }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not save.');
      renderView({ ...data, avatar: user.avatar }, true);
    } catch (e) {
      setStatus(e.message, true);
    }
  }

  async function logout() {
    await fetch('/api/auth/logout', { method: 'POST' });
    location.href = '/';
  }

  function renderSignin() {
    root.innerHTML = `
      <div class="glass card center">
        <h1 class="display-name">Profile</h1>
        <p class="muted">Sign in to claim a username, add a picture, and a short description.</p>
        <div class="signin-options">
          <a class="btn" href="/api/auth/github">Sign in with GitHub</a>
          <a class="btn ghost" href="/api/auth/google">Sign in with Google</a>
        </div>
      </div>`;
  }

  async function init() {
    const pathMatch = location.pathname.match(/^\/u\/([^/?#]+)/);
    const viewing = pathMatch
      ? decodeURIComponent(pathMatch[1])
      : new URLSearchParams(location.search).get('u');

    let me = null;
    try {
      me = await (await fetch('/api/me')).json();
    } catch {
      /* ignore */
    }

    if (viewing) {
      try {
        const res = await fetch('/api/user?u=' + encodeURIComponent(viewing));
        if (!res.ok) {
          root.innerHTML = '<div class="glass card center"><p class="muted">No such profile.</p></div>';
          return;
        }
        const data = await res.json();
        const isMe = !!(me && me.username && me.username === data.username);
        renderView(data, isMe);
      } catch {
        root.innerHTML = '<div class="glass card center"><p class="muted">Could not load profile.</p></div>';
      }
      return;
    }

    if (me) {
      if (new URLSearchParams(location.search).has('edit')) renderEdit(me);
      else renderView(me, true);
    } else renderSignin();
  }

  init();
</script>

<style is:global>
  .profile-page {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 6vw, 4rem) 1rem;
  }

  #profile-root {
    width: 100%;
    max-width: 460px;
  }

  .profile-page .card {
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .profile-page .card.center {
    align-items: center;
    text-align: center;
  }

  .profile-page .card.loading {
    align-items: center;
    color: var(--muted);
  }

  .avatar {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
  }

  .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent-ink);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  }

  .display-name {
    margin: 0.5rem 0 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.05rem;
  }

  .handle {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .bio {
    margin: 0.5rem 0 0;
    line-height: 1.55;
    color: var(--text);
  }

  .muted {
    color: var(--muted);
  }

  .actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---- badges ---- */
  .badge-wrap {
    position: relative;
    display: inline-flex;
  }

  .badge-svg {
    width: 0.85em;
    height: 0.85em;
    vertical-align: -0.05em;
    margin-left: 0.08em;
  }

  .badge-wrap .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid var(--glass-border);
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0;
    white-space: nowrap;
    padding: 0.3rem 0.55rem;
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    box-shadow: var(--glass-shadow);
  }

  .badge-wrap:hover .tip {
    opacity: 1;
  }

  /* ---- buttons / form ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    border: none;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--accent-ink);
    box-shadow: 0 4px 16px rgba(255, 206, 28, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 206, 28, 0.5);
  }

  .btn.ghost {
    background: var(--field-bg);
    color: var(--text);
    border: 1px solid var(--glass-border);
    box-shadow: none;
  }

  .btn.ghost:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .signin-options {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .avatar-edit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .avatar-upload {
    font-size: 0.85rem;
    color: var(--accent-strong);
    cursor: pointer;
    font-weight: 600;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
  }

  .field input,
  .field textarea {
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--field-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .form-status.error {
    color: #e0455e;
  }
</style>
