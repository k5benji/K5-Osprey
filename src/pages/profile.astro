---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8a9098"></stop>
        <stop offset="35%" stop-color="#f3f6f9"></stop>
        <stop offset="50%" stop-color="#ffffff"></stop>
        <stop offset="66%" stop-color="#b9bfc5"></stop>
        <stop offset="100%" stop-color="#5f656b"></stop>
        <animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"></animateTransform>
      </linearGradient>
    </defs>
  </svg>
  <main>
    <div id="profile-root"><p class="muted">Loading…</p></div>
  </main>
</Layout>

<script>
  const root = document.getElementById('profile-root');
  let myUsername = null;

  const MENU_ICON =
    '<svg viewBox="0 0 24 24" class="post-icon"><circle cx="5" cy="12" r="1.8" fill="currentColor"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/><circle cx="19" cy="12" r="1.8" fill="currentColor"/></svg>';

  function postMenu(p) {
    if (!myUsername || p.author.username !== myUsername) return '';
    return `
      <div class="post-menu-wrap">
        <button class="post-menu-btn" data-act="menu" aria-label="More">${MENU_ICON}</button>
        <div class="post-menu" hidden>
          <button class="post-menu-item" data-act="edit">Edit post</button>
          <button class="post-menu-item danger" data-act="delete">Delete post</button>
        </div>
      </div>`;
  }

  function esc(s) {
    return (s ?? '').replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
    );
  }

  function avatarBlock(user) {
    const initial = (user.displayName || user.username || '?').charAt(0).toUpperCase();
    if (user.avatar) {
      return `<img class="avatar" src="${esc(user.avatar)}" alt="" />`;
    }
    return `<div class="avatar avatar-fallback">${esc(initial)}</div>`;
  }

  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';

  function badge(user) {
    let html = '';
    if (user.verified) {
      html +=
        ' <span class="badge-wrap"><svg class="badge-svg verified-badge" viewBox="0 0 22 22" aria-label="Verified User">' +
        `<path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/>` +
        '</svg><span class="tip">Verified User</span></span>';
    }
    if (user.engineer) {
      html +=
        '<span class="badge-wrap"><svg class="badge-svg engineer-badge" viewBox="0 0 22 22" aria-label="Engineer of Kastle Five">' +
        `<path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text>` +
        '</svg><span class="tip">Engineer of Kastle Five</span></span>';
    }
    return html;
  }

  // post badges (no tooltip, matching the home feed)
  function postBadges(a) {
    let h = '';
    if (a.verified)
      h += ` <svg class="badge-svg" viewBox="0 0 22 22"><title>Verified User</title><path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/></svg>`;
    if (a.engineer)
      h += `<svg class="badge-svg" viewBox="0 0 22 22"><title>Engineer of Kastle Five</title><path fill="url(#chrome)" d="${SEAL.split('M9.662')[0]}"/><text x="11" y="11.4" text-anchor="middle" dominant-baseline="central" font-family="Helvetica, Arial, sans-serif" font-size="8.5" font-weight="700" fill="#fff">K5</text></svg>`;
    return h;
  }

  function postAvatar(a) {
    if (a.avatar) return `<img class="post-avatar-img" src="${esc(a.avatar)}" alt="" />`;
    const initial = (a.displayName || a.username || '?').charAt(0).toUpperCase();
    return `<span class="post-avatar-img fallback">${esc(initial)}</span>`;
  }

  function renderView(user, isMe) {
    const followers = user.followers ?? 0;
    const following = user.following ?? 0;
    const menuItems = isMe
      ? `<button class="profile-menu-item" data-act="edit">Edit profile</button>
         <button class="profile-menu-item" data-act="logout">Log out</button>`
      : `<button class="profile-menu-item" data-act="copy">Copy link to profile</button>`;
    const menu = `<div class="profile-menu-wrap">
        <button class="profile-menu-btn" aria-label="Profile options">${MENU_ICON}</button>
        <div class="profile-menu" hidden>${menuItems}</div>
      </div>`;
    const messageBtn = isMe ? '' : `<a class="message-btn" href="/messages?with=${esc(user.username)}">Message</a>`;
    const followBtn = isMe
      ? ''
      : `<button class="follow-btn${user.isFollowing ? ' following' : ''}" type="button"><span class="follow-shine"></span><span class="follow-label">${user.isFollowing ? 'Following' : 'Follow'}</span></button>`;
    root.innerHTML = `
      <div class="card">
        ${avatarBlock(user)}
        <h1 class="display-name">${esc(user.displayName || user.username)}${badge(user)}</h1>
        <p class="handle">@${esc(user.username)}</p>
        ${user.bio ? `<p class="bio">${esc(user.bio)}</p>` : ''}
        <div class="profile-stats">
          <span class="profile-stat"><span class="stat-num">${fmtFollow(following)}</span> Following</span>
          <span class="profile-stat"><span class="stat-num" data-followers="${followers}">${fmtFollow(followers)}</span> Followers</span>
        </div>
      </div>
      <div class="follow-group">
        ${menu}
        ${messageBtn}
        ${followBtn}
      </div>
      <div class="posts" id="user-posts"></div>`;
    wireFollowGroup(user, isMe);
    loadUserPosts(user, isMe);
    requestAnimationFrame(positionFollowGroup);
  }

  function positionFollowGroup() {
    const group = root.querySelector('.follow-group');
    const posts = root.querySelector('.posts');
    const name = root.querySelector('.display-name');
    if (!group || !posts || !name) return;
    const rr = root.getBoundingClientRect();
    const pr = posts.getBoundingClientRect();
    const nr = name.getBoundingClientRect();
    group.style.left = pr.right - rr.left + 'px';
    group.style.top = nr.top + nr.height / 2 - rr.top + 'px';
  }
  window.addEventListener('resize', positionFollowGroup);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(positionFollowGroup);

  function wireFollowGroup(user, isMe) {
    const group = root.querySelector('.follow-group');
    if (!group) return;
    const wrap = group.querySelector('.profile-menu-wrap');
    if (wrap) {
      const btn = wrap.querySelector('.profile-menu-btn');
      const m = wrap.querySelector('.profile-menu');
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const hidden = m.hasAttribute('hidden');
        closeMenus();
        if (hidden) m.removeAttribute('hidden');
      });
      const editItem = m.querySelector('[data-act="edit"]');
      const logoutItem = m.querySelector('[data-act="logout"]');
      const copyItem = m.querySelector('[data-act="copy"]');
      if (editItem) editItem.addEventListener('click', () => renderEdit(user));
      if (logoutItem) logoutItem.addEventListener('click', logout);
      if (copyItem)
        copyItem.addEventListener('click', () => {
          navigator.clipboard?.writeText(location.origin + '/u/' + user.username).catch(() => {});
          closeMenus();
        });
    }
    const fbtn = group.querySelector('.follow-btn');
    if (!fbtn) return;
    const label = fbtn.querySelector('.follow-label');
    const stat = root.querySelector('.stat-num[data-followers]');
    let busy = false;
    fbtn.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      // replay the chrome sweep animation
      fbtn.classList.remove('animating');
      void fbtn.offsetWidth;
      fbtn.classList.add('animating');
      try {
        const res = await fetch('/api/follow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: user.username }),
        });
        if (res.status === 401) {
          location.href = '/profile';
          return;
        }
        const data = await res.json();
        if (!res.ok) return;
        fbtn.classList.toggle('following', data.following);
        label.textContent = data.following ? 'Following' : 'Follow';
        if (stat) {
          stat.setAttribute('data-followers', String(data.followers));
          stat.textContent = fmtFollow(data.followers);
        }
      } catch {
        /* ignore */
      } finally {
        busy = false;
      }
    });
  }

  function fmtFollow(n) {
    if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K';
    return String(n);
  }

  function mediaHtml(m) {
    if (!m || !m.url) return '';
    if (m.type === 'video')
      return `<video class="post-media" src="${esc(m.url)}" controls playsinline preload="metadata"></video>`;
    return `<img class="post-media" src="${esc(m.url)}" alt="" loading="lazy" />`;
  }

  // ---- posts feed (the author's written work, as X-style posts) ----
  const ICONS = {
    reply:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"/></svg>',
    repost:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>',
    like:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M16.697 5.5c-1.222 0-2.337.566-3.054 1.512l-1.643 2.16-1.643-2.16C9.64 6.066 8.525 5.5 7.303 5.5c-2.243 0-3.95 1.866-3.95 4.05 0 2.99 2.66 5.45 6.97 9.32l1.677 1.5 1.677-1.5c4.31-3.87 6.97-6.33 6.97-9.32 0-2.184-1.707-4.05-3.95-4.05z"/></svg>',
    views:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M8.75 21V3h2v18h-2zM18 21V8.5h2V21h-2zM4 21l.004-10h2L6 21H4zm9.248 0v-7h2v7h-2z"/></svg>',
    share:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>',
    ask:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M11 2.5l1.8 5.2L18 9.5l-5.2 1.8L11 16.5l-1.8-5.2L4 9.5l5.2-1.8L11 2.5zm7.5 10l.95 2.55L22 16l-2.55.95L18.5 19.5l-.95-2.55L15 16l2.55-.95L18.5 12.5z"/></svg>',
    thread:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M12 3a3 3 0 0 0-1 5.83v6.34a3 3 0 1 0 2 0V8.83A3 3 0 0 0 12 3z"/></svg>',
  };

  function askOsprey(content) {
    try {
      sessionStorage.setItem('k5-ask', 'Tell me about this post:\n\n"' + content + '"');
    } catch {
      /* ignore */
    }
    location.href = '/ospreyai';
  }

  function fmtCount(n) {
    if (!n) return '';
    if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K';
    return String(n);
  }

  function fmtPostDate(iso) {
    const d = new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z');
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function postHtml(p) {
    const a = p.author;
    return `
      <article class="post" data-id="${esc(p.id)}">
        <div class="post-avatar">${postAvatar(a)}</div>
        <div class="post-main">
          <div class="post-head">
            <span class="post-namegroup"><span class="post-name">${esc(a.displayName || a.username)}</span>${postBadges(a)}</span>
            <span class="post-meta">@${esc(a.username)} · ${fmtPostDate(p.createdAt)}</span>
            ${postMenu(p)}
          </div>
          <div class="post-body">${esc(p.content)}</div>
          ${mediaHtml(p.media)}
          ${p.threadCount > 1 ? `<div class="thread-flag">${ICONS.thread}<span>Show this thread · ${p.threadCount} parts</span></div>` : ''}
          <div class="post-actions">
            <span class="post-action" data-act="reply">${ICONS.reply}<span class="cnt">${fmtCount(p.commentCount)}</span></span>
            <button class="post-action act repost${p.reposted ? ' on' : ''}" data-act="repost">${ICONS.repost}<span class="cnt">${fmtCount(p.repostCount)}</span></button>
            <button class="post-action act like${p.liked ? ' on' : ''}" data-act="like">${ICONS.like}<span class="cnt">${fmtCount(p.likeCount)}</span></button>
            <span class="post-action ask-osprey" data-act="ask" title="Ask Osprey about this post" aria-label="Ask Osprey about this post">${ICONS.ask}</span>
            <span class="post-action" data-act="share">${ICONS.share}</span>
          </div>
        </div>
      </article>`;
  }

  async function loadUserPosts(user, isMe) {
    const el = document.getElementById('user-posts');
    if (!el) return;
    const head = '<p class="posts-label">Posts</p>';
    try {
      const res = await fetch('/api/posts?user=' + encodeURIComponent(user.username));
      const data = await res.json();
      const posts = data.posts || [];
      el.innerHTML = head + (posts.length ? posts.map(postHtml).join('') : '');
    } catch {
      el.innerHTML = head;
    }
    positionFollowGroup();
  }

  async function togglePost(kind, id, article) {
    const res = await fetch('/api/posts/' + kind, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ postId: id }),
    });
    if (res.status === 401) {
      location.href = '/profile';
      return;
    }
    const data = await res.json();
    if (!res.ok) return;
    const btn = article.querySelector('.act.' + kind);
    btn.classList.toggle('on', kind === 'like' ? data.liked : data.reposted);
    btn.querySelector('.cnt').textContent = fmtCount(kind === 'like' ? data.likeCount : data.repostCount);
  }

  function renderEdit(user) {
    root.innerHTML = `
      <div class="card">
        <div class="avatar-edit">
          ${avatarBlock(user)}
          <label class="avatar-upload">
            Change picture
            <input type="file" id="avatar-input" accept="image/*" hidden />
          </label>
        </div>
        <label class="field">Username
          <input id="f-username" type="text" maxlength="20" value="${esc(user.username)}" />
        </label>
        <label class="field">Display name
          <input id="f-display" type="text" maxlength="40" value="${esc(user.displayName || '')}" />
        </label>
        <label class="field">Short description
          <textarea id="f-bio" rows="3" maxlength="200">${esc(user.bio || '')}</textarea>
        </label>
        <p class="form-status" id="form-status" hidden></p>
        <div class="actions">
          <button id="save-btn" class="btn">Save</button>
          <button id="cancel-btn" class="btn ghost">Cancel</button>
        </div>
      </div>`;

    document.getElementById('cancel-btn').addEventListener('click', () => renderView(user, true));
    document.getElementById('save-btn').addEventListener('click', () => save(user));

    const fileInput = document.getElementById('avatar-input');
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files[0];
      if (!file) return;
      setStatus('Uploading…', false);
      try {
        const res = await fetch('/api/avatar', {
          method: 'POST',
          headers: { 'Content-Type': file.type },
          body: file,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed.');
        user.avatar = data.avatar + '?t=' + Date.now();
        const img = root.querySelector('.avatar');
        if (img && img.tagName === 'IMG') img.src = user.avatar;
        else renderEdit(user);
        setStatus('Picture updated.', false);
      } catch (e) {
        setStatus(e.message, true);
      }
    });
  }

  function setStatus(msg, isError) {
    const el = document.getElementById('form-status');
    if (!el) return;
    el.textContent = msg;
    el.classList.toggle('error', !!isError);
    el.hidden = !msg;
  }

  async function save(user) {
    const username = document.getElementById('f-username').value.trim().toLowerCase();
    const displayName = document.getElementById('f-display').value.trim();
    const bio = document.getElementById('f-bio').value.trim();
    setStatus('Saving…', false);
    try {
      const res = await fetch('/api/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, displayName, bio }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not save.');
      renderView({ ...data, avatar: user.avatar }, true);
    } catch (e) {
      setStatus(e.message, true);
    }
  }

  async function logout() {
    await fetch('/api/auth/logout', { method: 'POST' });
    location.href = '/';
  }

  function renderSignin() {
    root.innerHTML = `
      <div class="card center">
        <h1 class="display-name">Profile</h1>
        <p class="muted">Sign in to claim a username, add a picture, and a short description.</p>
        <div class="signin-options">
          <a class="btn" href="/api/auth/github">Sign in with GitHub</a>
          <a class="btn ghost" href="/api/auth/google">Sign in with Google</a>
        </div>
      </div>`;
  }

  async function init() {
    const pathMatch = location.pathname.match(/^\/u\/([^/?#]+)/);
    const viewing = pathMatch
      ? decodeURIComponent(pathMatch[1])
      : new URLSearchParams(location.search).get('u');

    let me = null;
    try {
      me = await (await fetch('/api/me')).json();
    } catch {
      /* ignore */
    }
    myUsername = me ? me.username : null;

    if (viewing) {
      if (me && me.username === viewing.toLowerCase()) return renderView(me, true);
      try {
        const res = await fetch('/api/user?u=' + encodeURIComponent(viewing));
        if (!res.ok) {
          root.innerHTML = '<div class="card center"><p class="muted">No such profile.</p></div>';
          return;
        }
        renderView(await res.json(), false);
      } catch {
        root.innerHTML = '<div class="card center"><p class="muted">Could not load profile.</p></div>';
      }
      return;
    }

    if (me) {
      if (new URLSearchParams(location.search).has('edit')) renderEdit(me);
      else renderView(me, true);
    } else renderSignin();
  }

  function closeMenus() {
    root.querySelectorAll('.post-menu, .profile-menu').forEach((m) => m.setAttribute('hidden', ''));
  }
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.post-menu-wrap') && !e.target.closest('.profile-menu-wrap')) closeMenus();
  });

  function editPost(article, id) {
    const bodyEl = article.querySelector('.post-body');
    if (!bodyEl || bodyEl.querySelector('.post-edit')) return;
    const original = bodyEl.textContent;
    bodyEl.innerHTML = '';
    bodyEl.classList.add('editing');
    const wrap = document.createElement('div');
    wrap.className = 'post-edit';
    const ta = document.createElement('textarea');
    ta.className = 'post-edit-area';
    ta.value = original;
    const row = document.createElement('div');
    row.className = 'post-edit-row';
    const cancel = document.createElement('button');
    cancel.className = 'post-edit-cancel';
    cancel.textContent = 'Cancel';
    const save = document.createElement('button');
    save.className = 'post-edit-save';
    save.textContent = 'Save';
    row.append(cancel, save);
    wrap.append(ta, row);
    bodyEl.append(wrap);
    ta.style.height = 'auto';
    ta.style.height = ta.scrollHeight + 'px';
    ta.focus();
    ta.addEventListener('input', () => {
      ta.style.height = 'auto';
      ta.style.height = ta.scrollHeight + 'px';
    });
    const done = (text) => {
      bodyEl.textContent = text;
      bodyEl.classList.remove('editing');
    };
    cancel.addEventListener('click', () => done(original));
    save.addEventListener('click', async () => {
      const content = ta.value.trim();
      if (!content) return;
      save.disabled = true;
      try {
        const res = await fetch('/api/posts/edit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ postId: id, content }),
        });
        const data = await res.json();
        done(res.ok ? data.content : original);
      } catch {
        done(original);
      }
    });
  }

  async function deletePost(article, id) {
    if (!confirm('Delete this post?')) return;
    try {
      const res = await fetch('/api/posts/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ postId: id }),
      });
      if (res.ok) article.remove();
    } catch {
      /* ignore */
    }
  }

  // delegated post interactions (root persists across renders)
  root.addEventListener('click', (e) => {
    const target = e.target;
    const article = target.closest('.post');
    if (!article) return;
    const id = article.getAttribute('data-id');

    const menuBtn = target.closest('.post-menu-btn');
    if (menuBtn) {
      e.stopPropagation();
      const menu = article.querySelector('.post-menu');
      const isHidden = menu.hasAttribute('hidden');
      closeMenus();
      if (isHidden) menu.removeAttribute('hidden');
      return;
    }
    const item = target.closest('.post-menu-item');
    if (item) {
      const act = item.getAttribute('data-act');
      closeMenus();
      if (act === 'edit') editPost(article, id);
      else if (act === 'delete') deletePost(article, id);
      return;
    }

    const actionEl = target.closest('.post-action');
    if (actionEl) {
      const act = actionEl.getAttribute('data-act');
      if (act === 'like' || act === 'repost') togglePost(act, id, article);
      else if (act === 'share') navigator.clipboard?.writeText(location.origin + '/post/' + id).catch(() => {});
      else if (act === 'reply') openPost(id);
      else if (act === 'ask') {
        const bodyEl = article.querySelector('.post-body');
        askOsprey(bodyEl ? bodyEl.textContent : '');
      }
      return;
    }
    if (target.closest('.post-edit')) return;
    if (target.closest('a')) return;
    openPost(id);
  });

  function openPost(id) {
    location.href = '/post/' + encodeURIComponent(id) + '?r=' + Date.now();
  }

  init();
</script>

