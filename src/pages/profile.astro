---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// The author whose written work shows as a posts feed on their profile.
const AUTHOR = 'k5binya';

const blog = await getCollection('blog');
const authorPosts = blog
  .map((p) => {
    const text = (p.body || '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[#*_`~>]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
    return {
      slug: p.id,
      title: p.data.title,
      date: p.data.pubDate.toISOString(),
      excerpt: text.slice(0, 240) + (text.length > 240 ? '…' : ''),
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout>
  <main>
    <div id="profile-root"><p class="muted">Loading…</p></div>
    <p class="back-link"><a href="/">Return Home</a></p>
  </main>
</Layout>

<script define:vars={{ authorPosts, authorUsername: AUTHOR }}>
  globalThis.__OSPREY = { authorPosts, authorUsername };
</script>

<script>
  const root = document.getElementById('profile-root');

  function esc(s) {
    return (s ?? '').replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
    );
  }

  function avatarBlock(user) {
    const initial = (user.displayName || user.username || '?').charAt(0).toUpperCase();
    if (user.avatar) {
      return `<img class="avatar" src="${esc(user.avatar)}" alt="" />`;
    }
    return `<div class="avatar avatar-fallback">${esc(initial)}</div>`;
  }

  const SEAL =
    'M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44C11.866 1.07 11.235.876 10.59.86c-.646.017-1.273.213-1.813.568-.54.355-.969.854-1.24 1.44-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245C1.61 9.726 1.412 10.355 1.394 11c.018.646.215 1.275.57 1.816.354.54.852.972 1.438 1.246-.223.607-.27 1.264-.14 1.897.131.634.437 1.218.882 1.687.47.445 1.053.75 1.687.882.633.13 1.29.083 1.897-.14.273.587.704 1.086 1.245 1.44.541.354 1.172.548 1.817.564.646-.017 1.273-.213 1.813-.568.54-.355.969-.854 1.24-1.44.608.223 1.267.272 1.902.14.635-.13 1.22-.436 1.69-.882.445-.47.749-1.055.878-1.688.13-.633.08-1.29-.144-1.896.587-.274 1.087-.705 1.443-1.245.356-.54.554-1.169.573-1.814zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246-5.683 6.206z';

  function badge(user) {
    let html = '';
    if (user.verified) {
      html +=
        ' <span class="badge-wrap"><svg class="badge-svg verified-badge" viewBox="0 0 22 22" aria-label="Verified User">' +
        `<path fill="#ffce1c" fill-rule="evenodd" d="${SEAL}"/>` +
        '</svg><span class="tip">Verified User</span></span>';
    }
    if (user.engineer) {
      html +=
        '<span class="badge-wrap"><svg class="badge-svg engineer-badge" viewBox="0 0 22 22" aria-label="Engineer of Kastle Five">' +
        '<defs><linearGradient id="chrome" x1="0" y1="0" x2="1" y2="1">' +
        '<stop offset="0%" stop-color="#8a9098"/>' +
        '<stop offset="35%" stop-color="#f3f6f9"/>' +
        '<stop offset="50%" stop-color="#ffffff"/>' +
        '<stop offset="66%" stop-color="#b9bfc5"/>' +
        '<stop offset="100%" stop-color="#5f656b"/>' +
        '<animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1; -1 -1" dur="3.5s" repeatCount="indefinite"/>' +
        '</linearGradient></defs>' +
        `<path fill="url(#chrome)" fill-rule="evenodd" d="${SEAL}"/>` +
        '</svg><span class="tip">Engineer of Kastle Five</span></span>';
    }
    return html;
  }

  function renderView(user, isMe) {
    root.innerHTML = `
      <div class="card">
        ${avatarBlock(user)}
        <h1 class="display-name">${esc(user.displayName || user.username)}${badge(user)}</h1>
        <p class="handle">@${esc(user.username)}</p>
        ${user.bio ? `<p class="bio">${esc(user.bio)}</p>` : ''}
        ${
          isMe
            ? `<div class="actions">
                 <button id="edit-btn" class="btn">Edit profile</button>
                 <button id="logout-btn" class="btn ghost">Log out</button>
               </div>`
            : ''
        }
      </div>
      ${postsFeed(user)}`;
    if (isMe) {
      document.getElementById('edit-btn').addEventListener('click', () => renderEdit(user));
      document.getElementById('logout-btn').addEventListener('click', logout);
    }
    root.querySelectorAll('.post').forEach((el) => {
      el.addEventListener('click', () => {
        const href = el.getAttribute('data-href');
        if (href) location.href = href;
      });
    });
  }

  // ---- posts feed (the author's written work, as X-style posts) ----
  const ICONS = {
    reply:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"/></svg>',
    repost:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>',
    like:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M16.697 5.5c-1.222 0-2.337.566-3.054 1.512l-1.643 2.16-1.643-2.16C9.64 6.066 8.525 5.5 7.303 5.5c-2.243 0-3.95 1.866-3.95 4.05 0 2.99 2.66 5.45 6.97 9.32l1.677 1.5 1.677-1.5c4.31-3.87 6.97-6.33 6.97-9.32 0-2.184-1.707-4.05-3.95-4.05z"/></svg>',
    views:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M8.75 21V3h2v18h-2zM18 21V8.5h2V21h-2zM4 21l.004-10h2L6 21H4zm9.248 0v-7h2v7h-2z"/></svg>',
    share:
      '<svg viewBox="0 0 24 24" class="post-icon"><path fill="currentColor" d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>',
  };

  function fmtCount(n) {
    if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K';
    return String(n);
  }

  function postCounts(slug) {
    let h = 0;
    for (let i = 0; i < slug.length; i++) h = (h * 31 + slug.charCodeAt(i)) >>> 0;
    const likes = 80 + (h % 1400);
    return {
      replies: Math.max(1, Math.floor(likes / 14)),
      reposts: Math.max(1, Math.floor(likes / 7)),
      likes,
      views: likes * 28 + (h % 4000),
    };
  }

  function fmtPostDate(iso) {
    const d = new Date(iso);
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function postsFeed(user) {
    const data = globalThis.__OSPREY || {};
    if (!user || user.username !== data.authorUsername || !Array.isArray(data.authorPosts)) return '';
    const posts = data.authorPosts;
    if (posts.length === 0) return '';

    const name = esc(user.displayName || user.username);
    const handle = esc(user.username);
    const badges = badge(user);
    const avatar = avatarBlock(user);

    const items = posts
      .map((p) => {
        const c = postCounts(p.slug);
        return `
          <article class="post" data-href="/writtenwork/${esc(p.slug)}/">
            <div class="post-avatar">${avatar}</div>
            <div class="post-main">
              <div class="post-head">
                <span class="post-namegroup"><span class="post-name">${name}</span>${badges}</span>
                <span class="post-meta">@${handle} · ${fmtPostDate(p.date)}</span>
              </div>
              <div class="post-body">${esc(p.excerpt)}</div>
              <div class="post-actions">
                <span class="post-action">${ICONS.reply}</span>
                <span class="post-action">${ICONS.repost}<span class="cnt">${fmtCount(c.reposts)}</span></span>
                <span class="post-action">${ICONS.like}<span class="cnt">${fmtCount(c.likes)}</span></span>
                <span class="post-action">${ICONS.share}</span>
              </div>
            </div>
          </article>`;
      })
      .join('');

    return `<div class="posts"><p class="posts-label">Posts</p>${items}</div>`;
  }

  function renderEdit(user) {
    root.innerHTML = `
      <div class="card">
        <div class="avatar-edit">
          ${avatarBlock(user)}
          <label class="avatar-upload">
            Change picture
            <input type="file" id="avatar-input" accept="image/*" hidden />
          </label>
        </div>
        <label class="field">Username
          <input id="f-username" type="text" maxlength="20" value="${esc(user.username)}" />
        </label>
        <label class="field">Display name
          <input id="f-display" type="text" maxlength="40" value="${esc(user.displayName || '')}" />
        </label>
        <label class="field">Short description
          <textarea id="f-bio" rows="3" maxlength="200">${esc(user.bio || '')}</textarea>
        </label>
        <p class="form-status" id="form-status" hidden></p>
        <div class="actions">
          <button id="save-btn" class="btn">Save</button>
          <button id="cancel-btn" class="btn ghost">Cancel</button>
        </div>
      </div>`;

    document.getElementById('cancel-btn').addEventListener('click', () => renderView(user, true));
    document.getElementById('save-btn').addEventListener('click', () => save(user));

    const fileInput = document.getElementById('avatar-input');
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files[0];
      if (!file) return;
      setStatus('Uploading…', false);
      try {
        const res = await fetch('/api/avatar', {
          method: 'POST',
          headers: { 'Content-Type': file.type },
          body: file,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed.');
        user.avatar = data.avatar + '?t=' + Date.now();
        const img = root.querySelector('.avatar');
        if (img && img.tagName === 'IMG') img.src = user.avatar;
        else renderEdit(user);
        setStatus('Picture updated.', false);
      } catch (e) {
        setStatus(e.message, true);
      }
    });
  }

  function setStatus(msg, isError) {
    const el = document.getElementById('form-status');
    if (!el) return;
    el.textContent = msg;
    el.classList.toggle('error', !!isError);
    el.hidden = !msg;
  }

  async function save(user) {
    const username = document.getElementById('f-username').value.trim().toLowerCase();
    const displayName = document.getElementById('f-display').value.trim();
    const bio = document.getElementById('f-bio').value.trim();
    setStatus('Saving…', false);
    try {
      const res = await fetch('/api/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, displayName, bio }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not save.');
      renderView({ ...data, avatar: user.avatar }, true);
    } catch (e) {
      setStatus(e.message, true);
    }
  }

  async function logout() {
    await fetch('/api/auth/logout', { method: 'POST' });
    location.href = '/';
  }

  function renderSignin() {
    root.innerHTML = `
      <div class="card center">
        <h1 class="display-name">Profile</h1>
        <p class="muted">Sign in to claim a username, add a picture, and a short description.</p>
        <div class="signin-options">
          <a class="btn" href="/api/auth/github">Sign in with GitHub</a>
          <a class="btn ghost" href="/api/auth/google">Sign in with Google</a>
        </div>
      </div>`;
  }

  async function init() {
    const pathMatch = location.pathname.match(/^\/u\/([^/?#]+)/);
    const viewing = pathMatch
      ? decodeURIComponent(pathMatch[1])
      : new URLSearchParams(location.search).get('u');

    let me = null;
    try {
      me = await (await fetch('/api/me')).json();
    } catch {
      /* ignore */
    }

    if (viewing) {
      if (me && me.username === viewing.toLowerCase()) return renderView(me, true);
      try {
        const res = await fetch('/api/user?u=' + encodeURIComponent(viewing));
        if (!res.ok) {
          root.innerHTML = '<div class="card center"><p class="muted">No such profile.</p></div>';
          return;
        }
        renderView(await res.json(), false);
      } catch {
        root.innerHTML = '<div class="card center"><p class="muted">Could not load profile.</p></div>';
      }
      return;
    }

    if (me) renderView(me, true);
    else renderSignin();
  }

  init();
</script>

<style is:global>
  main {
    padding: 2rem;
    max-width: 760px;
    margin: 0 auto;
    min-height: 100vh;
  }

  .muted {
    color: #888;
  }

  .card {
    max-width: 32rem;
  }

  .card.center {
    text-align: center;
    margin: 4rem auto 0;
  }

  .avatar {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #333;
  }

  .card.center .avatar,
  .card.center .avatar-fallback {
    margin: 0 auto;
  }

  .avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: #ffce1c;
    background: #111;
  }

  .display-name {
    margin: 1rem 0 0.1rem;
    font-size: 1.6rem;
  }

  .handle {
    margin: 0;
    color: #888;
  }

  .badge-wrap {
    position: relative;
    display: inline-block;
  }

  .badge-svg {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.18em;
    margin-left: 0.1em;
  }

  .engineer-badge {
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.35));
  }

  .badge-wrap .tip {
    position: absolute;
    bottom: 135%;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: #111;
    color: #f5f7fa;
    border: 1px solid #333;
    border-radius: 3px;
    padding: 0.25rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .badge-wrap:hover .tip {
    opacity: 1;
  }

  .bio {
    margin: 1rem 0 0;
    color: #bbb;
    white-space: pre-wrap;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .card.center .actions {
    justify-content: center;
  }

  .signin-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    font-family: inherit;
    font-size: 0.85rem;
    color: #111;
    background: #ffce1c;
    border: 1px solid #ffce1c;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn:hover {
    background: transparent;
    color: #ffce1c;
  }

  .btn.ghost {
    color: #888;
    background: transparent;
    border-color: #333;
  }

  .btn.ghost:hover {
    color: #ffce1c;
    border-color: #ffce1c;
  }

  .avatar-edit {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .avatar-upload {
    font-size: 0.85rem;
    color: #ffce1c;
    cursor: pointer;
    border-bottom: 1px solid transparent;
  }

  .avatar-upload:hover {
    border-bottom-color: #ffce1c;
  }

  .field {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: #888;
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    font-family: inherit;
    font-size: 1rem;
    color: #f5f7fa;
    background: transparent;
    border: 1px solid #333;
    padding: 0.5rem;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: #ffce1c;
  }

  .form-status {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: #888;
  }

  .form-status.error {
    color: #ff6b6b;
  }

  .posts {
    margin-top: 2.5rem;
    max-width: 40rem;
  }

  .posts-label {
    margin: 0 0 0.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #222;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #666;
  }

  .post {
    display: flex;
    gap: 0.75rem;
    padding: 0.95rem 0.5rem;
    border-bottom: 1px solid #222;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .post:hover {
    background: #0b0b0b;
  }

  .post-avatar .avatar,
  .post-avatar .avatar-fallback {
    width: 42px;
    height: 42px;
    font-size: 1.2rem;
  }

  .post-main {
    flex: 1;
    min-width: 0;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .post-name {
    font-weight: 700;
    color: #f5f7fa;
  }

  .post-head .badge-svg {
    width: 1em;
    height: 1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
  }

  .post-meta {
    color: #888;
    font-size: 0.9rem;
  }

  .post-body {
    margin-top: 0.15rem;
    color: #f5f7fa;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .post-actions {
    display: flex;
    justify-content: space-between;
    max-width: 20rem;
    margin-top: 0.6rem;
    color: #888;
  }

  .post-action {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
  }

  .post-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .back-link {
    margin-top: 3rem;
  }

  .back-link a,
  .back-link a:visited {
    color: #888;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .back-link a:hover {
    color: #ffce1c;
  }
</style>
