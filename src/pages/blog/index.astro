---
import Layout from '../../layouts/Layout.astro';

const rawAstroFiles = import.meta.glob('./*.astro', { query: '?raw', import: 'default', eager: true });
const rawMdFiles = import.meta.glob('../../content/blog/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const blogContents = {};

for (const [filePath, raw] of Object.entries(rawAstroFiles)) {
  if (filePath.endsWith('index.astro')) continue;
  const slug = filePath.split('/').pop().replace(/\.astro$/, '');

  const importMatch = raw.match(/import\s+\w+\s+from\s+['"](.+?\.md)['"]/);
  let mdBody = '';
  if (importMatch) {
    const mdPath = importMatch[1];
    mdBody = rawMdFiles[mdPath] ?? rawMdFiles[`../../content/blog/${slug}.md`] ?? '';
  }
  if (!mdBody) {
    const candidate = Object.keys(rawMdFiles).find((key) => key.endsWith(`${slug}.md`));
    mdBody = candidate ? rawMdFiles[candidate] : '';
  }

  const body = mdBody
    .replace(/^---[\s\S]*?---/, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<[^>]+>/g, '')
    .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
    .replace(/[*_`~]/g, '')
    .trim();

  blogContents[slug] = body;
}
const blogContentsJson = JSON.stringify(blogContents);
---

<Layout>
	<main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
		<h1>Osprey Thread Kastle Five</h1>

		<input
			id="search"
			type="search"
			placeholder="Search..."
			class="search-box"
		/>

		<ul style="list-style: none; padding: 0; margin: 2rem 0;">
			<li class="archive-post" data-slug="doghood" style="margin-bottom: 1.5rem;">
				<a href="/blog/doghood/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">Doghood</a>
				<p style="margin: 0.5rem 0 0; color: #555;">December 19, 2025</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="shepherds-work" style="margin-bottom: 1.5rem;">
				<a href="/blog/shepherds-work/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">Shepherd’s Work</a>
				<p style="margin: 0.5rem 0 0; color: #555;">January 1</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="pale-blue-november" style="margin-bottom: 1.5rem;">
				<a href="/blog/pale-blue-november/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">Pale Blue November</a>
				<p style="margin: 0.5rem 0 0; color: #555;">January 30, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="a-little-boys-prayer" style="margin-bottom: 1.5rem;">
				<a href="/blog/a-little-boys-prayer/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">A Little Boy's Prayer</a>
				<p style="margin: 0.5rem 0 0; color: #555;">February 5, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="be-well-tomahawk" style="margin-bottom: 1.5rem;">
				<a href="/blog/be-well-tomahawk/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">Be Well, Tomahawk</a>
				<p style="margin: 0.5rem 0 0; color: #555;">March 17, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="war-angel" style="margin-bottom: 1.5rem;">
				<a href="/blog/war-angel/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">War Angel</a>
				<p style="margin: 0.5rem 0 0; color: #555;">April 30, 2026</p>
				<p class="search-snippet"></p>
			</li>

			<li class="archive-post" data-slug="architecture-of-a-mechanical-body" style="margin-bottom: 1.5rem;">
				<a href="/blog/architecture-of-a-mechanical-body/" style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">Architecture of a Mechanical Body</a>
				<p style="margin: 0.5rem 0 0; color: #555;">May 25, 2026</p>
				<p class="search-snippet"></p>
			</li>
		</ul>
	</main>

<style>
.search-box {
  border: none;
  background: none;
  padding: 0;
  margin: 2rem 0;
  font-family: inherit;
  font-size: inherit;
  color: #888;
  width: 100%;
}

.search-box::placeholder {
  color: #888;
}

.search-box:focus {
  outline: none;
}

.search-snippet {
  color: #999;
  font-size: 0.9rem;
  margin-top: 0.35rem;
  max-width: 40rem;
}
</style>

<script type="application/json" id="blog-contents">
  {blogContentsJson}
</script>

<script>
  const searchInput = document.getElementById("search");
  const archivePosts = document.querySelectorAll(".archive-post");

  searchInput?.addEventListener("input", function () {
    const query = this.value.toLowerCase().trim();

    archivePosts.forEach((post) => {
      const text = post.innerText.toLowerCase();

      if (!query || text.includes(query)) {
        post.style.display = "";
      } else {
        post.style.display = "none";
      }
    });
  });
</script>
</Layout>
