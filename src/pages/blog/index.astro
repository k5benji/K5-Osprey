---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const searchData = await Promise.all(
  posts.map(async (post) => {
    const body = post.body ?? '';

    return {
      title: post.data.title,
      description: post.data.description,
      url: `/blog/${post.id}/`,
      body,
    };
  })
);
---

<Layout>
	<main style="padding: 2rem; max-width: 760px; margin: 0 auto;">
		<h1>Osprey Thread Kastle Five</h1>

		<input
			id="search"
			type="search"
			placeholder="Search..."
			class="search-box"
		/>

		<ul style="list-style: none; padding: 0; margin: 2rem 0;">
			{posts.map((post) => (
				<li
					class="archive-post"
					data-content={post.body}
					style="margin-bottom: 1.5rem;"
				>
					<a href={`/blog/${post.id}/`} style="font-size: 1.25rem; font-weight: 700; color: #111; text-decoration: none;">
						{post.data.title}
					</a>
					<p style="margin: 0.5rem 0 0; color: #555;">
						{post.data.pubDate}
					</p>
					<p class="search-snippet"></p>
				</li>
			))}
		</ul>
	</main>

<style>
.search-box {
  border: none;
  background: none;
  padding: 0;
  margin: 2rem 0;
  font-family: inherit;
  font-size: inherit;
  color: #888;
  width: 100%;
}

.search-box::placeholder {
  color: #888;
}

.search-box:focus {
  outline: none;
}
</style>

<script>
  const searchInput = document.querySelector("#search");
  const archivePosts = document.querySelectorAll(".archive-post");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.toLowerCase().trim();

    archivePosts.forEach((post) => {
      const content = post.dataset.content || "";
      post.hidden = query && !content.toLowerCase().includes(query);
    });
  });
</script>
</Layout>
